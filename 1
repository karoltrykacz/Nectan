export component NectanWindow inherits Window {

    title: "Nectan";
    preferred-width: 1128px;
    preferred-height: 720px;
    min-width: 400px;
    min-height: 200px;
    default-font-family: Theme.font-body;
    resize-border-width: 8px;

    no-frame: true;
    background: transparent;

    in-out property <bool> error_open: false;

    in-out property <string> error_title: "";
    in-out property <string> error_message: "";

    callback show-error(string, string);
    callback close-error();
    callback pasted();

    show-error(title, message) => {
        debug("Showing error ", title);
        root.error_open = true;
        root.error_message = message;
        root.error_title = title;
    }

    forward-focus: focus-scope;

    focus-scope := FocusScope {
        focus-on-click: true;
        width: 100%;
        height: 100%;

        init => {
            self.focus();
        }

        key-pressed(event) => {

            if (event.text == Key.F11) {
                root.maximized = !root.maximized;
            }
            if (event.modifiers.control || event.modifiers.meta) {

                if (event.text == Key.S) {
                    debug("Toggled sidebar");
                    WindowBridge.sidebar-visible = !WindowBridge.sidebar-visible;
                    WindowBridge.sidebar-hover = false;
                }
                if (event.text == Key.V) {
                    debug("Pasted");
                    pasted();
                }
                return accept;
            }
            return reject;
        }

        // MainWindowTouchArea { }

        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.colors.primary-col;
            // background: @linear-gradient(-30deg, #3f87a6 0%, #833AB4 50%, #f69d3c 100%);

            border-width: root.maximized ? 0 : 1px;
            border-radius: root.maximized ? 0 : 12px;

            border-color: Theme.colors.fourth-col;
            padding: 20px;
            clip: true;

            TopBarShower { }

            SidebarShower { }

            Sidebar { }

            Topbar { }

            HorizontalLayout {
                spacing: 8px;
                padding: 8px;
                padding-top: WindowBridge.topbar-hover ? 24px : 8px;
                padding-left: !WindowBridge.sidebar-visible ? 8px : WindowBridge.sidebar-width;

                animate x, padding-left {
                    duration: 128ms;
                    easing: ease;
                }

                animate padding-top {
                    delay: 50ms;
                    duration: 128ms;
                    easing: ease;
                }

                Rectangle {
                    // opacity: 0.5;
                    background: Theme.colors.third-col;
                    border-radius: 8px;

                    if WindowBridge.current-window == Window.device: DeviceScreen { }

                    if WindowBridge.current-window == Window.transfers: Transfers { }
                }
            }
        }

        // VerticalBox {
        //     padding-bottom: NotificationsBridge.notifications-visible ? parent.height : 0;
        //     animate padding-bottom {
        //         duration: 80ms;
        //         easing: ease;
        //     }
        //     opacity: 0.8;
        //     Rectangle {
        //         background: red;
        //     }
        // }

        if SettingsBridge.settings_open: SettingsModal { }

        if WindowBridge.nectan-modal-visible: NectanModal { }

        if AddDeviceBridge.add_device_open:  AddRemoteDeviceModal { }

        if SearchBridge.visible: Search { }

        if OutcomingTransferModalBridge.sending-open: OutcomingTransferModal {
            on-closed => {
                focus-scope.focus();
            }
        }

        if error_open: ErrorModal {
            title <=> error_title;
            message <=> error_message;
            open <=> error_open;
            closed => { error_open = false; }
        }
    }
}

