component ToolTip inherits Rectangle {
    in property <string> text;
    z: 4;
    height: 24px;
    width: self.min-width + 20px;
    border-radius: 4px;
    background: Theme.colors.primary-col;
    border-color: Theme.colors.fourth-col;
    border-width: 1px;
    opacity: 0;
    Text {
        text: text;
        font-size: 12px;
        font-family: Theme.font-heading;
        color: Theme.colors.primary-font;
    }
}


component ActionButton inherits Rectangle {
    height: 42px;
    in property <length> icon-size: 16px;
    in property <image> icon;
    in property <string> text;
    in property <color> icon-color: Theme.colors.fourth-col;
    in property <color> text-color: Theme.colors.third-font;

    callback clicked();

    transform-scale: touch.pressed ? 0.97 : 1.0;
    animate transform-scale { duration: 100ms; }

    border-radius: 12px;
    background: Theme.colors.third-col;

    states [
        hovered when touch.has-hover: {
            background: Theme.colors.fourth-col;
            tip.opacity: 1;
            in {
                animate tip.opacity {
                    delay: 500ms;
                    duration: 80ms;
                }
            }
            out {
                animate tip.opacity { duration: 80ms; }
            }
        }
    ]

    if icon != @image-url(""): SvgIcon {
        source: icon;
        fg: Theme.colors.third-font;
        size: icon-size;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    tip := ToolTip {
        x: root.width - 8px;
        text: text;
    }
}



