component SidebarDevice inherits Rectangle {

    in property <DeviceItem> device;
    in property <bool> selected: false;

    height: 36px;
    border-radius: 12px;

    background: drag.dragging ? Theme.colors.fourth-font : selected ? Theme.colors.fourth-col : area.has-hover ? Theme.colors.third-col : transparent;

    transform-scale: area.pressed ? 0.99 : 1.0;
    animate transform-scale { duration: 100ms; }

    callback clicked;
    drag := DragArea {
        data: Api.make-data();
        allow-move: true;
        allow-copy: true;
        drag-image: @image-url("icons/link.svg");

        HorizontalLayout {
            padding-left: 12px;
            alignment: start;
            cross-axis-alignment: center;

            Rectangle {
                height: 6px;
                width: 6px;
                border-radius: 4px;
                background: device.status == DeviceStatus.online ? #ff9800 :
                    (device.status == DeviceStatus.nearby ? #0288d1 : Theme.colors.third-font);
            }

            Rectangle {
                width: 4px;
            }

            Text {
                vertical-alignment: center;
                text: device.name;
                color: Theme.colors.primary-font;
                font-size: 13px;
                font-weight: 600;
                font-family: Theme.font-heading;
            }
        }

        area := TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.clicked(); }
        }
    }
}

export global Api {
    pure callback make-data() -> data-transfer;
    pure callback can-drop() -> DragAction;
    callback dropped();
}

component TopBarShower inherits Rectangle {
    x: WindowBridge.sidebar-hover ? WindowBridge.sidebar-width : 0;
    z: 0;
    y: 0;
    width: 100%;
    height: WindowBridge.topbar-hover ? 60px : 30px;
    TouchArea {
        property <bool> maybe-dragging: false;
        moved => {
            if (self.maybe-dragging) {
                WindowBridge.drag-window();
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                self.maybe-dragging = true;
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                self.maybe-dragging = false;
            }
            if self.mouse-y > 32px {
                WindowBridge.topbar-hover = false;
            }
            if self.mouse-y < 30px {
                WindowBridge.topbar-hover = true;
            }
        }
    }
}

component MainWindowTouchArea inherits TouchArea {
    width: 100%;
    height: 100%;
    pointer-event(event) => {
        debug(self.mouse-y);
        if self.mouse-y < 300px {
            WindowBridge.topbar-hover = true;
        } else {
            WindowBridge.topbar-hover = false;
        }
    }
    scroll-event(event) => {
        debug(self.mouse-y);
        if event.delta-x > 10px {
            WindowBridge.sidebar-visible = true;
        }
        if event.delta-x < -10px {
            WindowBridge.sidebar-visible = false;
        }
        return accept;
    }
}

component SidebarShower inherits Rectangle {
    x: 0;
    z: 1;
    width: WindowBridge.sidebar-visible ? 0 : WindowBridge.sidebar-hover ? WindowBridge.sidebar-width + 60px : 20px;
    sidebar-toggle := TouchArea {
        pointer-event(event) => {
            if self.mouse-x > WindowBridge.sidebar-width {
                WindowBridge.sidebar-hover = false;
            }
            if self.mouse-x < 20px {
                WindowBridge.sidebar-hover = true;
            }
        }
    }
}

