import {
    IconButton,
    SvgIcon,
    MenuRow,
    SearchBar,
    MenuSeparator,
} from "../../shared/elements.slint";
import { ColorPicker } from "../../shared/color_picker.slint";
import { DeviceItem } from "devices.slint";
import { WindowBridge } from "../../shared/window.slint";
import { Theme } from "../../shared/theme.slint";
import { DevicesBridge } from "devices.slint";
import { AddDeviceBridge } from "../../shared/add_remote_modal.slint";
import { ExplorerBridge } from "explorer/bridge.slint";
import { SettingsBridge } from "settings.slint";
import { HoverBridge } from "../../shared/hover.slint";
import { Keys } from "../../shared/keys_shared.slint";
import { Icons } from "../../shared/icons.slint";
import {
    EssentialTileData,
    Essentials,
    EssentialsBridge,
} from "essentials.slint";
import { DrivesBridge } from "drives.slint";
import { CommandBridge } from "command.slint";
import { ServerBridge } from "server.slint";

export component MenuPopup inherits Rectangle {
    in property <length> menu-width: 224px;
    in property <length> gap: 8px;
    in property <length> x-offset: -4px;

    public function show() {
        popup.show();
    }

    public function close() {
        popup.close();
    }

    popup := PopupWindow {
        x: root.x-offset;
        y: -self.height - root.gap;
        width: root.menu-width;
        height: lay.preferred-height;
        close-policy: close-on-click-outside;

        panel := Rectangle {
            y: shown ? 0px : 8px;
            opacity: shown ? 1.0 : 0.0;
            transform-scale-x: shown ? 1.0 : 0.96;
            transform-scale-y: shown ? 1.0 : 0.96;
            transform-origin: { x: 0px, y: self.height };
            background: Theme.colors.primary-col.with-alpha(0.5);
            backdrop-blur: 10px;
            border-radius: 20px;
            corner-shape: CornerShape.squircle;
            border-width: 1px;
            border-color: Theme.colors.border-col;
            clip: true;

            property <bool> shown: false;

            animate y, opacity, transform-scale-x, transform-scale-y {
                duration: Theme.animation-speed;
                easing: Theme.easing;
            }

            Timer {
                interval: 16ms;
                running: true;
                triggered => {
                    panel.shown = true;
                    self.running = false;
                }
            }

            lay := VerticalLayout {
                padding: 6px;
                @children
            }
        }
    }
}


export component Sidebar inherits Rectangle {

    background: Theme.colors.primary-col.with-alpha(Theme.config.transparency);
    backdrop-blur: Theme.blur;
    x: WindowBridge.sidebar-visible ? 0 : ((WindowBridge.sidebar-hover || EssentialsBridge.essentials-select) ? 0 : -WindowBridge.sidebar-width);
    width: WindowBridge.sidebar-width;
    z: 2;
    border-radius: 8px;
    border-width: 1px;
    border-color: WindowBridge.sidebar-visible ? transparent : Theme.colors.border-col;

    callback leave();

    property <int> cursor <=> EssentialsBridge.essentials-cursor;
    property <bool> essentials-sel <=> EssentialsBridge.essentials-select;

    pure function count() -> int {
        EssentialsBridge.essentials-data.length
    }

    function move-to(target: int) {
        if target >= 0 && target < count() {
            cursor = target;
        }
    }

    leave => {
        cursor = -1;
        ExplorerBridge.focus();
        EssentialsBridge.essentials-select = false;
    }

    changed essentials-sel => {
        if root.essentials-sel {
            fs.focus();
        }
    }

    animate x, border-color {
        duration: Theme.animation-speed;
        easing: Theme.easing;
    }

    forward-focus: fs;

    // TouchArea { }

    fs := FocusScope {

        focus-lost(reason) => {
            EssentialsBridge.essentials-select = false;
            root.cursor = -1;
        }

        key-pressed(event) => {
            if event.text == "l" || event.text == Key.RightArrow {
                root.move-to(root.cursor + 1);
                return EventResult.accept;
            }
            if event.text == "h" || event.text == Key.LeftArrow {
                root.move-to(root.cursor - 1);
                return EventResult.accept;
            }
            if event.text == "j" || event.text == Key.DownArrow {
                root.move-to(root.cursor + essentials.cols);
                return EventResult.accept;
            }
            if event.text == "k" || event.text == Key.UpArrow {
                root.move-to(root.cursor - essentials.cols);
                return EventResult.accept;
            }
            if event.text == Key.Return || event.text == " " {
                EssentialsBridge.clicked(EssentialsBridge.id-at-slot(root.cursor));
                root.leave();
                return EventResult.accept;
            }
            if event.text == Key.Escape || event.text == "s" {
                root.leave();
                return EventResult.accept;
            }
            root.leave();
            EventResult.reject
        }

        WindowMoveArea { }

        VerticalLayout {
            padding: 8px;
            padding-bottom: 4px;

            HorizontalLayout {
                IconButton {
                    icon: Icons.nectan;
                    icon-size: 16px;
                    colorize: transparent;

                    clicked => {
                        WindowBridge.nectan-modal-open = true;
                    }
                }

                Rectangle { }

                IconButton {
                    icon: Icons.search;
                    fg: self.hovered ? Theme.colors.primary-font : Theme.colors.third-font;
                    icon-size: 16px;

                    clicked => {
                        CommandBridge.open = true;
                    }
                }

                Rectangle {
                    width: 4px;
                }

                IconButton {
                    icon: Icons.sidebar;
                    fg: self.hovered ? Theme.colors.primary-font : Theme.colors.third-font;
                    icon-size: 16px;

                    clicked => {
                        WindowBridge.sidebar-visible = !WindowBridge.sidebar-visible;
                    }
                }
            }

            Rectangle {
                height: 8px;
            }

            essentials := Essentials {
                gap: 8px;
                min-cell-w: 42px;
                cell-h: 36px;
                tiles: EssentialsBridge.essentials-data;
                highlighted-slot: root.cursor;

                property <int> rows: max(1, ceil(EssentialsBridge.essentials-data.length / self.cols));
                height: rows * self.cell-h + (rows - 1) * self.gap;
            }

            Rectangle {
                height: 12px;
            }

            Rectangle {
                height: 32px;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    cross-axis-alignment: center;
                    spacing: 8px;

                    Image {
                        source: Icons.nearby;
                        colorize: Theme.colors.third-font;
                        width: 18px;
                        height: 18px;
                    }

                    Text {
                        text: @tr("Nearby");
                        font-size: 0.9rem;
                        font-weight: 500;
                        color: Theme.colors.third-font;
                    }

                    Rectangle { }

                    Image {
                        source: Icons.chevron-left;
                        transform-rotation: -90deg;
                        colorize: Theme.colors.third-font;
                        width: 13px;
                        height: 13px;
                    }
                }
            }

            Rectangle {
                height: 32px;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    cross-axis-alignment: center;
                    spacing: 8px;

                    Rectangle {
                        width: 18px;

                        Image {
                            source: Icons.server;
                            colorize: Theme.colors.third-font;
                            width: 16px;
                            height: 16px;
                        }
                    }

                    Text {
                        text: @tr("Network");
                        font-size: 0.9rem;
                        font-weight: 500;
                        color: Theme.colors.third-font;
                    }

                    Rectangle { }

                    Image {
                        source: Icons.chevron-left;
                        transform-rotation: -90deg;
                        colorize: Theme.colors.third-font;
                        width: 13px;
                        height: 13px;
                    }
                }
            }

            Rectangle { }

            HorizontalLayout {
                spacing: 4px;
                IconButton {
                    icon: Icons.settings;
                    icon-size: 16px;

                    clicked => {
                        SettingsBridge.open = true;
                    }
                }

                Rectangle { }

                menu-btn := IconButton {
                    icon: Icons.menu;
                    icon-size: 16px;

                    clicked => {
                        menu-popup.show();
                    }

                    menu-popup := MenuPopup {
                        width: parent.width;
                        height: parent.height;
                        menu-width: 208px;

                        MenuRow {
                            text: @tr("Nectan Cloud");
                            icon: Icons.cloud;
                            clicked => {
                                CommandBridge.open = true;
                                menu-popup.close();
                            }
                        }

                        MenuRow {
                            text: @tr("Nectan Server");
                            icon: Icons.server;
                            clicked => {
                                SettingsBridge.open = true;
                                menu-popup.close();
                            }
                        }

                        MenuRow {
                            text: @tr("Gallery");
                            icon: Icons.pictures;
                            clicked => {
                                CommandBridge.open = true;
                                menu-popup.close();
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 4px;
            }
        }
    }
}
