import { Theme, ThemeAnimator } from "../../shared/theme.slint";
import { Properties, PropertiesBridge } from "../../shared/properties.slint";
import {
    NectanAppFrame,
    Spinner,
    Slider,
    IconButton,
    PrimaryButton,
    Switch,
    GlassPanel,
    GeneralModal,
    MenuRow,
} from "../../shared/elements.slint";
import { WindowBridge } from "../../shared/window.slint";
import { Icons } from "../../shared/icons.slint";
import { MenuPopup } from "sidebar.slint";

export enum ViewMode {
    contain,
    fill,
}

export struct ProbedColor { color: color, hex: string }

component EditSlider inherits VerticalLayout {
    in property <string> label;
    in property <float> minimum: -100;
    in property <float> maximum: 100;

    in-out property <float> value;

    callback changed(float);

    alignment: start;
    spacing: 2px;

    Text {
        text: label;
        font-size: 0.8rem;
        color: #e8e8e8;
    }

    Slider {
        value <=> root.value;
        minimum: root.minimum;
        maximum: root.maximum;
        changed(v) => { root.changed(v); }
    }
}

component CropHandle inherits Rectangle {
    in property <MouseCursor> cursor: MouseCursor.crosshair;
    callback dragged(length, length);

    width: 28px;
    height: 28px;

    Rectangle {
        width: 12px;
        height: 12px;
        border-radius: 3px;
        background: Colors.white;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    TouchArea {
        mouse-cursor: root.cursor;

        moved => {
            if (self.pressed) {
                root.dragged(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
            }
        }
    }
}

component ShortcutsModal inherits GeneralModal {

    init => { self.focus(); }

    Rectangle {
        width: min(720px, parent.width - 40px);
        height: min(480px,parent.height - 40px);
        clip: true;
        corner-shape: CornerShape.squircle;
        drop-shadow-color: #00000099;
        drop-shadow-blur: 28px;
        background: Theme.colors.primary-col;
        border-radius: 24px;
        border-width: 1px;
        border-color: Theme.colors.border-col;

        TouchArea {
            clicked => {}
        }

        VerticalLayout {
            padding: 20px;
            Text {
                font-size: 1.5rem;
                font-weight: 600;
                text: @tr("Shortcuts");
                color: Theme.colors.primary-font;
            }
        }
    }
}

export component ImageViewer inherits Window {
    title: "Nectan Image Viewer";
    preferred-width: 1080px;
    preferred-height: 720px;
    min-width: 400px;
    min-height: 300px;
    resize-border-width: 6px;
    no-frame: !Theme.config.native-topbar;
    background: transparent;
    maximized: WindowBridge.maximized;

    default-font-family: Theme.config.font;
    default-font-size: Theme.font-size;

    in-out property <image> image;
    in-out property <bool> loading;
    in-out property <bool> shortcuts;
    in-out property <ViewMode> view-mode: ViewMode.contain;
    in-out property <float> zoom: 1.0;
    in property <bool> has-prev: true;
    in property <bool> has-next: true;

    in property <int> full-width: 0;
    in property <int> full-height: 0;
    in property <image> detail;
    in property <float> detail-x: 0;
    in property <float> detail-y: 0;
    in property <float> detail-w: 1;
    in property <float> detail-h: 1;
    in-out property <bool> detail-valid: false;

    in-out property <int> turns: 0;

    in-out property <bool> cropping: false;
    in-out property <float> crop-x: 0;
    in-out property <float> crop-y: 0;
    in-out property <float> crop-w: 1;
    in-out property <float> crop-h: 1;

    in-out property <bool> picking-color: false;
    property <bool> probe-over: false;
    property <length> probe-x: 0px;
    property <length> probe-y: 0px;
    property <ProbedColor> probed: { color: transparent, hex: "" };

    in-out property <bool> editing: false;
    changed editing => {
        if (root.editing) {
            root.turns = 0;
        }
        root.detail-valid = false;
        detail-timer.restart();
    }

    in-out property <float> brightness: 0;
    in-out property <float> contrast: 0;
    in-out property <float> blur: 0;
    in-out property <float> sharpen: 0;
    in-out property <float> hue: 0;
    in-out property <bool> grayscale: false;
    in-out property <bool> invert: false;

    in-out property <bool> idle: false;
    property <bool> z-held: false;
    property <float> drag-start-zoom: 1.0;
    property <bool> ui-visible: !root.idle || root.editing || root.cropping;

    callback previous-requested();
    callback next-requested();
    callback info-requested();
    callback print-requested();
    callback crop-apply();
    callback edits-changed();
    callback flip-horizontal();
    callback flip-vertical();
    callback save-requested();
    callback edit-cancelled();
    callback detail-requested(float, float, float, float, int, float);
    pure callback probe-color(float, float, int) -> ProbedColor;
    callback copy-probed-color(string);

    property <angle> rot: root.turns * 90deg;
    animate rot {
        duration: Theme.animation-speed;
        easing: Theme.easing;
    }

    property <float> max-zoom: 48.0;
    property <length> pan-x: 0px;
    property <length> pan-y: 0px;
    property <length> start-pan-x: 0px;
    property <length> start-pan-y: 0px;

    property <length> vw: viewport.width;
    property <length> vh: viewport.height;
    property <length> iw: (root.full-width > 0 ? root.full-width : root.image.width) * 1px;
    property <length> ih: (root.full-height > 0 ? root.full-height : root.image.height) * 1px;
    property <float> cs: Math.abs(Math.cos(root.rot));
    property <float> sn: Math.abs(Math.sin(root.rot));
    property <length> bw: root.iw * root.cs + root.ih * root.sn;
    property <length> bh: root.iw * root.sn + root.ih * root.cs;
    property <float> fit-w: root.bw > 0px ? viewport.width / root.bw : 1;
    property <float> fit-h: root.bh > 0px ? viewport.height / root.bh : 1;
    property <float> base-scale: root.view-mode == ViewMode.contain
        ? Math.min(root.fit-w, root.fit-h)
        : Math.max(root.fit-w, root.fit-h);
    property <length> disp-w: root.iw * root.base-scale * root.zoom;
    property <length> disp-h: root.ih * root.base-scale * root.zoom;
    property <length> box-w: root.bw * root.base-scale * root.zoom;
    property <length> box-h: root.bh * root.base-scale * root.zoom;

    property <length> max-pan-x: Math.max(0px, (root.box-w - viewport.width) / 2);
    property <length> max-pan-y: Math.max(0px, (root.box-h - viewport.height) / 2);
    property <length> eff-pan-x: Math.clamp(root.pan-x, -root.max-pan-x, root.max-pan-x);
    property <length> eff-pan-y: Math.clamp(root.pan-y, -root.max-pan-y, root.max-pan-y);

    in property <bool> can-edit: true;
    in property <string> file-name;
    in property <string> file-size;

    changed zoom => { detail-timer.restart(); }
    changed eff-pan-x => { detail-timer.restart(); }
    changed eff-pan-y => { detail-timer.restart(); }
    changed vw => { detail-timer.restart(); }
    changed vh => { detail-timer.restart(); }
    changed turns => {
        root.detail-valid = false;
        detail-timer.restart();
    }

    public function reset-view() {
        root.zoom = 1.0;
        root.pan-x = 0px;
        root.pan-y = 0px;
    }

    public function poke() {
        root.idle = false;
        idle-timer.restart();
    }

    function request-detail() {
        if (root.full-width <= 0 || root.editing || root.cropping || root.loading) {
            return;
        }
        if (root.box-w <= 0px || root.box-h <= 0px) {
            return;
        }
        let left = (viewport.width - root.box-w) / 2 + root.eff-pan-x;
        let top = (viewport.height - root.box-h) / 2 + root.eff-pan-y;
        let x0 = Math.max(0px, -left);
        let y0 = Math.max(0px, -top);
        let x1 = Math.min(root.box-w, viewport.width - left);
        let y1 = Math.min(root.box-h, viewport.height - top);
        root.detail-requested(
            x0 / root.box-w,
            y0 / root.box-h,
            (x1 - x0) / root.box-w,
            (y1 - y0) / root.box-h,
            root.turns,
            root.base-scale * root.zoom);
    }

    function zoom-from(z0: float, pan0-x: length, pan0-y: length, factor: float, px: length, py: length) {
        if (root.cropping) {
            return;
        }
        let nz = Math.clamp(z0 * factor, 0.01, root.max-zoom);
        let r = nz / z0;
        root.pan-x = px - (px - pan0-x) * r;
        root.pan-y = py - (py - pan0-y) * r;
        root.zoom = nz;
    }

    function zoom-at(factor: float, px: length, py: length) {
        root.zoom-from(root.zoom, root.eff-pan-x, root.eff-pan-y, factor, px, py);
    }

    function close-tools() {
        root.cropping = false;
        root.editing = false;
        root.picking-color = false;
    }

    function update-probe(mx: length, my: length) {
        if (root.box-w <= 0px || root.box-h <= 0px) {
            return;
        }
        root.probe-x = mx;
        root.probe-y = my;
        let nx = (mx - (viewport.width / 2 + root.eff-pan-x)) / root.box-w + 0.5;
        let ny = (my - (viewport.height / 2 + root.eff-pan-y)) / root.box-h + 0.5;
        root.probe-over = nx >= 0 && nx <= 1 && ny >= 0 && ny <= 1;
        if (root.probe-over) {
            root.probed = root.probe-color(nx, ny, root.turns);
        }
    }

    function commit-probe() {
        if (root.probe-over && root.probed.hex != "") {
            root.copy-probed-color(root.probed.hex);
        }
        root.picking-color = false;
    }

    function go-next() {
        if (root.has-next && !root.cropping) {
            root.close-tools();
            root.next-requested();
        }
    }

    function go-previous() {
        if (root.has-prev && !root.cropping) {
            root.close-tools();
            root.previous-requested();
        }
    }

    function toggle-crop() {
        if (!root.can-edit) {
            return;
        }
        if (root.cropping) {
            root.cropping = false;
        } else {
            root.editing = false;
            root.view-mode = ViewMode.contain;
            root.reset-view();
            root.zoom = 0.75;
            root.crop-x = 0;
            root.crop-y = 0;
            root.crop-w = 1;
            root.crop-h = 1;
            root.cropping = true;
        }
    }

    changed cropping => {
        if (!root.cropping) {
            root.reset-view();
        }
        detail-timer.restart();
    }

    function set-aspect(a: float) {
        let ia = root.box-w / root.box-h;
        let w = a == 0 ? 1.0 : (a > ia ? 1.0 : a / ia);
        let h = a == 0 ? 1.0 : (a > ia ? ia / a : 1.0);
        root.crop-w = w;
        root.crop-h = h;
        root.crop-x = (1 - w) / 2;
        root.crop-y = (1 - h) / 2;
    }

    function move-crop(dx: length, dy: length) {
        root.crop-x = Math.clamp(root.crop-x + dx / root.box-w, 0, 1 - root.crop-w);
        root.crop-y = Math.clamp(root.crop-y + dy / root.box-h, 0, 1 - root.crop-h);
    }

    function resize-crop(left: bool, top: bool, dx: length, dy: length) {
        let m = 0.05;
        let ndx = dx / root.box-w;
        let ndy = dy / root.box-h;
        if (left) {
            let right = root.crop-x + root.crop-w;
            let nx = Math.clamp(root.crop-x + ndx, 0, right - m);
            root.crop-x = nx;
            root.crop-w = right - nx;
        } else {
            root.crop-w = Math.clamp(root.crop-w + ndx, m, 1 - root.crop-x);
        }
        if (top) {
            let bottom = root.crop-y + root.crop-h;
            let ny = Math.clamp(root.crop-y + ndy, 0, bottom - m);
            root.crop-y = ny;
            root.crop-h = bottom - ny;
        } else {
            root.crop-h = Math.clamp(root.crop-h + ndy, m, 1 - root.crop-y);
        }
    }

    function reset-edit-values() {
        root.brightness = 0;
        root.contrast = 0;
        root.blur = 0;
        root.sharpen = 0;
        root.hue = 0;
        root.grayscale = false;
        root.invert = false;
    }

    changed image => {
        root.cropping = false;
        root.detail-valid = false;
        detail-timer.restart();
        if (!root.editing) {
            root.turns = 0;
            root.reset-view();
            snap.running = true;
        }
    }
    changed view-mode => {
        root.reset-view();
    }

    snap := Timer {
        interval: 60ms;
        running: false;
        triggered => {
            self.running = false;
        }
    }

    idle-timer := Timer {
        interval: 2500ms;
        triggered => {
            self.running = false;
            root.idle = true;
        }
    }

    detail-timer := Timer {
        interval: 120ms;
        running: false;
        triggered => {
            self.running = false;
            root.request-detail();
        }
    }

    ThemeAnimator { }

    fs := FocusScope {

        init => {
            self.focus();
        }

        KeyBinding {
            keys: @keys(F);
            activated => {
                root.full-screen = !root.full-screen;
            }
        }

        KeyBinding {
            keys: @keys(J);
            activated => {
                root.zoom-at(1 / 1.25, 0px, 0px);
            }
        }

        KeyBinding {
            keys: @keys(K);
            activated => {
                root.zoom-at(1.25, 0px, 0px);
            }
        }

        KeyBinding {
            keys: @keys(HyphenMinus);
            activated => {
                root.zoom-at(1 / 1.25, 0px, 0px);
            }
        }

        KeyBinding {
            keys: @keys(Equals);
            activated => {
                root.zoom-at(1.25, 0px, 0px);
            }
        }

        KeyBinding {
            keys: @keys(Plus);
            activated => {
                root.zoom-at(1.25, 0px, 0px);
            }
        }

        KeyBinding {
            keys: @keys(LeftArrow);
            activated => {
                root.go-previous();
            }
        }

        KeyBinding {
            keys: @keys(RightArrow);
            activated => {
                root.go-next();
            }
        }

        KeyBinding {
            keys: @keys(H);
            activated => {
                root.go-previous();
            }
        }

        KeyBinding {
            keys: @keys(L);
            activated => {
                root.go-next();
            }
        }

        KeyBinding {
            keys: @keys(Escape);
            activated => {
                root.close-tools();
            }
        }

        KeyBinding {
            keys: @keys(Control + P);
            activated => {
                root.print-requested();
            }
        }

        KeyBinding {
            keys: @keys(R);
            activated => {
                root.turns += 1;
            }
        }

        KeyBinding {
            keys: @keys(Shift + R);
            activated => {
                root.turns -= 1;
            }
        }

        KeyBinding {
            keys: @keys(C);
            activated => {
                root.toggle-crop();
            }
        }

        KeyBinding {
            keys: @keys(E);
            activated => {
                if (!root.cropping && root.can-edit) {
                    root.editing = !root.editing;
                }
            }
        }

        KeyBinding {
            keys: @keys(I);
            activated => {
                root.info-requested();
            }
        }

        key-pressed(event) => {

            if (event.text == Key.Z) {
                root.z-held = true;
                return accept;
            }
            return reject;
        }

        key-released(event) => {
            if (event.text == Key.Z) {
                root.z-held = false;
                return accept;
            }
            return reject;
        }

        NectanAppFrame {
            maximized: root.maximized || root.full-screen;

            viewport := Rectangle {
                clip: true;

                Image {
                    source: root.image;
                    image-fit: ImageFit.fill;
                    width: root.disp-w;
                    height: root.disp-h;
                    x: (viewport.width - self.width) / 2 + root.eff-pan-x;
                    y: (viewport.height - self.height) / 2 + root.eff-pan-y;
                    transform-rotation: root.rot;
                }

                if root.detail-valid && !root.editing && !root.cropping: Image {
                    source: root.detail;
                    image-fit: ImageFit.fill;
                    x: (viewport.width - root.box-w) / 2 + root.eff-pan-x + root.detail-x * root.box-w;
                    y: (viewport.height - root.box-h) / 2 + root.eff-pan-y + root.detail-y * root.box-h;
                    width: root.detail-w * root.box-w;
                    height: root.detail-h * root.box-h;
                }

                TouchArea {
                    enabled: !root.cropping;
                    mouse-cursor: root.picking-color ? MouseCursor.crosshair
                        : root.z-held ? MouseCursor.ns-resize
                        : (self.pressed ? MouseCursor.grabbing : MouseCursor.grab);

                    pointer-event(e) => {
                        root.poke();
                        if (root.picking-color) {
                            if (e.kind == PointerEventKind.move) {
                                root.update-probe(self.mouse-x, self.mouse-y);
                            }
                            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                                root.commit-probe();
                            }
                            return;
                        }
                        if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                            root.start-pan-x = root.eff-pan-x;
                            root.start-pan-y = root.eff-pan-y;
                            root.drag-start-zoom = root.zoom;
                        }
                    }

                    moved => {
                        if (self.pressed) {
                            if (root.z-held) {
                                root.zoom-from(
                                    root.drag-start-zoom,
                                    root.start-pan-x, root.start-pan-y,
                                    Math.exp((self.pressed-y - self.mouse-y) / 200px),
                                    self.pressed-x - viewport.width / 2,
                                    self.pressed-y - viewport.height / 2);
                            } else {
                                root.pan-x = Math.clamp(
                                    root.start-pan-x + self.mouse-x - self.pressed-x,
                                    -root.max-pan-x, root.max-pan-x);
                                root.pan-y = Math.clamp(
                                    root.start-pan-y + self.mouse-y - self.pressed-y,
                                    -root.max-pan-y, root.max-pan-y);
                            }
                        }
                    }

                    double-clicked => {
                        if (!root.picking-color) {
                            root.reset-view();
                        }
                    }
                    scroll-event(e) => {
                        if (PropertiesBridge.open) {
                            return reject;
                        }
                        root.poke();
                        root.zoom-at(1.0 + e.delta-y / 1200px, self.mouse-x - viewport.width / 2, self.mouse-y - viewport.height / 2);
                        return accept;
                    }
                }

                if root.picking-color && root.probe-over && root.probed.hex != "": Rectangle {
                    x: Math.min(root.probe-x + 16px, viewport.width - self.width - 8px);
                    y: Math.min(root.probe-y + 20px, viewport.height - self.height - 8px);
                    width: probe-layout.preferred-width;
                    height: probe-layout.preferred-height;
                    background: #000c;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #fff3;

                    probe-layout := HorizontalLayout {
                        padding: 8px;
                        spacing: 8px;
                        cross-axis-alignment: center;

                        Rectangle {
                            width: 16px;
                            height: 16px;
                            border-radius: 4px;
                            background: root.probed.color;
                            border-width: 1px;
                            border-color: #fff5;
                        }

                        Text {
                            text: root.probed.hex;
                            color: #f1f1f1;
                            font-size: 0.85rem;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.cropping: cropbox := Rectangle {
                    x: (viewport.width - self.width) / 2 + root.eff-pan-x;
                    y: (viewport.height - self.height) / 2 + root.eff-pan-y;
                    width: root.box-w;
                    height: root.box-h;

                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: cropbox.width;
                        height: root.crop-y * cropbox.height;
                        background: #0009;
                    }

                    Rectangle {
                        y: (root.crop-y + root.crop-h) * cropbox.height;
                        width: cropbox.width;
                        height: cropbox.height - self.y;
                        background: #0009;
                    }

                    Rectangle {
                        x: 0px;
                        y: root.crop-y * cropbox.height;
                        width: root.crop-x * cropbox.width;
                        height: root.crop-h * cropbox.height;
                        background: #0009;
                    }

                    Rectangle {
                        x: (root.crop-x + root.crop-w) * cropbox.width;
                        y: root.crop-y * cropbox.height;
                        width: cropbox.width - self.x;
                        height: root.crop-h * cropbox.height;
                        background: #0009;
                    }

                    sel := Rectangle {
                        x: root.crop-x * cropbox.width;
                        y: root.crop-y * cropbox.height;
                        width: root.crop-w * cropbox.width;
                        height: root.crop-h * cropbox.height;
                        border-width: 1.5px;
                        border-color: Colors.white;

                        Rectangle {
                            x: sel.width / 3;
                            width: 1px;
                            background: #fff5;
                        }

                        Rectangle {
                            x: sel.width * 2 / 3;
                            width: 1px;
                            background: #fff5;
                        }

                        Rectangle {
                            y: sel.height / 3;
                            height: 1px;
                            background: #fff5;
                        }

                        Rectangle {
                            y: sel.height * 2 / 3;
                            height: 1px;
                            background: #fff5;
                        }

                        TouchArea {
                            mouse-cursor: MouseCursor.move;

                            moved => {
                                if (self.pressed) {
                                    root.move-crop(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                                }
                            }
                        }
                    }

                    CropHandle {
                        x: sel.x - self.width / 2;
                        y: sel.y - self.height / 2;
                        cursor: MouseCursor.nwse-resize;
                        dragged(dx, dy) => { root.resize-crop(true, true, dx, dy); }
                    }

                    CropHandle {
                        x: sel.x + sel.width - self.width / 2;
                        y: sel.y - self.height / 2;
                        cursor: MouseCursor.nesw-resize;
                        dragged(dx, dy) => { root.resize-crop(false, true, dx, dy); }
                    }

                    CropHandle {
                        x: sel.x - self.width / 2;
                        y: sel.y + sel.height - self.height / 2;
                        cursor: MouseCursor.nesw-resize;
                        dragged(dx, dy) => { root.resize-crop(true, false, dx, dy); }
                    }

                    CropHandle {
                        x: sel.x + sel.width - self.width / 2;
                        y: sel.y + sel.height - self.height / 2;
                        cursor: MouseCursor.nwse-resize;
                        dragged(dx, dy) => { root.resize-crop(false, false, dx, dy); }
                    }
                }
            }

            if root.loading: Rectangle {
                Spinner { }
            }

            IconButton {
                shown: root.ui-visible && !root.cropping;
                inner-bg: self.hovered ? #0008 : #0003;
                x: 16px;
                y: (parent.height - self.height) / 2;
                icon: Icons.chevron-left;
                colorize: #f1f1f1;
                clicked => { root.go-previous(); }
            }

            IconButton {
                shown: root.ui-visible && !root.cropping;
                inner-bg: self.hovered ? #0008 : #0003;
                x: parent.width - self.width - 16px - (root.editing ? 264px : 0px);
                y: (parent.height - self.height) / 2;
                icon: Icons.chevron-right;
                colorize: #f1f1f1;
                clicked => { root.go-next(); }
            }

            Rectangle {
                visible: root.ui-visible;
                width: 100%;
                x: 0;
                y: 0;
                background: @linear-gradient(180deg, #000c 0%, #0008 40%, #0000 100%);
                height: 96px;

                WindowMoveArea { }

                view-bar := HorizontalLayout {
                    cross-axis-alignment: start;
                    padding-left: 20px;
                    padding-top: 16px;
                    padding-right: 20px;

                    VerticalLayout {
                        Text {
                            text: root.file-name;
                            font-size: 1.5rem;
                            font-weight: 600;
                            color: #f1f1f1;
                            overflow: elide;
                        }

                        Text {
                            text: root.file-size;
                            font-size: 0.8rem;
                            font-weight: 500;
                            color: #888;
                        }
                    }

                    Rectangle { }

                    IconButton {
                        icon: Icons.key;
                        icon-size: 16px;
                        inner-bg: self.hovered ? Theme.colors.third-col.with-alpha(0.5) : transparent;
                        colorize: #c8c8c8;
                        clicked => { root.shortcuts = true; }
                    }

                    IconButton {
                        icon: Icons.minimize;
                        icon-size: 16px;
                        inner-bg: self.hovered ? Theme.colors.third-col.with-alpha(0.5) : transparent;
                        colorize: #f1f1f1;
                        clicked => { root.minimized = true; }
                    }

                    IconButton {
                        icon: Icons.maximize;
                        icon-size: 16px;
                        inner-bg: self.hovered ? Theme.colors.third-col.with-alpha(0.5) : transparent;
                        colorize: #f1f1f1;
                        clicked => {
                            root.maximized = !root.maximized;
                        }
                    }

                    IconButton {
                        icon: Icons.close;
                        icon-size: 16px;
                        inner-bg: self.hovered ? Theme.colors.third-col.with-alpha(0.5) : transparent;
                        colorize: #f1f1f1;
                        clicked => { root.close(); }
                    }
                }
            }

            if !root.cropping: GlassPanel {
                shown: root.ui-visible;
                activity => { root.poke(); }
                y: parent.height - self.height - 20px;
                x: (parent.width - self.width) / 2;
                width: tools-bar.preferred-width + 20px;
                height: 36px;

                tools-bar := HorizontalLayout {
                    spacing: 4px;
                    cross-axis-alignment: center;
                    alignment: center;

                    IconButton {
                        icon: Icons.rotate-left;
                        icon-size: 15px;
                        inner-bg: self.hovered ? #fff2 : transparent;
                        colorize: #f1f1f1;
                        clicked => { root.turns -= 1; }
                    }

                    IconButton {
                        icon: Icons.rotate-right;
                        icon-size: 15px;
                        inner-bg: self.hovered ? #fff2 : transparent;
                        colorize: #f1f1f1;
                        clicked => { root.turns += 1; }
                    }

                    IconButton {
                        icon: Icons.info;
                        icon-size: 16px;
                        inner-bg: self.hovered ? #fff2 : transparent;
                        colorize: #f1f1f1;
                        clicked => { root.info-requested(); }
                    }

                    IconButton {
                        icon: Icons.zoom-out;
                        icon-size: 16px;
                        inner-bg: self.hovered ? #fff2 : transparent;
                        colorize: #f1f1f1;
                        clicked => { root.zoom-at(1 / 1.25, 0px, 0px); }
                    }

                    IconButton {
                        icon: Icons.zoom-in;
                        icon-size: 16px;
                        inner-bg: self.hovered ? #fff2 : transparent;
                        colorize: #f1f1f1;
                        clicked => { root.zoom-at(1.25, 0px, 0px); }
                    }

                    Rectangle {
                        min-width: 48px;

                        Text {
                            text: "\{Math.round(root.zoom * 100)}%";
                            color: Colors.white;
                            font-size: Theme.font-size;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }

                        TouchArea {
                            mouse-cursor: MouseCursor.ns-resize;

                            pointer-event(e) => {
                                root.poke();
                                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                                    root.drag-start-zoom = root.zoom;
                                    root.start-pan-x = root.eff-pan-x;
                                    root.start-pan-y = root.eff-pan-y;
                                }
                            }

                            moved => {
                                if (self.pressed) {
                                    root.zoom-from(
                                        root.drag-start-zoom,
                                        root.start-pan-x, root.start-pan-y,
                                        Math.exp((self.pressed-y - self.mouse-y) / 150px),
                                        0px, 0px);
                                }
                            }

                            double-clicked => { root.reset-view(); }
                        }
                    }

                    // IconButton {
                    //     icon: Icons.print;
                    //     icon-size: 16px;
                    //     inner-bg: self.hovered ? Theme.colors.third-col.with-alpha(0.5) : transparent;
                    //     colorize: #f1f1f1;
                    //     clicked => { root.print-requested(); }
                    // }
                    // if root.can-edit: IconButton {
                    //     icon: Icons.crop;
                    //     icon-size: 16px;
                    //     inner-bg: self.hovered ? #fff2 : transparent;
                    //     colorize: #f1f1f1;
                    //     clicked => { root.toggle-crop(); }
                    // }
                    //
                    // if root.can-edit: IconButton {
                    //     icon: Icons.edit;
                    //     icon-size: 16px;
                    //     inner-bg: self.hovered ? #fff2 : transparent;
                    //     colorize: #f1f1f1;
                    //     clicked => { root.editing = !root.editing; }
                    // }


                    IconButton {
                        icon: root.full-screen ? Icons.exit-fullscreen : Icons.fullscreen;
                        icon-size: 16px;
                        inner-bg: self.hovered ? #fff2 : transparent;
                        colorize: #f1f1f1;
                        clicked => {
                            root.full-screen = !root.full-screen;
                        }
                    }

                    IconButton {
                        icon: Icons.more-horizontal;
                        icon-size: 16px;
                        inner-bg: self.hovered ? #fff2 : transparent;
                        colorize: #f1f1f1;
                        clicked => { menu-popup.show(); }

                        menu-popup := MenuPopup {
                            width: parent.width;
                            height: parent.height;
                            menu-width: 208px;

                            MenuRow {
                                text: @tr("Pick color");
                                icon: Icons.pipette;
                                clicked => {
                                    root.editing = false;
                                    root.cropping = false;
                                    root.picking-color = true;
                                    root.poke();
                                    menu-popup.close();
                                }
                            }

                            MenuRow {
                                text: @tr("Print");
                                icon: Icons.print;
                                clicked => {
                                    menu-popup.close();
                                }
                            }

                            MenuRow {
                                text: @tr("Edit");
                                icon: Icons.edit;
                                clicked => {
                                    menu-popup.close();
                                }
                            }

                            MenuRow {
                                text: @tr("Crop");
                                icon: Icons.crop;
                                clicked => {
                                    menu-popup.close();
                                }
                            }
                        }
                    }
                }
            }

            if root.cropping: GlassPanel {
                shown: root.ui-visible;
                activity => { root.poke(); }
                y: parent.height - self.height - 20px;
                x: (parent.width - self.width) / 2;
                width: crop-bar.preferred-width + 16px;
                height: 36px;

                crop-bar := HorizontalLayout {
                    padding: 8px;
                    spacing: 4px;
                    alignment: center;
                }
            }

            GlassPanel {
                opacity: root.editing ? 1.0 : 0.0;
                visible: self.opacity > 0.01;
                activity => { root.poke(); }
                x: root.editing ? parent.width - self.width - 16px : parent.width;
                y: 84px;
                width: 220px;
                height: edit-col.preferred-height + 24px;
                animate opacity { duration: 160ms; }

                edit-col := VerticalLayout {
                    padding-top: 12px;
                    padding: 16px;
                    spacing: 8px;

                    EditSlider {
                        label: @tr("Brightness");
                        value <=> root.brightness;
                        minimum: -100;
                        changed => { root.edits-changed(); }
                    }

                    EditSlider {
                        label: @tr("Contrast");
                        value <=> root.contrast;
                        minimum: -100;
                        changed => { root.edits-changed(); }
                    }

                    EditSlider {
                        label: @tr("Hue");
                        value <=> root.hue;
                        minimum: 0;
                        maximum: 360;
                        changed => { root.edits-changed(); }
                    }

                    EditSlider {
                        label: @tr("Blur");
                        minimum: 0;
                        maximum: 10;
                        value <=> root.blur;
                        changed => { root.edits-changed(); }
                    }

                    EditSlider {
                        label: @tr("Sharpen");
                        minimum: 0;
                        maximum: 10;
                        value <=> root.sharpen;
                        changed => { root.edits-changed(); }
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        alignment: space-between;

                        IconButton {
                            icon: Icons.rotate-left;
                            icon-size: 16px;
                            inner-bg: self.hovered ? Theme.colors.third-col.with-alpha(0.5) : transparent;
                            colorize: #f1f1f1;
                            clicked => { root.turns -= 1; }
                        }

                        IconButton {
                            icon: Icons.rotate-right;
                            icon-size: 16px;
                            inner-bg: self.hovered ? Theme.colors.third-col.with-alpha(0.5) : transparent;
                            colorize: #f1f1f1;
                            clicked => { root.turns += 1; }
                        }

                        IconButton {
                            icon: Icons.flip-horizontal;
                            icon-size: 16px;
                            inner-bg: self.hovered ? Theme.colors.third-col.with-alpha(0.5) : transparent;
                            colorize: #f1f1f1;
                            clicked => { root.flip-horizontal(); }
                        }

                        IconButton {
                            icon: Icons.flip-horizontal;
                            rotation: 90deg;
                            icon-size: 16px;
                            inner-bg: self.hovered ? Theme.colors.third-col.with-alpha(0.5) : transparent;
                            colorize: #f1f1f1;
                            clicked => { root.flip-vertical(); }
                        }

                        IconButton {
                            icon: Icons.invert;
                            icon-size: 16px;
                            inner-bg: self.hovered ? Theme.colors.third-col.with-alpha(0.5) : transparent;
                            colorize: #f1f1f1;
                            clicked => { root.invert = !root.invert; root.edits-changed(); }
                        }
                    }

                    HorizontalLayout {
                        alignment: end;
                        spacing: 12px;

                        PrimaryButton {
                            alt: true;
                            text: @tr("Cancel");
                            image: Icons.close;
                            image-size: 14px;

                            clicked => {
                                root.reset-edit-values();
                                root.turns = 0;
                                root.editing = false;
                                root.edit-cancelled();
                            }
                        }

                        PrimaryButton {
                            text: @tr("Save as");
                            image: Icons.save;

                            clicked => { root.save-requested(); }
                        }
                    }
                }
            }
        }
    }

    if PropertiesBridge.open: Properties {
        restore-focus => { fs.focus(); }
    }
    if root.shortcuts: ShortcutsModal {
        on-close => { fs.focus(); root.shortcuts = false; }
    }
}
