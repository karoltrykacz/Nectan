export component App inherits Window {

    title: "Nectan";
    preferred-width: WindowBridge.window-width;
    preferred-height: WindowBridge.window-height;

    changed width => {
        WindowBridge.window-width = root.width;
    }
    changed height => {
        WindowBridge.window-height = root.height;
    }

    min-width: 400px;
    min-height: 200px;
    resize-border-width: 6px;
    no-frame: !Theme.config.native-topbar;
    background: transparent;
    maximized <=> WindowBridge.maximized;
    full-screen <=> WindowBridge.fullscreen;
    default-font-family: Theme.config.font;
    default-font-size: Theme.font-size;

    callback pasted();
    in-out property <keys> toggle-sidebar: @keys(Control + B);

    ThemeAnimator { }

    forward-focus: main-fs;

    main-fs := MainFocusScope {

        init => { self.focus(); }

        NectanAppFrame {
            maximized: root.maximized;

            // Shower {
            //     z: 1;
            // }

            Topbar { }

            Sidebar { }

            MainContentArea {

                Explorer { }
            }
        }

        if Theme.theme-selector: ThemeSelector { }

        property <bool> any-modal-open: SettingsBridge.open
            || WindowBridge.nectan-modal-open
            || CommandBridge.open
            || WindowBridge.welcome-open
            || Error.open
            || Theme.theme-selector;

        changed any-modal-open => {
            if !any-modal-open {
                main-fs.focus();
            }
            WindowBridge.any-modal-open = any-modal-open;
        }

        Rectangle {
            z: 1;

            if SettingsBridge.open: Settings { }

            if WindowBridge.nectan-modal-open: NectanModal { }

            if ExplorerBridge.searching-recursive: RecursiveSearch { }

            if Error.open: ErrorModal { }

            if HasherBridge.open: Hasher { }

            if OpenWithBridge.open: OpenWithModal { }

            if SetTerminalCommandBridge.open: SetTerminalCommand { }

            if PropertiesBridge.open: Properties { }

            if CommandBridge.open: Command { }

            Notification { }
        }
    }
}
