    TransfersBridge,
    Transfers,
    TransferItem,
} from "../../shared/transfers.slint";
import {
    AddDeviceModal,
    AddDeviceBridge,
    ConnectionOfferBridge,
    ConnectionOfferModal,
} from "../../shared/add_remote_modal.slint";
import { ErrorModal, Error } from "../../shared/error_modal.slint";
import {
