export {
    Keys,
    Theme,
    Error,
    Icons,
    DirEntry,
    DeviceItem,
    HoverBridge,
    TransferItem,
    WindowBridge,
    DevicesBridge,
    SidebarBridge,
    SettingsBridge,
    ExplorerBridge,
    AddDeviceBridge,
    TransfersBridge,
    EssentialTileData,
    ConnectionOfferBridge,
    IncomingTransferOfferBridge,
    OutcomingTransferModalBridge,
}
export global Api {
    pure callback make-data() -> data-transfer;
    pure callback can-drop() -> DragAction;
    callback dropped();
}

component MainFocusScope inherits FocusScope {
    focus-on-click: true;
    width: 100%;
    height: 100%;

    init => {
        self.focus();
    }

    KeyBinding {
        keys: @keys(F11);
        activated => { WindowBridge.maximized = !WindowBridge.maximized; }
    }

    KeyBinding {
        keys: Keys.map.essentials.keys;
        activated => {
            SidebarBridge.essentials();
        }
    }

    KeyBinding {
        keys: Keys.map.essentials.alt-keys;
        activated => {
            SidebarBridge.essentials();
        }
    }

    KeyBinding {
        keys: Keys.map.tabs.keys;
        activated => {
            SidebarBridge.essentials();
        }
    }

    KeyBinding {
        keys: Keys.map.tabs.alt-keys;
        activated => {
            SidebarBridge.essentials();
        }
    }

    KeyBinding {
        keys: Keys.map.toggle-sidebar.keys;
        activated => {
            WindowBridge.sidebar-visible = !WindowBridge.sidebar-visible;
            WindowBridge.sidebar-hover = false;
        }
    }

    KeyBinding {
        keys: Keys.map.toggle-sidebar.alt-keys;
        activated => {
            WindowBridge.sidebar-visible = !WindowBridge.sidebar-visible;
            WindowBridge.sidebar-hover = false;
        }
    }

    KeyBinding {
        keys: Keys.map.settings.keys;
        activated => {
            SettingsBridge.open = !SettingsBridge.open;
        }
    }

    KeyBinding {
        keys: Keys.map.settings.alt-keys;
        activated => {
            SettingsBridge.open = !SettingsBridge.open;
        }
    }

    KeyBinding {
        keys: Keys.map.transfers.keys;
        activated => { AppBridge.current-window = CurrentWindow.transfers; }
    }

    KeyBinding {
        keys: Keys.map.transfers.alt-keys;
        activated => { AppBridge.current-window = CurrentWindow.transfers; }
    }

    KeyBinding {
        keys: @keys(Shift + A);
        activated => {
            AddDeviceBridge.open = !AddDeviceBridge.open;
        }
    }

    @children
}

export component App inherits Window {

    title: "Nectan";
    preferred-width: 720px;
    preferred-height: 520px;
    min-width: 400px;
    min-height: 200px;
    resize-border-width: 6px;
    no-frame: !Theme.config.native-topbar;
    background: transparent;
    maximized: WindowBridge.maximized;

    default-font-family: Theme.config.font;
    default-font-size: Theme.font-size;

    z: 0;

    callback pasted();
    in-out property <keys> toggle-sidebar: @keys(Control + B);

    ThemeAnimator { }

    forward-focus: main-fs;

    main-fs := MainFocusScope {

        init => { self.focus(); }

        MainWindowTouchArea { }

        Rectangle {
            z: 1;
            background: Theme.colors.primary-col;
            border-color: Theme.colors.fourth-col;
            border-width: root.maximized ? 0 : 1px;
            border-radius: Theme.config.round-edges ? root.maximized ? 0 : 24px : 0;
            // border-corner-shape: superellipse(Theme.config.edges-shape);
            clip: true;

            MainWindowTouchArea { }

            TopBarShower { }

            SidebarShower {
                z: 1;
            }

            Topbar { }

            Sidebar { }

            HorizontalLayout {
                spacing: 8px;
                padding: 8px;
                padding-left: !WindowBridge.sidebar-visible ? 8px : WindowBridge.sidebar-width;
                padding-top: Theme.config.native-topbar ? 8px :
                    Theme.config.topbar-always-on ? 24px :
                    WindowBridge.topbar-hover ? 24px : 8px;

                // For sidebar
                animate x, padding-left {
                    duration: Theme.animation-speed;
                    easing: Theme.easing;
                }
		// Topbar
                animate padding-top {
                    delay: 200ms;
                    duration: Theme.animation-speed;
                    easing: Theme.easing;
                }

                // if App.current-window == Window.device: DeviceScreen { }

                if Theme.theme-selector: ThemeSelector { }

                if AppBridge.current-window == CurrentWindow.transfers: Transfers { }

                if AppBridge.current-window == CurrentWindow.explorer: Explorer { }
            }
        }

        property <bool> any-modal-open: SettingsBridge.open
            || WindowBridge.nectan-modal-open
            || AddDeviceBridge.open
            || SearchBridge.open
            || OutcomingTransferModalBridge.open
            || IncomingTransferOfferBridge.open
            || WindowBridge.welcome-open
            || Error.open
            || Theme.theme-selector;

        changed any-modal-open => {
            if !any-modal-open {
                main-fs.focus();
            }
            WindowBridge.any-modal-open = any-modal-open;
        }

        Rectangle {
            z: 1;

            if SettingsBridge.open: Settings { }

            if WindowBridge.nectan-modal-open: NectanModal { }

            if OutcomingTransferModalBridge.open: OutcomingTransferModal { }

            if IncomingTransferOfferBridge.open: IncomingTransferOfferModal { }

            if AddDeviceBridge.open:  AddDeviceModal { }

            if ExplorerBridge.searching-recursive: RecursiveSearch { }

            if Error.open: ErrorModal { }

            // if SearchBridge.open: Search { }

            // if WindowBridge.welcome-open: WelcomeScreen { }
        }
    }
}
