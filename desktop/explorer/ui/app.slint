    ThemeSelector,
    Carousel,
    SvgIcon,
    IconButton,
} from "../../shared/elements.slint";
import { ListView, VerticalBox } from "std-widgets.slint";
import { NectanModal } from "../../shared/nectan_modal.slint";
import { SearchBridge } from "search.slint";
import { SettingsBridge, Settings, SettingsRow } from "settings.slint";
