        background: Theme.colors.fourth-col.with-alpha(0.5);
    }

    SettingsRow {
        title: @tr("Update zoxide database");
        subtitle: @tr("Browsing will update zoxide database. \nIf disabled Nectan will maintain its own (separate) database.\nZoxide doesn't need to be installed.");

