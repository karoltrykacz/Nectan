import { ScrollView, TextEdit, VerticalBox, LineEdit } from "std-widgets.slint";
import {
    IconsEditor,
    ChangeShortcut,
    FontModal,
} from "../../shared/settings.slint";
import { Theme } from "../../shared/theme.slint";
import {
    PrimaryButton,
    PlainLineEdit,
    Switch,
    Dropdown,
    LangSelection,
    Slider,
    GeneralModal,
    IconButton,
    SvgIcon,
    SettingsRow,
} from "../../shared/elements.slint";
import { WindowBridge } from "../../shared/window.slint";
import {
    Keys,
    ShortcutGroup,
    KeyMap,
    KeysBadge,
    ShortcutItem,
    ShortcutGroupView,
} from "../../shared/keys_shared.slint";
import { Icons } from "../../shared/icons.slint";
import { ExplorerBridge } from "explorer/bridge.slint";
import { SetTerminalCommandBridge } from "terminal.slint";


export global SettingsBridge {

    in-out property <bool> font-modal;
    in-out property <bool> icons-config;

    in-out property <bool> open;
    in-out property <int> active-tab: 0;
    in-out property <int> selected-row: -1;

    in-out property <float> thumbnails-cache;

    property <int> tab-count: 6;

    pure callback map-thumbnails-cache-size(float) -> string;
    pure callback set-thumbnails-cache-size(float);

    callback change-default-dir();
    callback bind-global-shortcut();

    callback open-zoxide-github();
    in-out property <bool> update-zoxide;
    callback toggle-update-zoxide();

    pure callback format-speed(float) -> string;

    public function next-tab() {
        active-tab = Math.mod(active-tab + 1, tab-count);
    }

    public function previous-tab() {
        active-tab = Math.mod(active-tab + tab-count - 1, tab-count);
    }
}


component SettingsPage inherits FocusScope {

    init => {
        self.focus();
        SettingsBridge.selected-row = -1;
    }

    in property <string> title;
    in property <string> subtitle;
    in property <int> row-count: 0;

    KeyBinding {
        keys: @keys(J);
        activated => {
            SettingsBridge.selected-row = Math.min(SettingsBridge.selected-row + 1, row-count - 1);
        }
    }

    KeyBinding {
        keys: @keys(K);
        activated => {
            SettingsBridge.selected-row = Math.max(SettingsBridge.selected-row - 1, 0);
        }
    }

    KeyBinding {
        keys: @keys(UpArrow);
        activated => {
            SettingsBridge.selected-row = Math.max(SettingsBridge.selected-row - 1, 0);
        }
    }

    KeyBinding {
        keys: @keys(DownArrow);
        activated => {
            SettingsBridge.selected-row = Math.min(SettingsBridge.selected-row + 1, row-count - 1);
        }
    }

    ScrollView {
        VerticalLayout {

            padding: 20px;
            padding-top: 16px;
            spacing: 6px;
            alignment: start;

            Text {
                text: title;
                color: Theme.colors.primary-font;
                font-size: 1.5rem;
                font-weight: 600;
            }

            if subtitle != "":Text {
                text: subtitle;
                color: Theme.colors.third-font;
                font-size: 0.9rem;
                font-weight: 400;
            }

            Rectangle {
                height: 4px;
            }

            @children
        }
    }
}

component SettingsTab inherits Rectangle {
    in property <string> tab-name;
    in property <int> tab-idx;
    in property <image> icon;
    in property <length> icon-size;

    height: 28px;
    border-radius: 12px;
    corner-shape: CornerShape.squircle;
    background: SettingsBridge.active-tab == tab-idx ? Theme.colors.secondary-col
        : (ta.has-hover ? Theme.colors.secondary-col : transparent);
    border-width: 1px;
    border-color: SettingsBridge.active-tab == tab-idx ? Theme.colors.fourth-col : transparent;
    transform-scale: ta.pressed ? 0.9875 : 1.0;

    animate transform-scale {
        duration: 20ms;
        easing: ease;
    }

    HorizontalLayout {
        cross-axis-alignment: center;
        alignment: start;
        padding-left: 12px;
        spacing: 8px;

        SvgIcon {
            source: root.icon;
            size: root.icon-size;
        }

        Text {
            vertical-alignment: center;
            text: tab-name;
            color: SettingsBridge.active-tab == tab-idx
                ? Theme.colors.primary-font
                : (ta.has-hover ? Theme.colors.primary-font : Theme.colors.secondary-font);
            font-size: 0.9rem;
            font-weight: 400;
        }
    }

    ta := TouchArea {
        enabled: SettingsBridge.open;
        clicked => {
            SettingsBridge.active-tab = tab-idx;
        }
    }
}

component General inherits SettingsPage {

    title: @tr("General");
    row-count: 6;

    SettingsRow {
        z: 1;
        idx: 1;
        title: @tr("Language");
        subtitle: @tr("Change language.");
        LangSelection { }
    }

    Rectangle {
        height: 1px;
        background: Theme.colors.fourth-col.with-alpha(0.5);
    }

    SettingsRow {
        idx: 2;
        title: @tr("Community");
        subtitle: @tr("Join Nectan discord server.");

        PrimaryButton {
            text: @tr("Join");

            clicked => {
                WindowBridge.join_discord();
            }
        }
    }

    Rectangle {
        height: 1px;
        background: Theme.colors.fourth-col.with-alpha(0.5);
    }

    SettingsRow {
        idx: 3;
        title: @tr("Source code");
        subtitle: @tr("Open GitHub.");

        PrimaryButton {
            text: @tr("Open");

            clicked => {
                WindowBridge.open_github();
            }
        }
    }
}

component Explorer inherits SettingsPage {
    title: @tr("Explorer");
    row-count: 3;

    SettingsRow {
        idx: 2;
        title: @tr("Thumbnails cache");
        subtitle: @tr("Set maximum cache size for thumbnails");

        HorizontalLayout {
            spacing: 20px;
            cross-axis-alignment: center;

            Text {
                text: SettingsBridge.map-thumbnails-cache-size(SettingsBridge.thumbnails-cache);
                color: Theme.colors.third-font;
                font-size: 0.9rem;
                font-weight: 500;
            }

            Slider {
                width: 100px;
                minimum: 0.0;
                maximum: 1.0;
                value <=> SettingsBridge.thumbnails-cache;

                released(value) => {
                    SettingsBridge.set-thumbnails-cache-size(value);
                }
            }
        }
    }

    Rectangle {
        height: 1px;
        background: Theme.colors.fourth-col.with-alpha(0.5);
    }

    SettingsRow {
        title: @tr("Extensions badges");
        subtitle: @tr("Display colored extensions badges on top of file icon");
        Switch {
            toggled => {}
        }
    }

    Rectangle {
        height: 1px;
        background: Theme.colors.fourth-col.with-alpha(0.5);
    }

    SettingsRow {
        title: @tr("File extensions");
        subtitle: @tr("Display file extensions");
        Switch {
            toggled => {}
        }
    }
}

component Appearance inherits SettingsPage {
    title: @tr("Appearance");
    row-count: 5;

    SettingsRow {
        title: @tr("Theme");
        subtitle: Theme.themes[Theme.mode].name;
        PrimaryButton {
            text: @tr("Change");
            clicked => {
                Theme.theme-selector = true;
                SettingsBridge.open = false;
            }
        }
    }

    Rectangle {
        height: 1px;
        background: Theme.colors.fourth-col.with-alpha(0.5);
    }

    SettingsRow {

        title: @tr("Font");
        subtitle: Theme.config.font;

        PrimaryButton {
            text: @tr("Change");
            clicked => {
                SettingsBridge.font-modal = true;
            }
        }
    }

    Rectangle {
        height: 1px;
        background: Theme.colors.fourth-col.with-alpha(0.5);
    }

    SettingsRow {
        idx: 1;
        title: @tr("Icons");
        subtitle: @tr("Edit icons set");

        PrimaryButton {
            text: @tr("Edit");
            clicked => {
                SettingsBridge.icons-config = true;
            }
        }
    }

    Rectangle {
        height: 1px;
        background: Theme.colors.fourth-col.with-alpha(0.5);
    }

    SettingsRow {
        idx: 2;
        title: @tr("Font scaling");
        subtitle: @tr("Change font scale factor");

        HorizontalLayout {
            spacing: 12px;
            cross-axis-alignment: center;

            if Theme.config.font-scale != 1.0: IconButton {
                icon: Icons.refresh;
                icon-size: 16px;

                clicked => { Theme.config.font-scale = 1.0; font-factor.value = 1.0; Theme.config-changed(); }
            }

            font-factor := Slider {
                width: 100px;
                minimum: 0.75;
                maximum: 1.5;
                value <=> Theme.config.font-scale;
                released => {
                    Theme.config-changed();
                }
            }
        }
    }

    Rectangle {
        height: 1px;
        background: Theme.colors.fourth-col.with-alpha(0.5);
    }

    SettingsRow {
        idx: 1;
        title: @tr("Window edges rounded");
        subtitle: @tr("Round window edges");

        HorizontalLayout {
            spacing: 24px;
            cross-axis-alignment: center;
            Switch {
                checked <=> Theme.config.round-edges;
                toggled => { Theme.config-changed(); }
            }
        }
    }

    Rectangle {
        height: 1px;
        background: Theme.colors.fourth-col.with-alpha(0.5);
    }

    SettingsRow {
        idx: 2;
        title: @tr("Edges shape");
        subtitle: @tr("Change edges shape");
        Slider {
            width: 100px;
            value <=> Theme.config.edges-shape;
            minimum: 1.0;
            maximum: 5.0;
            released => { Theme.config-changed(); }
        }
    }

    Rectangle {
        height: 1px;
        background: Theme.colors.fourth-col.with-alpha(0.5);
    }

    SettingsRow {
        idx: 3;
        title: @tr("Native topbar");
        subtitle: @tr("Use native window decorations.");
        Switch {
            checked <=> Theme.config.native-topbar;
            toggled => { Theme.config-changed(); }
        }
    }

    Rectangle {
        height: 1px;
        background: Theme.colors.fourth-col.with-alpha(0.5);
    }

    SettingsRow {
        idx: 4;
        title: @tr("Topbar always on");
        subtitle: @tr("Don't hide topbar");

        Switch {
            checked <=> Theme.config.topbar-always-on;
            toggled => { Theme.config-changed(); }
        }
    }

    Rectangle {
        height: 1px;
        background: Theme.colors.fourth-col.with-alpha(0.5);
    }

    SettingsRow {
        idx: 2;
        title: @tr("Transparency");
        subtitle: @tr("Change transparency of in app objects");
        Slider {
            width: 100px;
            value <=> Theme.config.transparency;
            released => { Theme.config-changed(); }
        }
    }

    Rectangle {
        height: 1px;
        background: Theme.colors.fourth-col.with-alpha(0.5);
    }

    SettingsRow {
        idx: 2;
        title: @tr("Bluriness");
        subtitle: @tr("Change blur strength ");
        Slider {
            width: 100px;
            value <=> Theme.config.bluriness;
            released => { Theme.config-changed(); }
        }
    }

    Rectangle {
        height: 1px;
        background: Theme.colors.fourth-col.with-alpha(0.5);
    }

    SettingsRow {
        idx: 2;
        title: @tr("Window transparency");
        subtitle: @tr("Transparency of window backplane. \n(Window bluriness is set by compositor)");
        Slider {
            width: 100px;
            value <=> Theme.config.window-backpane-transparency;
            released => { Theme.config-changed(); }
        }
    }
}


