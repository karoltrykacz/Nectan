export component Settings inherits GeneralModal {

    on-close => { SettingsBridge.open = false; }

    forward-focus: fs;

    fs := FocusScope {
        init => { self.focus(); }

        KeyBinding {
            keys: @keys(H);
            activated => { SettingsBridge.previous-tab() }
        }

        KeyBinding {
            keys: @keys(L);
            activated => { SettingsBridge.next-tab() }
        }

        KeyBinding {
            keys: @keys(Tab);
            activated => { SettingsBridge.next-tab() }
        }

        KeyBinding {
            keys: @keys(RightArrow);
            activated => { SettingsBridge.next-tab() }
        }

        KeyBinding {
            keys: @keys(LeftArrow);
            activated => { SettingsBridge.previous-tab() }
        }

        TouchArea {
            clicked => { SettingsBridge.open = false; }
        }

        Rectangle {
            width: min(920px, parent.width - 160px);
            height: min(620px, parent.height - 160px);
            clip: true;

            background: Theme.colors.primary-col.with-alpha(Theme.config.transparency);
            backdrop-blur: Theme.blur;
            border-radius: 20px;
            corner-shape: CornerShape.squircle;
            border-width: 1px;
            border-color: Theme.colors.fourth-col.with-alpha(0.5);

            drop-shadow-color: #00000099;
            drop-shadow-blur: 50px;

            TouchArea { }

            HorizontalLayout {

                VerticalLayout {
                    width: 196px;
                    padding: 8px;
                    spacing: 2px;

                    SettingsTab {
                        tab-idx: 0;
                        tab-name: @tr("General");
                        icon-size: 14px;
                        icon: Icons.settings;
                    }

                    SettingsTab {
                        tab-idx: 1;
                        tab-name: @tr("Appearance");
                        icon-size: 14px;
                        icon: Icons.palette;
                    }

                    SettingsTab {
                        tab-idx: 2;
                        tab-name: @tr("Shortcuts");
                        icon-size: 14px;
                        icon: Icons.key;
                    }

                    SettingsTab {
                        tab-idx: 3;
                        tab-name: @tr("Explorer");
                        icon-size: 14px;
                        icon: Icons.directory;
                    }

                    SettingsTab {
                        tab-idx: 4;
                        tab-name: @tr("Zoxide");
                        icon-size: 14px;
                        icon: Icons.terminal;
                    }

                    SettingsTab {
                        tab-idx: 5;
                        tab-name: @tr("Gallery");
                        icon-size: 14px;
                        icon: Icons.pictures;
                    }
                }

                Rectangle {
                    width: 1px;
                    background: Theme.colors.fourth-col.with-alpha(0.5);
                }

                if SettingsBridge.active-tab == 0: General { }

                if SettingsBridge.active-tab == 1: Appearance { }

                if SettingsBridge.active-tab == 2: Shortcuts { }

                if SettingsBridge.active-tab == 3: Explorer { }

                if SettingsBridge.active-tab == 4: Zoxide { }

                if SettingsBridge.active-tab == 5: Gallery { }
            }
        }

        if SettingsBridge.font-modal: FontModal {
            on-close => {
                fs.focus();
                SettingsBridge.font-modal = false;
            }
        }

        if Keys.change-shortcut: ChangeShortcut {
            restore-focus => { fs.focus(); }
            on-close => {
                fs.focus();
                Keys.close-change();
            }
        }

        if SettingsBridge.icons-config: IconsEditor {
            on-close => {
                fs.focus();
                SettingsBridge.icons-config = false;
            }
        }
    }
}
