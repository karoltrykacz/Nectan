import {
    GeneralModal,
    PlainLineEdit,
    PrimaryButton,
} from "../../shared/elements.slint";
import { Theme } from "../../shared/theme.slint";
import { Icons } from "../../shared/icons.slint";

export global SetTerminalCommandBridge {
    in-out property <bool> open;
    callback save-cmd(string);
}

export component SetTerminalCommand inherits GeneralModal {

    on-close => { SetTerminalCommandBridge.open = false; }

    function save() {
        SetTerminalCommandBridge.save-cmd(in.input-text);
        debug("Saved ", in.input-text);
    }

    Rectangle {
        width: min(420px, parent.width * 0.8);
        height: min(200px, parent.height * 0.8);
        background: Theme.colors.primary-col;
        border-radius: 14px;
        border-width: 1px;
        border-color: Theme.colors.third-col;
        clip: true;

        VerticalLayout {
            padding-top: 16px;
            padding: 20px;

            Text {
                text: "Enter terminal command";
                color: Theme.colors.primary-font;
                font-size: 20px;
                font-weight: 600;
            }

            Text {
                text: "Executable name of your terminal";
                color: Theme.colors.third-font;
                font-size: 13px;
                font-weight: 500;
            }

            Rectangle { }

            Rectangle {
                height: 42px;
                border-radius: 24px;
                border-corner-shape: superellipse(Theme.config.edges-shape);
                // background: input.has-focus ? Theme.colors.fourth-col : Theme.colors.third-col;
                border-width: 1px;
                border-color: Theme.colors.fourth-col;

                in := PlainLineEdit {
                    edited(terminal_cmd) => {}
                    accepted => {
                        save()
                    }
                }
            }

            Rectangle { }

            HorizontalLayout {
                spacing: 12px;
                alignment: end;
                PrimaryButton {
                    alt: true;
                    text: @tr("Cancel");
                    clicked => { SetTerminalCommandBridge.open = false; }
                }

                PrimaryButton {
                    image: Icons.save;
                    text: @tr("Save");
                    clicked => { save(); SetTerminalCommandBridge.open = false; }
                }
            }
        }
    }
}
