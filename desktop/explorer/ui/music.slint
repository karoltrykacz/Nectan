import { Theme, ThemeAnimator } from "../../shared/theme.slint";
import {
    NectanAppFrame,
    Slider,
    IconButton,
    GlassPanel,
    GeneralModal,
} from "../../shared/elements.slint";
import { WindowBridge } from "../../shared/window.slint";
import { Icons } from "../../shared/icons.slint";
import { Properties, PropertiesBridge } from "../../shared/properties.slint";

component ArtworkInspector inherits GeneralModal {
    in property <image> artwork;

    init => { self.focus(); }

    Rectangle {
        property <length> side: max(64px, min(512px, min(root.width, root.height) - 160px));

        width: self.side;
        height: self.side;
        clip: true;
        corner-shape: CornerShape.squircle;
        drop-shadow-color: #00000099;
        drop-shadow-blur: 28px;
        background: #101010;
        border-radius: 24px;
        border-width: 1px;
        border-color: #fff3;

        TouchArea {
            clicked => {}
        }

        Rectangle {
            Image {
                source: root.artwork;
                width: 100%;
                height: 100%;
                image-fit: contain;
            }
        }
    }
}

component ShortcutsModal inherits GeneralModal {

    init => { self.focus(); }

    Rectangle {
        width: min(720px, parent.width - 40px);
        height: min(480px, parent.height - 40px);
        clip: true;
        corner-shape: CornerShape.squircle;
        drop-shadow-color: #00000099;
        drop-shadow-blur: 28px;
        background: #0003;
        backdrop-blur: 5px;
        border-radius: 24px;
        border-width: 1px;
        border-color: #fff3;

        TouchArea {
            clicked => {}
        }

        VerticalLayout {
            padding: 20px;
            Text {
                font-size: 1.5rem;
                font-weight: 600;
                text: @tr("Shortcuts");
                color: #f1f1f1;
            }
        }
    }
}

component ArtworkCard inherits Rectangle {
    in property <image> source;
    in property <length> size: min(200px, root.source.height * 1px);
    callback clicked();

    width: root.size;
    height: root.size;

    Rectangle {
        border-radius: 20px;
        corner-shape: CornerShape.squircle;
        background: #121212;
        clip: true;
        transform-scale: art-ta.pressed ? 0.9975 : 1.0;
        width: root.size;
        height: root.size;

        Image {
            width: root.size;
            height: root.size;
            image-fit: contain;
            source: root.source;
        }
    }

    art-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component TrackInfo inherits VerticalLayout {
    in property <string> track;
    in property <string> artist;
    in property <length> track-size: 32px;
    in property <length> artist-size: 14px;
    in property <TextHorizontalAlignment> h-align: left;

    spacing: 4px;
    alignment: end;

    Text {
        text: root.track;
        color: #fff;
        font-size: root.track-size;
        font-weight: 700;
        overflow: elide;
        horizontal-alignment: root.h-align;
    }

    Text {
        text: root.artist;
        color: #ffffffb3;
        font-size: root.artist-size;
        font-weight: 600;
        overflow: elide;
        horizontal-alignment: root.h-align;
    }
}

export component MusicPlayer inherits Window {
    title: "Nectan Music Player";
    preferred-width: 1080px;
    preferred-height: 720px;
    min-width: 128px;
    min-height: 64px;
    resize-border-width: 6px;
    no-frame: !Theme.config.native-topbar;
    background: transparent;
    maximized: WindowBridge.maximized;

    in-out property <image> texture;
    out property <int> requested-texture-width: preview.width / 1phx;
    out property <int> requested-texture-height: preview.height / 1phx;

    in property <image> artwork;
    in property <string> track-name: "Slint";
    in property <string> artist-name: "Unknown";
    in property <float> duration: 355;
    in-out property <float> progress: 0.5;
    in-out property <bool> playing: true;
    in-out property <bool> shuffle: false;
    in-out property <bool> repeat: false;
    in-out property <bool> shortcuts: false;
    in-out property <bool> properties: false;
    out property <bool> scrubbing: progress-slider.pressed;

    callback previous();
    callback next();
    callback seek(float);

    out property <bool> compact: root.height < 420px;
    out property <bool> portrait: !root.compact && root.height > root.width;
    out property <bool> wide: !root.compact && !root.portrait;

    property <length> pad: root.compact ? 16px : (root.portrait ? 28px : 64px);
    property <length> portrait-art-size: max(96px, min(root.width - 2 * root.pad, root.height * 0.38));

    property <int> hide-after-ticks: 6;
    property <int> idle-ticks: 0;
    property <bool> controls-visible: true;
    property <bool> show-controls: root.controls-visible || !root.playing || root.compact;
    property <length> controls-height: 56px;

    property <bool> artwork-inspect;

    function wake() {
        root.idle-ticks = 0;
        root.controls-visible = true;
    }

    changed playing => {
        root.wake();
    }

    Timer {
        interval: 500ms;
        running: root.playing && root.controls-visible;
        triggered => {
            root.idle-ticks += 1;
            if (root.idle-ticks >= root.hide-after-ticks) {
                root.controls-visible = false;
            }
        }
    }

    pure function format-time(t: float) -> string {
        let total = Math.floor(t);
        let m = Math.floor(total / 60);
        let s = Math.mod(total, 60);
        return "\{m}:\{s < 10 ? "0" : ""}\{s}";
    }

    ThemeAnimator { }

    NectanAppFrame {
        border-color: #fff3;
        background: #000;
        maximized: root.maximized || root.full-screen;

        fs := FocusScope {
            init => { self.focus(); }

            KeyBinding {
                keys: @keys(Space);
                activated => { root.playing = !root.playing; }
            }

            KeyBinding {
                keys: @keys(F11);
                activated => { root.full-screen = !root.full-screen; }
            }

            KeyBinding {
                keys: @keys(F);
                activated => { root.full-screen = !root.full-screen; }
            }

            KeyBinding {
                keys: @keys(S);
                activated => { root.shortcuts = !root.shortcuts; }
            }

            KeyBinding {
                keys: @keys(Escape);
                activated => { root.full-screen = false; root.maximized = false; }
            }

            KeyBinding {
                keys: @keys(K);
                activated => {}
            }

            KeyBinding {
                keys: @keys(J);
                activated => {}
            }

            KeyBinding {
                keys: @keys(UpArrow);
                activated => {}
            }

            KeyBinding {
                keys: @keys(DownArrow);
                activated => {}
            }

            KeyBinding {
                keys: @keys(RightArrow);
                activated => { root.next(); }
            }

            KeyBinding {
                keys: @keys(LeftArrow);
                activated => { root.previous(); }
            }

            KeyBinding {
                keys: @keys(L);
                activated => { root.next(); }
            }

            KeyBinding {
                keys: @keys(H);
                activated => { root.previous(); }
            }

            KeyBinding {
                keys: @keys(M);
                activated => {}
            }

            KeyBinding {
                keys: @keys(Digit0);
                activated => { root.seek(0.0); }
            }

            KeyBinding {
                keys: @keys(Digit1);
                activated => { root.seek(0.1); }
            }

            KeyBinding {
                keys: @keys(Digit2);
                activated => { root.seek(0.2); }
            }

            KeyBinding {
                keys: @keys(Digit3);
                activated => { root.seek(0.3); }
            }

            KeyBinding {
                keys: @keys(Digit4);
                activated => { root.seek(0.4); }
            }

            KeyBinding {
                keys: @keys(Digit5);
                activated => { root.seek(0.5); }
            }

            KeyBinding {
                keys: @keys(Digit6);
                activated => { root.seek(0.6); }
            }

            KeyBinding {
                keys: @keys(Digit7);
                activated => { root.seek(0.7); }
            }

            KeyBinding {
                keys: @keys(Digit8);
                activated => { root.seek(0.8); }
            }

            KeyBinding {
                keys: @keys(Digit9);
                activated => { root.seek(0.9); }
            }

            KeyBinding {
                keys: @keys(I);
                activated => { root.properties = true; }
            }

            key-pressed(e) => {
                root.wake();
                reject
            }

            preview := Rectangle {
                background: #000000;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.texture;
                    image-fit: fill;
                    Rectangle {
                        background: #0005;
                    }
                }
            }

            TouchArea {
                mouse-cursor: root.show-controls ? MouseCursor.default : MouseCursor.none;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.move || e.kind == PointerEventKind.down) {
                        root.wake();
                    }
                }
            }

            WindowMoveArea { }

            VerticalLayout {
                x: 0;
                y: 0;
                padding: root.pad;
                padding-bottom: 20px;
                alignment: root.wide ? end : center;

                if root.wide: HorizontalLayout {
                    if root.artwork.width != 0: ArtworkCard {
                        source: root.artwork;
                        size: 256px;
                        clicked => { root.artwork-inspect = true; }
                    }

                    if root.artwork.width != 0: Rectangle {
                        width: 32px;
                    }

                    TrackInfo {
                        track: root.track-name;
                        artist: root.artist-name;
                    }
                }

                if root.portrait: VerticalLayout {
                    spacing: 20px;

                    if root.artwork.width != 0: HorizontalLayout {
                        alignment: center;

                        ArtworkCard {
                            source: root.artwork;
                            size: root.portrait-art-size;
                            clicked => { root.artwork-inspect = true; }
                        }
                    }

                    TrackInfo {
                        track: root.track-name;
                        artist: root.artist-name;
                        track-size: 24px;
                        artist-size: 14px;
                        h-align: center;
                    }
                }

                if root.compact: TrackInfo {
                    track: root.track-name;
                    artist: root.artist-name;
                    track-size: 18px;
                    artist-size: 12px;
                    h-align: center;
                }

                Rectangle {
                    height: root.compact ? 8px : 16px;
                }

                VerticalLayout {
                    padding-left: root.compact ? 20px : 0;
                    padding-right: root.compact ? 20px : 0;

                    progress-slider := Slider {
                        track-color: #0003;
                        fill-color: #f1f1f1;
                        knob-color: #f1f1f1;
                        width: 100%;
                        minimum: 0;
                        maximum: 1;
                        value <=> root.progress;

                        released(v) => { root.seek(v); }
                    }

                    HorizontalLayout {
                        Text {
                            text: root.format-time(root.progress * root.duration);
                            color: #ffffffb3;
                            font-size: 12px;
                        }

                        Rectangle { }

                        Text {
                            text: root.format-time(root.duration);
                            color: #ffffffb3;
                            font-size: 12px;
                        }
                    }
                }

                Rectangle {
                    height: root.controls-height;
                    opacity: root.show-controls ? 1.0 : 0.0;
                    clip: true;
                    visible: self.height > 0.5px;

                    animate opacity {
                        duration: 500ms;
                        easing: Theme.easing;
                    }

                    HorizontalLayout {
                        alignment: center;
                        cross-axis-alignment: center;
                        spacing: root.compact ? 20px : 12px;

                        if !root.compact: IconButton {
                            inner-bg: transparent;
                            icon: Icons.shuffle;
                            colorize: root.shuffle ? #f1f1f1 : #888;
                            clicked => { root.shuffle = !root.shuffle; }
                        }

                        IconButton {
                            inner-bg: transparent;
                            icon: Icons.fast-forward;
                            rotation: 180deg;
                            colorize: #f1f1f1;
                            clicked => { root.previous(); }
                        }

                        IconButton {
                            inner-bg: transparent;
                            icon: root.playing ? Icons.pause : Icons.play;
                            colorize: #f1f1f1;
                            clicked => { root.playing = !root.playing; }
                        }

                        IconButton {
                            inner-bg: transparent;
                            icon: Icons.fast-forward;
                            colorize: #f1f1f1;
                            clicked => { root.next(); }
                        }

                        if !root.compact: IconButton {
                            inner-bg: transparent;
                            icon: Icons.repeat;
                            colorize: root.repeat ? #f1f1f1 : #888;
                            clicked => { root.repeat = !root.repeat; }
                        }

                        if !root.compact: IconButton {
                            inner-bg: transparent;
                            icon: root.full-screen ? Icons.exit-fullscreen : Icons.fullscreen;
                            colorize: #f1f1f1;
                            clicked => { root.full-screen = !root.full-screen; }
                        }
                    }
                }
            }

            if !Theme.config.native-topbar: Rectangle {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 48px;
                opacity: root.show-controls && !root.compact ? 1.0 : 0.0;
                visible: self.opacity > 0.01;

                animate opacity {
                    duration: 500ms;
                    easing: Theme.easing;
                }

                HorizontalLayout {
                    x: 0px;
                    y: 0px;
                    width: 100%;
                    height: 48px;
                    padding: 8px;
                    spacing: 4px;
                    alignment: end;

                    IconButton {
                        icon: Icons.key;
                        icon-size: 14px;
                        inner-bg: self.hovered ? #fff2 : transparent;
                        colorize: #c8c8c8;
                        clicked => { root.shortcuts = true; }
                    }

                    IconButton {
                        icon: Icons.minimize;
                        icon-size: 16px;
                        inner-bg: self.hovered ? #fff2 : transparent;
                        colorize: #f1f1f1;
                        clicked => { root.minimized = true; }
                    }

                    IconButton {
                        icon: Icons.maximize;
                        icon-size: 16px;
                        inner-bg: self.hovered ? #fff2 : transparent;
                        colorize: #f1f1f1;
                        clicked => {
                            root.maximized = !root.maximized;
                        }
                    }

                    IconButton {
                        icon: Icons.close;
                        icon-size: 16px;
                        inner-bg: self.hovered ? #fff2 : transparent;
                        colorize: #f1f1f1;
                        clicked => { root.close(); }
                    }
                }
            }
        }
    }

    if root.artwork-inspect: ArtworkInspector {
        artwork <=> root.artwork;
        on-close => { fs.focus(); root.artwork-inspect = false; }
    }

    if root.shortcuts: ShortcutsModal {
        on-close => { fs.focus(); root.shortcuts = false; }
    }

    if PropertiesBridge.open: Properties {
        restore-focus => { fs.focus(); }
    }
}
