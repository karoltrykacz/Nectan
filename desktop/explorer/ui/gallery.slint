component MainContentArea inherits HorizontalLayout {
    spacing: 8px;
    padding: 8px;
    padding-left: !GalleryBridge.sidebar-visible ? 8px : GalleryBridge.sidebar-width;
    padding-top: Theme.config.native-topbar ? 8px :
        Theme.config.topbar-always-on ? 24px :
        GalleryBridge.topbar-hover ? 24px : 8px;

    animate x, padding-left {
        duration: Theme.animation-speed;
        easing: Theme.easing;
    }

    animate padding-top {
        delay: 200ms;
        duration: Theme.animation-speed;
        easing: Theme.easing;
    }

    @children
}

    component DummyRow inherits HorizontalLayout {
    alignment: start;
    spacing: 12px;
    cross-axis-alignment: center;
    in property <int> amount: 4;

    for i in amount: Rectangle {
        background: Theme.colors.third-col;
        height: 128px;
        width: 128px;
        border-radius: 20px;
        corner-shape: CornerShape.squircle;
    }
}

    component SectionTitle inherits HorizontalLayout {
    alignment: start;
    cross-axis-alignment: center;

    in property <string> title;

    Text {
        text: title;
        font-size: 1.5rem;
        font-weight: 600;
        color: Theme.colors.primary-font;
    }

    Rectangle {
        width: 2px;
    }

    Image {
        source: Icons.chevron-right;
        width: 14px;
        height: 14px;
        colorize: Theme.colors.primary-font;
    }
}

    export component GalleryApp inherits Window {
    title: "Nectan gallery";
    preferred-width: GalleryBridge.window-width;
    preferred-height: GalleryBridge.window-height;
    min-width: 128px;
    min-height: 64px;
    resize-border-width: 6px;
    no-frame: !Theme.config.native-topbar;
    background: transparent;
    maximized: WindowBridge.maximized;
    default-font-size: Theme.font-size;
    full-screen <=> GalleryBridge.fullscreen;

    ThemeAnimator { }

    NectanAppFrame {
        maximized: root.maximized || root.full-screen;

        gallery-fs := GalleryFocusScope {

            Sidebar { }

            MainContentArea {
                Rectangle {
                    clip: true;
                    background: Theme.colors.secondary-col.with-alpha(Theme.config.transparency);
                    backdrop-blur: Theme.blur;
                    border-radius: 12px;
                    corner-shape: CornerShape.squircle;
                    height: 100%;

                    VerticalLayout {
                        padding: 20px;
                        height: 100%;
                        padding-top: 16px;
                        alignment: start;

                        SectionTitle {
                            title: @tr("Recent");
                        }

                        Rectangle {
                            height: 8px;
                        }

                        DummyRow { }

                        Rectangle {
                            height: 20px;
                        }

                        SectionTitle {
                            title: @tr("Albums");
                        }

                        Rectangle {
                            height: 8px;
                        }

                        DummyRow { }

                        Rectangle {
                            height: 20px;
                        }

                        SectionTitle {
                            title: @tr("People & Pets");
                        }

                        Rectangle {
                            height: 8px;
                        }

                        DummyRow { }

                        Rectangle {
                            height: 32px;
                            width: 32px;
                            background: red;
                        }

                        VerticalLayout {

                            ListView {
                                min-height: 1000px;
                                for img in GalleryBridge.images: Image {
                                    source: img.img;
                                    height: 100px;
                                    width: 100px;
                                }
                            }
                        }
                    }
                }
            }

            if GalleryBridge.settings-open: Settings { }

            // if GalleryBridge.loading: Rectangle {
            //     background: Theme.colors.primary-col;
            //     Spinner { }
            // }
        }
    }
}
