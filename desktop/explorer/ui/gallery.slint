    width: GalleryBridge.sidebar-width;
    border-radius: 8px;
    border-width: 1px;
    border-color: GalleryBridge.sidebar-visible ? transparent : Theme.colors.border-col;

    animate x, border-color {
        duration: Theme.animation-speed;
        easing: Theme.easing;
    }

    forward-focus: fs;

    fs := FocusScope {

        WindowMoveArea { }

        VerticalLayout {
            padding-top: 8px;
            padding: 8px;

