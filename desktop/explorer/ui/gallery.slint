            //                 text: @tr("Nectan Cloud");
            //                 icon: Icons.cloud;
            //                 clicked => {
            //                     CommandBridge.open = true;
            //                     menu-popup.close();
            //                 }
            //             }
            //
            //             MenuRow {
            //                 text: @tr("Nectan Server");
            //                 icon: Icons.server;
            //                 clicked => {
