            }

            SidebarFolder {
                title: @tr("Music");
                icon: Icons.heart;
            }

            Rectangle { }

            HorizontalLayout {
                spacing: 4px;
                IconButton {
                    icon: Icons.settings;
                    icon-size: 16px;

                    clicked => {
                        GalleryBridge.settings-open = true;
                    }
                }

                Rectangle { }

                IconButton {
                    icon: Icons.refresh;
                    icon-size: 16px;

                    clicked => {}
                }

