import { Theme } from "../../../shared/theme.slint";
import { HasherBridge } from "../../../shared/hasher.slint";
import {
    OpenWithBridge,
} from "../../../shared/open_with.slint";
import {
    GeneralModal,
    PlainLineEdit,
    PrimaryButton,
    Spinner,
    Breadcrumb,
    IconButton,
    SvgIcon,
    Switch,
    MenuRow,
    MenuSeparator,
    ToggleableIconButton,
} from "../../../shared/elements.slint";
import {
    ListView,
    ScrollView,
    VerticalBox,
    HorizontalBox,
} from "std-widgets.slint";
import {
    WindowBridge,
} from "../../../shared/window.slint";
import { Keys } from "../../../shared/keys_shared.slint";
import { ExplorerBridge, View, EntryType, DirEntry } from "bridge.slint";
import { CompressModal } from "compress.slint";
import { Icons } from "../../../shared/icons.slint";
import { FilterPanel } from "../filter.slint";

component ContextMenu inherits Rectangle {
    in property <DirEntry> entry;
    in property <int> entry-idx;

    callback action(string);

    property <length> menu-width: 256px;
    property <length> menu-height: 420px;

    property <length> pop-x: 0px;
    property <length> pop-y: 0px;

    public function open(mx: length, my: length, bound-w: length, bound-h: length) {
        root.pop-x = max(0px, min(mx, bound-w - root.menu-width));
        root.pop-y = max(0px, min(my, bound-h - root.menu-height));
        popup.show();
    }

    popup := PopupWindow {
        x: root.pop-x;
        y: root.pop-y;
        width: root.menu-width;
        height: root.menu-height;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Theme.colors.primary-col.with-alpha(0.5);
            backdrop-blur: 10px;
            border-radius: 20px;
            corner-shape: CornerShape.squircle;
            border-width: 1px;
            border-color: Theme.colors.border-col;
            drop-shadow-color: #00000099;
            drop-shadow-blur: 20px;
            clip: true;

            VerticalLayout {
                padding: 6px;

                MenuRow {
                    icon: Icons.link;
                    text: @tr("Open");
                    clicked => { root.action("open"); popup.close(); }
                }

                MenuRow {
                    text: @tr("Open with");
                    clicked => {
                        OpenWithBridge.open = true;
                        popup.close();
                    }
                }

                if entry.type == EntryType.symlink: MenuRow {
                    text: @tr("Open location");
                    icon: Icons.link;
                    clicked => { root.action("open"); popup.close(); }
                }

                MenuSeparator { }

                MenuRow {
                    text: @tr("Cut");
                    icon: Icons.cut;
                    clicked => { root.action("cut"); popup.close(); }
                }

                MenuRow {
                    text: @tr("Copy");
                    icon: Icons.copy;
                    clicked => { root.action("copy"); popup.close(); }
                }

                MenuRow {
                    text: @tr("Rename");
                    icon: Icons.edit;
                    clicked => { root.action("rename"); popup.close(); }
                }

                MenuRow {
                    text: @tr("Compress");
                    icon: Icons.cpu;
                    clicked => { root.action("compress"); popup.close(); }
                }

                MenuSeparator { }

                MenuRow {
                    icon: Icons.send;
                    text: @tr("Send with Nectan");
                }

                MenuRow {
                    text: @tr("Email");
                    icon: Icons.email;
                    clicked => { root.action("email"); popup.close(); }
                }

                MenuSeparator { }

                MenuRow {
                    text: @tr("Move to trash");
                    icon: Icons.trash;
                    clicked => { root.action("trash"); popup.close(); }
                }

                MenuRow {
                    text: @tr("Delete permanently");
                    icon: Icons.close;
                    clicked => { root.action("delete-permanently"); popup.close(); }
                }

                MenuSeparator { }

                MenuRow {
                    text: @tr("Properties");
                    icon: Icons.info;
                    clicked => { ExplorerBridge.properties(entry-idx); popup.close(); }
                }

                MenuRow {
                    text: @tr("Copy path");
                    icon: Icons.paperclip;
                    clicked => { root.action("copy-path"); popup.close(); }
                }

                if entry.type == EntryType.file: MenuRow {
                    text: @tr("Hash");
                    icon: Icons.hash;
                    clicked => {
                        HasherBridge.open-hasher();
                        popup.close();
                    }
                }
            }
        }
    }
}


component SearchHover inherits Rectangle {
    in property <bool> btn-hov;
    callback search();
    callback deep-search();
    callback ripgrep();

    property <length> pad: 4px;
    property <length> item-h: 28px;
    property <length> btn-size: 28px;

    property <int> hovered-idx: catcher.has-hover
        ? clamp(floor((catcher.mouse-y - root.pad) / root.item-h), -1, 2)
        : -1;

    visible: btn-hov || catcher.has-hover || bridge.has-hover;
    z: 2;
    y: 28px;
    x: -self.width + 28px;
    width: 128px;
    height: item-h * 3 + pad * 2;
    border-radius: 16px;
    corner-shape: CornerShape.squircle;
    background: Theme.colors.primary-col;
    backdrop-blur: 5px;
    border-width: 1px;
    border-color: Theme.colors.third-col;

    VerticalLayout {
        padding: root.pad;
        alignment: start;

        for label[i] in [@tr("Search"), @tr("Deep search"), @tr("Ripgrep")]: Rectangle {
            height: root.item-h;
            border-radius: 12px;
            corner-shape: CornerShape.squircle;
            background: root.hovered-idx == i ? Theme.colors.third-col : transparent;
            Text {
                text: label;
                font-size: 0.85rem;
            }
        }
    }

    bridge := TouchArea {
        x: root.width - root.btn-size * 4;
        y: -root.btn-size;
        width: root.btn-size * 3;
        height: root.btn-size;

        // Rectangle {
        //     background: red;
        //     opacity: 0.4;
        // }
    }

    catcher := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if root.hovered-idx == 0 {
                ExplorerBridge.searching = !ExplorerBridge.searching;
            }
            else if root.hovered-idx == 1 {
                ExplorerBridge.scan-recursive();
                ExplorerBridge.searching-recursive = true;
            }
            else if root.hovered-idx == 2 {
                ExplorerBridge.ripgrepping = true;
            }
        }
    }
}


component TopBar inherits HorizontalLayout {
    padding: 12px;
    padding-left: 4px;
    padding-right: 12px;
    cross-axis-alignment: center;
    z: 0;

    IconButton {
        icon: Icons.chevron-left;

        clicked => {
            ExplorerBridge.back();
            EventResult.accept
        }
    }

    Rectangle {
        width: 2px;
    }

    IconButton {
        icon: Icons.chevron-right;

        clicked => {
            ExplorerBridge.forward();
        }
    }

    Rectangle {
        width: 2px;
    }

    IconButton {

        SvgIcon {
            source: Icons.chevron-right;
            transform-rotation: -90deg;
            fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.third-font;
            size: 18px;
        }

        clicked => {
            ExplorerBridge.up();
        }
    }

    Rectangle {
        width: 12px;
    }

    Breadcrumb {
        components: ExplorerBridge.current-dir;
        clicked(idx) => { ExplorerBridge.navigate-to-in-current(idx); }
    }

    Rectangle { }

    s-btn := IconButton {
        z: 1;
        icon: Icons.search;
        icon-size: 16px;

        SearchHover {
            z: 4;
            btn-hov: s-btn.hovered;
        }

        clicked => { ExplorerBridge.searching = !ExplorerBridge.searching; }
    }

    Rectangle {
        width: 8px;
    }

    f-btn := ToggleableIconButton {
        icon: Icons.filter;
        icon-size: 16px;
        toggled: ExplorerBridge.filtering;

        clicked => {
            ExplorerBridge.filtering = !ExplorerBridge.filtering;
        }
    }

    Rectangle {
        width: 8px;
    }

    IconButton {
        icon: Icons.terminal;
        icon-size: 16px;

        clicked => { ExplorerBridge.terminal(); }
    }

    Rectangle {
        width: 8px;
    }

    IconButton {
        icon: ExplorerBridge.view == View.list ? Icons.list : ExplorerBridge.view == View.grid ? Icons.grid : Icons.pictures;
        icon-size: 16px;

        SearchHover {
            z: 4;
            btn-hov: s-btn.hovered;
        }

        clicked => {
            ExplorerBridge.toggle-view-mode();
        }
    }

    Rectangle {
        width: 8px;
    }

    IconButton {
        width: 28px;
        height: 28px;
        inner-bg: self.hovered ? Theme.colors.third-col : transparent;

        SvgIcon {
            source: ExplorerBridge.split ? Icons.close : Icons.columns;
            fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.third-font;
            size: 16px;
        }

        clicked => { ExplorerBridge.split = !ExplorerBridge.split; }
    }
}



export component RecursiveSearch inherits GeneralModal {

    property <string> query;

    in-out property <float> split-ratio: 0.575;

    property <length> min-pane-width: 200px;
    property <length> handle-width: 20px;

    property <length> available: max(0px, row.width - 160px - handle-width);
    property <length> content-w: available;
    property <length> left-w: content-w * split-ratio;
    property <length> right-w: content-w * (1 - split-ratio);
    property <length> panel-h: row.height - 80px;

    property <float> min-ratio: min(0.5, min-pane-width / max(content-w, 1px));
    property <float> max-ratio: 1 - min-ratio;

    // init => { self.focus(); }

    on-close => {
        close();
    }

    on-enter => {
        close();
    }

    function close() {
        ExplorerBridge.searching-recursive = false;
        ExplorerBridge.abort-recursive();
        ExplorerBridge.focus();
    }

    row := HorizontalLayout {
        alignment: center;
        cross-axis-alignment: center;

        Rectangle {
            height: root.panel-h;
            width: root.left-w;
            drop-shadow-color: #00000099;
            drop-shadow-blur: 28px;
            background: Theme.colors.primary-col;
            border-radius: 20px;
            corner-shape: CornerShape.squircle;
            border-width: 1px;
            border-color: Theme.colors.border-col;
            clip: true;

            TouchArea {
                clicked => {}
            }

            VerticalLayout {

                HorizontalLayout {
                    padding: 20px;
                    padding-top: 16px;
                    padding-bottom: 12px;

                    Text {
                        text: @tr("Searching in {}", ExplorerBridge.searching-recursive-in-n);
                        font-size: 16px;
                        color: Theme.colors.primary-font;
                        font-weight: 500;
                        overflow: elide;
                    }

                    if ExplorerBridge.recursive-scanning: Spinner { }
                }

                VerticalLayout {
                    padding-left: 20px;

                    ListView {
                        for entry[i] in ExplorerBridge.search-entries: Rectangle {
                            height: 20px;
                            background: ta.has-hover ? Theme.colors.third-col : transparent;
                            border-radius: 12px;
                            corner-shape: CornerShape.squircle;
                            ta := TouchArea { }

                            HorizontalLayout {
                                alignment: start;
                                padding-left: 8px;

                                Text {
                                    text: entry.name;
                                    vertical-alignment: center;
                                    font-size: 0.9rem;
                                }
                            }
                        }
                    }
                }

                VerticalLayout {
                    padding: 12px;

                    Rectangle {
                        border-radius: 20px;
                        corner-shape: CornerShape.squircle;
                        background: Theme.colors.third-col;
                        height: 32px;

                        le := PlainLineEdit {
                            input-text <=> query;
                            edited(needel) => {
                                ExplorerBridge.search-recursive(needel);
                            }
                            accepted => { close(); }
                            rejected => { close(); }
                        }
                    }
                }
            }
        }

        Rectangle {
            width: root.handle-width;
            height: root.panel-h;

            Rectangle {
                width: 2px;
                height: 20px;
                border-radius: 2px;
                background: handle-area.pressed ? Theme.colors.primary-font
                    : handle-area.has-hover ? Theme.colors.primary-font.with-alpha(0.6)
                    : Theme.colors.border-col;
                animate background { duration: 120ms; }
            }

            handle-area := TouchArea {
                mouse-cursor: MouseCursor.col-resize;

                property <length> start-x;

                pointer-event(event) => {
                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                        self.start-x = self.mouse-x;
                    }
                }

                moved => {
                    if (self.pressed) {
                        root.split-ratio = max(root.min-ratio, min(root.max-ratio,
                            root.split-ratio + (self.mouse-x - self.start-x) / max(root.content-w, 1px)));
                    }
                }

                double-clicked => {
                    root.split-ratio = 0.55;
                }
            }
        }

        Rectangle {
            height: root.panel-h;
            width: root.right-w;
            drop-shadow-color: #00000099;
            drop-shadow-blur: 28px;
            background: Theme.colors.primary-col;
            border-radius: 20px;
            corner-shape: CornerShape.squircle;
            border-width: 1px;
            border-color: Theme.colors.border-col;
            clip: true;
        }
    }
}

component RenameModal inherits GeneralModal {
    in property <int> selection-end;
    in-out property <string> new-name;

    callback save();

    on-enter => { root.save(); }

    Rectangle {

        height: min(196px, parent.height - 80px);
        width: min(512px, parent.width - 80px);
        drop-shadow-color: #00000099;
        drop-shadow-blur: 28px;
        background: Theme.colors.primary-col;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.colors.border-col;
        clip: true;

        TouchArea {
            clicked => {}
        }

        VerticalLayout {
            padding: 20px;
            padding-top: 14px;

            Text {
                text: @tr("Rename");
                font-size: 20px;
                color: Theme.colors.primary-font;
                font-weight: 600;
            }

            Rectangle { }

            Rectangle {

                border-radius: 8px;
                background: Theme.colors.third-col;
                corner-shape: CornerShape.squircle;

                le := PlainLineEdit {
                    input-text <=> new-name;
                    end: root.selection-end;

                    rejected => {
                        root.on-close();
                    }

                    accepted => {
                        root.save();
                    }
                }
            }

            Rectangle { }

            HorizontalLayout {
                alignment: end;
                PrimaryButton {
                    text: @tr("Cancel");
                    alt: true;
                    clicked => {
                        root.on-close();
                    }
                }

                Rectangle {
                    width: 12px;
                }

                PrimaryButton {
                    text: @tr("Save");
                    image: Icons.save;
                    clicked => { save(); }
                }
            }
        }
    }
}


export component Explorer inherits Rectangle {
    width: ExplorerBridge.split ? 50% : 100%;
    background: Theme.colors.secondary-col.with-alpha(Theme.config.transparency);
    backdrop-blur: Theme.blur;
    border-radius: 12px;
    corner-shape: CornerShape.squircle;

    property <bool> renaming;
    property <string> new-name;

    property <int> focus-tick <=> ExplorerBridge.focus-tick;
    changed focus-tick => { main-fs.focus(); }

    property <bool> any-modal <=> WindowBridge.any-modal-open;
    changed any-modal => {
        debug("changed");
        if !any-modal {
            main-fs.focus();
        }
    }

    property <int> cursor;
    // -2 = nothing hovered (not -1: list rows compare against i - 1)
    property <int> cursor-hover: -2;

    property <Point> drag;

    property <bool> cursor-pressed;
    property <bool> selecting;
    property <bool> did-select;

    // Sel rectangle
    property <length> sel-x0;
    property <length> sel-y0;
    property <length> sel-x1;
    property <length> sel-y1;

    // Visual-mode and rubber-band anchor 
    property <int> anchor: -1;
    // Anchor for shift+click ranges
    property <int> click-anchor: -1;

    property <length> target-y: 0px;
    property <bool> pending-g;

    property <bool> control-pressed;
    property <bool> drag-additive;

    property <length> scrollbar-w: 12px;
    property <length> view-w: max(0px, main-fs.width - root.scrollbar-w);

    property <length> photos-gap: 8px;
    property <int> photos-columns: max(1, floor((root.view-w - root.photos-gap) / (ExplorerBridge.grid-size + root.photos-gap)));
    property <length> photos-cell: (root.view-w - root.photos-gap * (root.photos-columns + 1)) / root.photos-columns;

    property <int> grid-columns: max(1, floor(root.view-w / ExplorerBridge.grid-size));
    property <length> grid-cell: root.view-w / root.grid-columns - 0.01px;

    property <int> view-columns: ExplorerBridge.view == View.photos ? root.photos-columns
        : ExplorerBridge.view == View.grid ? root.grid-columns : 1;

    property <length> alt-scroll-y;
    property <length> scroll-y: ExplorerBridge.view == View.list ? list.content-y : root.alt-scroll-y;
    property <View> cur-view: ExplorerBridge.view;
    changed cur-view => { root.alt-scroll-y = 0px; }

    pure function col-at(x: length) -> int {
        if ExplorerBridge.view == View.photos {
            return clamp(floor((x - root.photos-gap / 2) / (root.photos-cell + root.photos-gap)), 0, root.photos-columns - 1);
        }
        if ExplorerBridge.view == View.grid {
            return clamp(floor(x / root.grid-cell), 0, root.grid-columns - 1);
        }
        return 0;
    }

    pure function row-at(y: length) -> int {
        if ExplorerBridge.view == View.photos {
            return max(0, floor((y - root.photos-gap / 2) / (root.photos-cell + root.photos-gap)));
        }
        if ExplorerBridge.view == View.grid {
            return max(0, floor(y / root.grid-cell));
        }
        return max(0, floor(y / ExplorerBridge.list-height));
    }

    // Item index under a point (content coordinates), -1 if none.
    pure function hit(x: length, y: length) -> int {
        let r = root.row-at(y);
        let c = root.col-at(x);
        let idx = r * root.view-columns + c;
        if idx >= ExplorerBridge.entries.length {
            return -1;
        }
        if ExplorerBridge.view == View.photos {
            let lx = x - (root.photos-gap + c * (root.photos-cell + root.photos-gap));
            let ly = y - (root.photos-gap + r * (root.photos-cell + root.photos-gap));
            if lx < 0px || lx > root.photos-cell || ly < 0px || ly > root.photos-cell {
                return -1;
            }
        }
        return idx;
    }

    pure function is-selected(idx: int) -> bool {
        ExplorerBridge.entries[idx].selected
    }

    function select-cursor() {
        ExplorerBridge.select(root.anchor, root.cursor);
    }

    function press(idx: int, ctrl: bool, shift: bool) {
        if idx < 0 || idx >= ExplorerBridge.entries.length {
            if !ctrl {
                ExplorerBridge.clear-selection();
                root.anchor = -1;
            }
        } else {
            if ctrl {
                ExplorerBridge.toggle-select(idx);
                root.click-anchor = idx;
            } else if shift {
                ExplorerBridge.select(root.click-anchor, idx);
            } else {
                ExplorerBridge.select(-1, idx);
                root.click-anchor = idx;
            }
            root.cursor = idx;
            root.anchor = -1;
        }
    }

    function drag-update() {
        let x0 = Math.min(root.sel-x0, root.sel-x1);
        let x1 = Math.max(root.sel-x0, root.sel-x1);
        let y0 = Math.min(root.sel-y0, root.sel-y1);
        let y1 = Math.max(root.sel-y0, root.sel-y1);

        ExplorerBridge.drag-select(
            root.row-at(y0), root.row-at(y1),
            root.col-at(x0), root.col-at(x1),
            root.view-columns);

        root.cursor = Math.min(
            root.row-at(root.sel-y1) * root.view-columns + root.col-at(root.sel-x1),
            ExplorerBridge.entries.length - 1);
    }

    function move-cursor(delta: int) {
        let max-index = ExplorerBridge.entries.length - 1;
        root.cursor = Math.min(Math.max(root.cursor + delta, 0), max-index);
        select-cursor();
        ensure-item-visible();
    }

    function move-end() {
        let max-index = ExplorerBridge.entries.length - 1;
        root.cursor = max-index;
        select-cursor();
        ensure-item-visible();
    }

    function move-start() {
        root.cursor = 0;
        select-cursor();
        ensure-item-visible();
    }

    function ensure-item-visible() {
        let h = ExplorerBridge.list-height;
        let top = root.cursor * h;
        let bottom = top + h;

        if (top + root.target-y < 0px) {
            root.target-y = -top;
        } else if (bottom + root.target-y > list.height) {
            root.target-y = list.height - bottom;
        }
        list.content-y = root.target-y;
    }

    pure function visible-rows() -> int {
        (list.content-height / ExplorerBridge.list-height)
    }

    function open-at(i: int) {
        if (i >= 0 && i < ExplorerBridge.entries.length) {
            ExplorerBridge.open(ExplorerBridge.entries[i], i);
            root.cursor = 0;
        }
        clear();
    }

    function wheel(dy: length) -> EventResult {
        if root.control-pressed {
            if dy > 0 { ExplorerBridge.zoom-in(); }
            else if dy < 0 { ExplorerBridge.zoom-out(); }
            return EventResult.accept; // don't scroll while zooming
        }
        return EventResult.reject;
    }

    function rename() {
        root.new-name = ExplorerBridge.entries[root.cursor].name;
        root.renaming = true;
    }

    function clear() {
        root.anchor = -1;
        reset-cursor();
        ExplorerBridge.clear-selection();
        ExplorerBridge.clear-search();
        ExplorerBridge.searching = false;
    }

    function delete-permanently() {
        ExplorerBridge.delete-items();
        clear();
    }

    function trash() {
        ExplorerBridge.trash-items();
        clear();
    }

    function copy() {
        ExplorerBridge.copy();
        clear();
    }

    function paste() {
        ExplorerBridge.paste();
        clear();
    }

    function reset-cursor() {
        root.selecting = false;
        root.anchor = -1;
        if (root.cursor != -1) {
            root.cursor = 0;
        }
    }

    z: 0;
    clip: true;

    VerticalLayout {

        padding-left: 8px;
        padding-right: 0px;
        padding-bottom: 8px;

        TopBar {
            z: 1;
        }

        if ExplorerBridge.filtering: HorizontalLayout {
            padding-left: 0px;
            padding-right: 12px;
            padding-bottom: 8px;
            height: ExplorerBridge.filtering ? 256px : 0;
            animate height { duration: 500ms; }

            FilterPanel { }
        }

        if ExplorerBridge.searching: Rectangle {
            height: 32px;
            background: Theme.colors.primary-col;
            border-radius: 12px;
            corner-shape: CornerShape.squircle;

            SvgIcon {
                x: 8px;
                source: Icons.search;
                fg: Theme.colors.secondary-font;
                size: 16px;
            }

            PlainLineEdit {
                x: 20px;
                rejected => {
                    main-fs.focus();
                    ExplorerBridge.searching = false;
                    reset-cursor();
                    ExplorerBridge.clear-search();
                }
                edited(query) => {
                    reset-cursor();
                    ExplorerBridge.search-current(query);
                }
                accepted => {
                    reset-cursor();
                    main-fs.focus();
                }
            }
        }
        Rectangle {
            height: ExplorerBridge.searching ? 8px : 0px;
        }

        main-fs := FocusScope {

            init => { self.focus(); }

            KeyBinding {
                keys: Keys.map.delete-permanently.keys;
                activated => { delete-permanently(); }
            }

            KeyBinding {
                keys: @keys(Space);
                activated => {
                }
            }

            KeyBinding {
                keys: @keys(Control + A);
                activated => { ExplorerBridge.select-all(); }
            }

            KeyBinding {
                keys: Keys.map.delete-permanently.alt-keys;
                activated => { delete-permanently(); }
            }

            KeyBinding {
                keys: Keys.map.trash.keys;
                activated => { trash(); }
            }

            KeyBinding {
                keys: Keys.map.trash.alt-keys;
                activated => { trash(); }
            }

            KeyBinding {
                keys: @keys(Shift + V);
                activated => { anchor = root.cursor; }
            }

            KeyBinding {
                keys: @keys(V);
                activated => { anchor = root.cursor; }
            }

            KeyBinding {
                keys: Keys.map.close.keys;
                activated => {
                    clear();
                }
            }

            KeyBinding {
                keys: Keys.map.close.alt-keys;
                activated => {
                    clear();
                }
            }

            KeyBinding {
                keys: Keys.map.history-back.keys;
                activated => {
                    clear();
                    ExplorerBridge.back();
                }
            }

            KeyBinding {
                keys: Keys.map.history-back.alt-keys;
                activated => {
                    clear();
                    ExplorerBridge.back();
                }
            }

            KeyBinding {
                keys: Keys.map.history-forward.keys;
                activated => {
                    clear();
                    ExplorerBridge.forward();
                }
            }

            KeyBinding {
                keys: Keys.map.history-forward.alt-keys;
                activated => {
                    clear();
                    ExplorerBridge.forward();
                }
            }

            KeyBinding {
                keys: Keys.map.half-page-down.keys;
                activated => {
                    move-cursor(visible-rows() / 2);
                }
            }

            KeyBinding {
                keys: Keys.map.half-page-down.alt-keys;
                activated => {
                    move-cursor(visible-rows() / 2);
                }
            }

            KeyBinding {
                keys: Keys.map.half-page-up.keys;
                activated => {
                    move-cursor(-(visible-rows() / 2));
                }
            }

            KeyBinding {
                keys: Keys.map.half-page-up.alt-keys;
                activated => {
                    move-cursor(-(visible-rows() / 2));
                }
            }

            KeyBinding {
                keys: Keys.map.refresh.keys;
                activated => {
                    clear();
                    ExplorerBridge.refresh();
                }
            }

            KeyBinding {
                keys: Keys.map.refresh.alt-keys;
                activated => {
                    clear();
                    ExplorerBridge.refresh();
                }
            }

            KeyBinding {
                keys: Keys.map.rename.keys;
                activated => { rename(); }
            }

            KeyBinding {
                keys: Keys.map.rename.alt-keys;
                activated => { rename(); }
            }

            KeyBinding {
                keys: Keys.map.move-down.keys;
                activated => {
                    move-cursor(1);
                }
            }

            KeyBinding {
                keys: Keys.map.move-down.alt-keys;
                activated => {
                    move-cursor(1);
                }
            }

            KeyBinding {
                keys: Keys.map.move-up.keys;
                activated => {
                    move-cursor(-1);
                }
            }

            KeyBinding {
                keys: Keys.map.move-up.alt-keys;
                activated => {
                    move-cursor(-1);
                }
            }

            KeyBinding {
                keys: Keys.map.go-inside.keys;
                activated => {
                    root.open-at(root.cursor);
                    clear();
                }
            }

            KeyBinding {
                keys: Keys.map.go-inside.alt-keys;
                activated => {
                    root.open-at(root.cursor);
                    clear();
                }
            }

            KeyBinding {
                keys: Keys.map.go-parent.keys;
                activated => {
                    ExplorerBridge.up();
                    clear();
                }
            }

            KeyBinding {
                keys: Keys.map.go-parent.alt-keys;
                activated => {
                    ExplorerBridge.up();
                    clear();
                }
            }

            KeyBinding {
                keys: Keys.map.search-in-current.keys;
                activated => {
                    ExplorerBridge.searching = !ExplorerBridge.searching;
                }
            }

            KeyBinding {
                keys: Keys.map.search-in-current.alt-keys;
                activated => {
                    ExplorerBridge.searching = !ExplorerBridge.searching;
                }
            }

            KeyBinding {
                keys: Keys.map.search-recursively.keys;
                activated => {
                    ExplorerBridge.searching-recursive = true;
                    ExplorerBridge.scan-recursive();
                }
            }

            KeyBinding {
                keys: Keys.map.search-recursively.alt-keys;
                activated => {
                    ExplorerBridge.searching-recursive = true;
                    ExplorerBridge.scan-recursive();
                }
            }

            KeyBinding {
                keys: Keys.map.ripgrep.keys;
                activated => {
                    ExplorerBridge.ripgrepping = true;
                }
            }

            KeyBinding {
                keys: Keys.map.ripgrep.alt-keys;
                activated => {
                    ExplorerBridge.ripgrepping = true;
                }
            }

            KeyBinding {
                keys: Keys.map.confirm.keys;
                activated => {
                    root.open-at(root.cursor);
                    clear();
                }
            }

            KeyBinding {
                keys: Keys.map.confirm.alt-keys;
                activated => {
                    root.open-at(root.cursor);
                    clear();
                }
            }

            KeyBinding {
                keys: Keys.map.zoom-in.keys;
                activated => { ExplorerBridge.zoom-in(); }
            }

            KeyBinding {
                keys: Keys.map.zoom-in.alt-keys;
                activated => { ExplorerBridge.zoom-in(); }
            }

            KeyBinding {
                keys: Keys.map.zoom-out.keys;
                activated => { ExplorerBridge.zoom-out(); }
            }

            KeyBinding {
                keys: @keys(Equals);
                activated => { ExplorerBridge.zoom-in(); }
            }

            KeyBinding {
                keys: @keys(HyphenMinus);
                activated => { ExplorerBridge.zoom-out(); }
            }

            KeyBinding {
                keys: Keys.map.zoom-out.alt-keys;
                activated => { ExplorerBridge.zoom-out(); }
            }

            KeyBinding {
                keys: Keys.map.copy.keys;
                activated => { copy(); }
            }

            KeyBinding {
                keys: Keys.map.copy.alt-keys;
                activated => { copy(); }
            }

            KeyBinding {
                keys: Keys.map.cut.keys;
                activated => {
                    debug("Cut");
                    clear();
                }
            }

            KeyBinding {
                keys: Keys.map.cut.alt-keys;
                activated => {
                    debug("Cut");
                    clear();
                }
            }

            KeyBinding {
                keys: @keys(T);
                activated => {
                    ExplorerBridge.terminal();
                }
            }

            KeyBinding {
                keys: Keys.map.paste.keys;
                activated => {
                    debug("Pasted");
                    clear();
                    ExplorerBridge.paste();
                }
            }

            KeyBinding {
                keys: Keys.map.paste.alt-keys;
                activated => {
                    debug("Pasted");
                    clear();
                    ExplorerBridge.paste();
                }
            }

            KeyBinding {
                keys: Keys.map.undo.keys;
                activated => {
                    debug("Undo");
                    clear();
                    // ExplorerBridge.undo(); // or fucking window brdige???
                }
            }

            KeyBinding {
                keys: Keys.map.undo.alt-keys;
                activated => {
                    debug("Undo");
                    clear();
                    // ExplorerBridge.paste();
                }
            }

            KeyBinding {
                keys: Keys.map.redo.keys;
                activated => {
                    debug("Redo");
                    // ExplorerBridge.undo(); // or fucking window brdige???
                }
            }

            KeyBinding {
                keys: Keys.map.redo.alt-keys;
                activated => {
                    debug("Redo");
                    // ExplorerBridge.paste();
                }
            }

            KeyBinding {
                keys: Keys.map.compress.keys;
                activated => {
                    ExplorerBridge.compressing = true;
                }
            }

            KeyBinding {
                keys: Keys.map.compress.alt-keys;
                activated => {
                    ExplorerBridge.compressing = true;
                }
            }

            KeyBinding {
                keys: @keys(M);
                activated => {
                    ExplorerBridge.toggle-view-mode();
                }
            }

            key-released(event) => {
                root.control-pressed = event.modifiers.control;
                EventResult.reject
            }

            key-pressed(event) => {
                root.control-pressed = event.modifiers.control;
                let was-pending-g = root.pending-g;
                root.pending-g = false;
                if event.text == Key.G {
                    if was-pending-g {
                        move-start();
                    } else {
                        root.pending-g = true;
                    }
                    return EventResult.accept;
                }
                if event.text == "G" {
                    move-end();
                    return EventResult.accept;
                }
                EventResult.reject
            }

            if ExplorerBridge.view == View.photos: ListView {
                changed content-y => { root.alt-scroll-y = self.content-y; }

                for i in ceil(ExplorerBridge.entries.length / root.photos-columns): HorizontalLayout {
                    padding-top: root.photos-gap;
                    padding-left: root.photos-gap;
                    padding-right: root.photos-gap;
                    spacing: root.photos-gap;
                    alignment: start;

                    for j in root.photos-columns: Rectangle {
                        property <int> idx: j + root.photos-columns * i;

                        visible: idx < ExplorerBridge.entries.length;
                        width: root.photos-cell;
                        height: root.photos-cell;
                        background: root.is-selected(idx) ? Theme.colors.fourth-col
                            : root.cursor-hover == idx ? Theme.colors.third-col : transparent;
                        border-radius: 12px;
                        corner-shape: CornerShape.squircle;

                        Image {
                            source: ExplorerBridge.entries[idx].preview;
                            width: parent.width;
                            height: parent.height;
                            image-fit: cover;
                        }
                    }
                }
            }

            if ExplorerBridge.view == View.grid: ScrollView {
                content-width: root.view-w;
                content-height: flex.preferred-height;
                changed content-y => { root.alt-scroll-y = self.content-y; }

                flex := FlexboxLayout {
                    width: root.view-w;
                    spacing: 0px;

                    for entry[i] in ExplorerBridge.entries: Rectangle {
                        width: root.grid-cell;
                        height: root.grid-cell;

                        Rectangle {
                            x: 1px;
                            y: 1px;
                            width: parent.width - 2px;
                            height: parent.height - 2px;
                            background: entry.selected ? Theme.colors.fourth-col
                                : root.cursor-hover == i ? Theme.colors.third-col : transparent;
                            border-radius: 12px;
                            // border-corner-shape: superellipse(Theme.config.edges-shape);

                            VerticalLayout {
                                padding-top: 12px;
                                width: parent.width;
                                height: parent.height;
                                cross-axis-alignment: center;

                                Image {
                                    source: entry.preview;
                                    image-fit: contain;
                                }

                                Rectangle {
                                    height: 2.2rem;
                                    clip: true;

                                    Text {
                                        text: entry.name;
                                        width: parent.width;
                                        horizontal-alignment: center;
                                        font-size: 0.9rem;
                                        color: Theme.colors.primary-font;
                                        font-weight: 500;
                                        wrap: char-wrap;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            list := ListView {
                visible: ExplorerBridge.view == View.list;

                property <[DirEntry]> entries: ExplorerBridge.entries;

                for entry[i] in entries: Rectangle {
                    width: parent.width - 12px;
                    height: ExplorerBridge.list-height;
                    background: is-selected(i) ? (mod(i,2) == 0 ? Theme.colors.fourth-col : Theme.colors.fourth-col.with-alpha(0.75)) :
                        cursor-hover == i ? Theme.colors.third-col : transparent;
                    border-radius: 12px;

                    border-top-left-radius: is-selected(i - 1) || root.cursor-hover == i - 1 ? 0px : 12px;
                    border-top-right-radius: is-selected(i - 1) || root.cursor-hover == i - 1 ? 0px : 12px;

                    border-bottom-left-radius: is-selected(i + 1) || root.cursor-hover == i + 1 ? 0px : 12px;
                    border-bottom-right-radius: is-selected(i + 1) || root.cursor-hover == i + 1 ? 0px : 12px;

                    corner-shape: CornerShape.squircle;
                    transform-scale-y: (root.cursor-pressed && root.cursor-hover == i && !root.selecting) ? 0.99 : 1.0;
                    transform-scale-x: (root.cursor-pressed && root.cursor-hover == i && !root.selecting) ? 0.998 : 1.0;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        cross-axis-alignment: center;
                        spacing: 12px;

                        Rectangle {
                            border-radius: 8px;
                            corner-shape: CornerShape.squircle;
                            // width: img.width;
                            // height: img.height;
                            clip: true;

                            // img := Image {
                            //     source: entry.preview;
                            //     width: ExplorerBridge.list-height - 12px;
                            //     height: ExplorerBridge.list-height - 12px;
                            //     image-fit: contain;
                            // }
                        }

                        Text {
                            text: entry.name;
                            font-size: 0.9rem;
                            color: Theme.colors.primary-font;
                            font-weight: 500;
                        }

                        Rectangle { }

                        if entry.type == EntryType.file: Text {
                            text: entry.size;
                            font-size: 0.75rem;
                            color: Theme.colors.third-font;
                            font-weight: 400;
                        }
                    }
                }
            }

            // One overlay for list / photos / grid. Hit-testing is done with
            // geometry (hit()), so click, ctrl/shift-click and rubber band
            // behave identically in every view.
            ov := TouchArea {
                x: 0px;
                width: root.view-w;
                height: parent.height;
                mouse-cursor: self.has-hover && root.cursor-hover >= 0 ? MouseCursor.pointer : MouseCursor.default;

                changed has-hover => {
                    if !self.has-hover { root.cursor-hover = -2; }
                }

                scroll-event(event) => { root.wheel(event.delta-y) }

                pointer-event(event) => {
                    // pointer clamped to the overlay, then converted to content coordinates
                    let lx = Math.min(Math.max(self.mouse-x, 0px), self.width);
                    let ly = Math.min(Math.max(self.mouse-y, 0px), self.height);
                    let cy = ly - root.scroll-y;
                    let at = root.hit(self.mouse-x, self.mouse-y - root.scroll-y);

                    if event.kind == PointerEventKind.move {
                        root.cursor-hover = at >= 0 ? at : -2;

                        if self.pressed {
                            root.sel-x1 = lx;
                            root.sel-y1 = cy;

                            if !root.selecting
                                && (Math.abs((root.sel-x1 - root.sel-x0) / 1px) > 4
                                || Math.abs((root.sel-y1 - root.sel-y0) / 1px) > 4) {
                                root.selecting = true;
                                root.did-select = true;
                                ExplorerBridge.begin-drag(root.drag-additive);
                            }
                            if root.selecting {
                                root.drag-update();
                            }
                        }
                    }
                    if event.kind == PointerEventKind.cancel {
                        root.selecting = false;
                        root.cursor-pressed = false;
                    }
                    if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                        if at >= 0 {
                            // keep a multi-selection if the click lands inside it
                            if !root.is-selected(at) { root.press(at, false, false); }
                            else { root.cursor = at; }
                            ctx.open(self.mouse-x, self.mouse-y, self.width, self.height);
                        }
                    }
                    if event.button == PointerEventButton.left {
                        if event.kind == PointerEventKind.down {
                            root.press(at, event.modifiers.control, event.modifiers.shift);
                            root.cursor-pressed = true;
                            root.drag-additive = event.modifiers.control;
                            root.sel-x0 = lx;
                            root.sel-y0 = cy;
                            root.sel-x1 = lx;
                            root.sel-y1 = cy;
                            root.selecting = false;
                            root.did-select = false;
                        }
                        if event.kind == PointerEventKind.up {
                            root.selecting = false;
                            root.cursor-pressed = false;
                        }
                    }
                }
                clicked => { main-fs.focus(); }
                double-clicked => {
                    if !root.did-select {
                        root.open-at(root.hit(self.mouse-x, self.mouse-y - root.scroll-y));
                    }
                }
            }

            ctx := ContextMenu {
                entry: ExplorerBridge.entries[root.cursor];
                entry-idx: root.cursor;

                action(id) => {
                    debug("Action: ", id);
                    if id == "open" { root.open-at(root.cursor); }
                    else if id == "rename" { root.rename(); }
                    else if id == "copy" { root.copy(); }
                    else if id == "trash" { root.trash(); }
                    else if id == "delete-permanently" { root.delete-permanently(); }
                    else if id == "compress" { ExplorerBridge.compressing = true; }
                    main-fs.focus();
                }
            }

            if root.selecting: Rectangle {
                z: 1;
                x: Math.min(root.sel-x0, root.sel-x1);
                y: Math.min(root.sel-y0, root.sel-y1) + root.scroll-y;
                width: Math.max(root.sel-x0, root.sel-x1) - Math.min(root.sel-x0, root.sel-x1);
                height: Math.max(root.sel-y0, root.sel-y1) - Math.min(root.sel-y0, root.sel-y1);
                background: Theme.colors.fourth-col.brighter(1.0).with-alpha(0.5);
                border-color: Theme.colors.fourth-font;
                border-width: 1px;
                border-radius: 12px;
                corner-shape: CornerShape.squircle;
            }

            Rectangle {
                x: parent.width - self.width - 1px;
                y: parent.height - self.height + 7px;
                width: it-l.preferred-width;
                height: 24px;
                background: Theme.colors.fourth-col;
                border-top-left-radius: 12px;
                corner-shape: CornerShape.squircle;
            }

            Rectangle {
                z: 1;
                x: parent.width - self.width;
                y: parent.height - self.height + 8px;
                width: it-l.preferred-width;
                height: 24px;
                background: Theme.colors.secondary-col;
                border-top-left-radius: 12px;
                corner-shape: CornerShape.squircle;
                it-l := HorizontalLayout {
                    alignment: end;
                    padding-right: 12px;
                    padding-left: 20px;
                    cross-axis-alignment: center;

                    Text {
                        text: "\{ExplorerBridge.entries.length} items";
                        font-size: 11px;
                        color: Theme.colors.primary-font;
                        font-weight: 500;
                    }
                }
            }
        }
    }

    if root.renaming: RenameModal {
        new-name <=> root.new-name;
        selection-end: ExplorerBridge.get-dot-pos(root.cursor);

        on-close => {
            main-fs.focus();
            renaming = false;
        }
        save => {
            ExplorerBridge.rename(root.cursor, new-name);
            main-fs.focus();
            renaming = false;
        }
    }

    if ExplorerBridge.compressing: CompressModal {
        on-close => {
            main-fs.focus();
            ExplorerBridge.compressing = false;
        }
    }
}
