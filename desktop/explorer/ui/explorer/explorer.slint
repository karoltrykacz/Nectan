import { Theme } from "../theme.slint";
import {
    GeneralModal,
    PlainLineEdit,
    PrimaryButton,
    Spinner,
    Breadcrumb,
    IconButton,
    SvgIcon,
    Switch,
} from "../elements.slint";
import { ListView, ScrollView } from "std-widgets.slint";
import { WindowBridge, MainWindowTouchArea } from "../window.slint";
import { Keys } from "../keys.slint";
import { SettingsRow } from "../settings.slint";
import { ExplorerBridge, EntryType, DirEntry } from "bridge.slint";
import { CompressModal } from "compress.slint";
import { Icons } from "../icons.slint";

component MenuRow inherits Rectangle {
    in property <string> text;
    callback clicked;

    height: 28px;
    border-radius: 6px;
    background: row-ta.has-hover
        ? Theme.colors.third-col
        : transparent;

    row-ta := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;

        Text {
            text: root.text;
            font-size: 0.8rem;
            color: Theme.colors.primary-font;
            vertical-alignment: center;
        }
    }
}

component MenuSeparator inherits Rectangle {
    height: 9px;

    Rectangle {
        y: 4px;
        height: 1px;
        background: Theme.colors.border-col;
    }
}

component ContextMenu inherits Rectangle {
    callback action(string);

    property <length> menu-width: 256px;
    property <length> menu-height: 420px;

    property <length> pop-x: 0px;
    property <length> pop-y: 0px;

    x: 0px;
    y: 0px;
    width: 0px;
    height: 0px;

    public function open(mx: length, my: length, bound-w: length, bound-h: length) {
        root.pop-x = max(0px, min(mx, bound-w - root.menu-width));
        root.pop-y = max(0px, min(my, bound-h - root.menu-height));
        popup.show();
    }

    popup := PopupWindow {
        x: root.pop-x;
        y: root.pop-y;
        width: root.menu-width;
        height: root.menu-height;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Theme.colors.primary-col;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.colors.border-col;
            drop-shadow-color: #00000099;
            drop-shadow-blur: 20px;
            clip: true;

            VerticalLayout {
                padding: 6px;
                spacing: 0px;

                MenuRow {
                    text: @tr("Open");
                    clicked => { root.action("open"); popup.close(); }
                }

                MenuRow {
                    text: @tr("Scripts");
                    clicked => { root.action("scripts"); }
                }

                MenuSeparator { }

                MenuRow {
                    text: @tr("Cut");
                    clicked => { root.action("cut"); popup.close(); }
                }

                MenuRow {
                    text: @tr("Copy");
                    clicked => { root.action("copy"); popup.close(); }
                }

                MenuRow {
                    text: @tr("Rename");
                    clicked => { root.action("rename"); popup.close(); }
                }

                MenuRow {
                    text: @tr("Compress");
                    clicked => { root.action("compress"); popup.close(); }
                }

                MenuSeparator { }

                MenuRow {
                    text: @tr("Send ");
                }

                MenuRow {
                    text: @tr("Email");
                    clicked => { root.action("email"); popup.close(); }
                }

                MenuSeparator { }

                MenuRow {
                    text: @tr("Move to trash");
                    clicked => { root.action("trash"); popup.close(); }
                }

                MenuRow {
                    text: @tr("Delete permanently");
                    clicked => { root.action("delete-permanently"); popup.close(); }
                }

                MenuSeparator { }

                MenuRow {
                    text: @tr("Properties");
                    clicked => { root.action("properties"); popup.close(); }
                }

                MenuRow {
                    text: @tr("Copy as path");
                    clicked => { root.action("copy-path"); popup.close(); }
                }

                MenuRow {
                    text: @tr("Hash");
                    clicked => { root.action("hash"); }
                }
            }
        }
    }
}

component TopBar inherits HorizontalLayout {
    padding: 12px;
    padding-left: 4px;
    padding-right: 12px;
    cross-axis-alignment: center;

    IconButton {
        width: 28px;
        height: 28px;
        inner-bg: self.hovered ? Theme.colors.third-col : transparent;

        SvgIcon {
            source: Icons.chevron-left;
            fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.third-font;
            size: 18px;
        }

        clicked => {
            ExplorerBridge.back();
            EventResult.accept
        }
    }

    Rectangle {
        width: 2px;
    }

    IconButton {
        width: 28px;
        height: 28px;
        inner-bg: self.hovered ? Theme.colors.third-col : transparent;

        SvgIcon {
            source: Icons.chevron-right;
            fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.third-font;
            size: 18px;
        }

        clicked => {
            ExplorerBridge.forward();
        }
    }

    Rectangle {
        width: 2px;
    }

    IconButton {
        width: 28px;
        height: 28px;
        inner-bg: self.hovered ? Theme.colors.third-col : transparent;

        SvgIcon {
            source: Icons.chevron-right;
            transform-rotation: -90deg;
            fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.third-font;
            size: 18px;
        }

        clicked => {
            ExplorerBridge.up();
        }
    }

    Rectangle {
        width: 12px;
    }

    Breadcrumb {
        components: ExplorerBridge.current-dir;
        clicked(idx) => { ExplorerBridge.navigate-to-in-current(idx); }
    }

    Rectangle { }

    IconButton {
        width: 28px;
        height: 28px;
        inner-bg: self.hovered ? Theme.colors.third-col : transparent;

        SvgIcon {
            source: Icons.search;
            fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.third-font;
            size: 16px;
        }

        clicked => { ExplorerBridge.searching = true; }
    }

    Rectangle {
        width: 8px;
    }

    IconButton {
        width: 28px;
        height: 28px;
        inner-bg: self.hovered ? Theme.colors.third-col : transparent;

        SvgIcon {
            source: Icons.filter;
            fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.third-font;
            size: 16px;
        }

        clicked => {}
    }

    Rectangle {
        width: 8px;
    }

    IconButton {
        width: 28px;
        height: 28px;
        inner-bg: self.hovered ? Theme.colors.third-col : transparent;

        SvgIcon {
            source: Icons.terminal;
            fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.third-font;
            size: 16px;
        }

        clicked => { ExplorerBridge.terminal(); }
    }

    // Rectangle {
    //     width: 8px;
    // }
    //
    // IconButton {
    //     width: 28px;
    //     height: 28px;
    //     inner-bg: self.hovered ? Theme.colors.third-col : transparent;
    //
    //     SvgIcon {
    //         source: ExplorerBridge.view == View.grid ? Icons.grid : Icons.list;
    //         fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.third-font;
    //         size: 16px;
    //     }
    //
    //     clicked => {
    //         if ExplorerBridge.view == View.grid {
    //             ExplorerBridge.view = list;
    //         } else {
    //             ExplorerBridge.view = grid;
    //         }
    //     }
    // }

    Rectangle {
        width: 8px;
    }

    IconButton {
        width: 28px;
        height: 28px;
        inner-bg: self.hovered ? Theme.colors.third-col : transparent;

        SvgIcon {
            source: Icons.columns;
            fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.third-font;
