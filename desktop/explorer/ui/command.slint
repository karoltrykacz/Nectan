import {
    SvgIcon,
    GeneralModal,
    PlainLineEdit,
} from "../../shared/elements.slint";
import { DeviceItem, DeviceRow, DevicesBridge } from "devices.slint";
import { Theme } from "../../shared/theme.slint";
import { ListView } from "std-widgets.slint";
import { WindowBridge } from "../../shared/window.slint";
import { Icons } from "../../shared/icons.slint";

// TODO

export enum CommandItemKind { device, action, zoxide } 

export struct CommandItem {
    kind: CommandItemKind,
    id: string,
    title: string,
    subtitle: string,
    tag: string,
}

export global CommandBridge {
    in-out property <bool> open;
    in-out property <[CommandItem]> results;

    callback query-changed(string);
    callback action(CommandItemKind, string);
}

component ResultRow inherits Rectangle {
    in property <string> title;
    in property <string> id;
    in property <string> subtitle;
    in property <string> tag;
    in property <CommandItemKind> kind;
    in property <bool> selected;
    callback clicked;

    height: 52px;
    border-radius: 8px;
    corner-shape: CornerShape.squircle;
    background: selected ? Theme.colors.third-col : t.has-hover ? Theme.colors.secondary-col : transparent;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        cross-axis-alignment: center;
        alignment: start;

        Rectangle {
            background: Theme.colors.fourth-col;
            width: 32px;
            height: 32px;
            border-radius: 8px;

            if root.kind == CommandItemKind.device: SvgIcon {
                source: Icons.cpu;
                size: 16px;
            }
            if root.id == "settings":SvgIcon {
                source: Icons.settings;
                size: 16px;
            }

            if root.id == "transfers":SvgIcon {
                source: Icons.transfers;
                size: 16px;
            }
            if root.id == "send-files":SvgIcon {
                source: Icons.file;
                size: 16px;
            }
            if root.id == "send-dir":SvgIcon {
                source: Icons.directory;
                size: 16px;
            }
            if root.id == "add-device":SvgIcon {
                source: Icons.link;
                size: 16px;
            }
        }

        Text {
            text: root.title;
            vertical-alignment: center;
            font-size: 14px;
            font-weight: 500;
            color: Theme.colors.primary-font;
        }
    }

    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Command inherits GeneralModal {
    property <string> query;
    property <int> total: CommandBridge.results.length;
    property <int> selected: 0;

    function pick-index(i: int) {
        CommandBridge.action(CommandBridge.results[i].kind, CommandBridge.results[i].id);
        CommandBridge.open = false;
    }

    function move(delta: int) {
        let n = CommandBridge.results.length;
        if (n == 0) { return; }
        root.selected = Math.mod(root.selected + delta + n, n);

        let row-top = root.selected * 52px;
        if (row-top < -list.content-y) {
            list.content-y = -row-top;
        } else if (row-top + 52px > -list.content-y + list.height) {
            list.content-y = -(row-top + 52px - list.height);
        }
    }

    init => { CommandBridge.query-changed(""); }

    on-close => { CommandBridge.open = false; }

    on-enter => {
        if CommandBridge.results.length > 0 {
            pick-index(root.selected);
        }
    }

    FocusScope {

        focus-lost(reason) => {
            root.on-close();
        }

        capture-key-pressed(e) => {
            debug("Key", e);
            if e.text == Key.DownArrow {
                root.move(1);
                return accept;
            }
            if e.text == Key.UpArrow {
                root.move(-1);
                return accept;
            }
            if e.text == Key.Tab {
                if e.modifiers.shift {
                    root.move(-1);
                } else {
                    root.move(1);
                }
                return accept;
            }
            reject
        }

        Rectangle {
            height: layout.preferred-height;
            width: min(820px, parent.width * 0.8);
            y: parent.height / 3;
            x: (parent.width - self.width) / 2;
            background: Theme.colors.primary-col;
            border-radius: 24px;
            corner-shape: CornerShape.squircle;
            border-width: 1px;
            border-color: Theme.colors.hover-col;
            clip: true;

            TouchArea { }

            layout := VerticalLayout {
                HorizontalLayout {
                    height: 56px;
                    cross-axis-alignment: center;
                    alignment: stretch;
                    padding-left: 20px;
                    spacing: 8px;

                    SvgIcon {
                        source: Icons.search;
                        fg: Theme.colors.fourth-font;
                        size: 16px;
                    }

                    PlainLineEdit {
                        height: 100%;
                        input-text <=> root.query;
                        placeholder-text: @tr("Search...");
                        edited(t) => {
                            root.selected = 0;
                            list.content-y = 0;
                            CommandBridge.query-changed(t);
                        }
                        accepted => { root.on-enter(); }
                        rejected => { root.on-close(); }
                    }
                }

                VerticalLayout {
                    padding-top: 0;
                    padding: 8px;

                    list := ListView {
                        // animate content-y {
                        //     duration: Theme.animation-speed * 4;
                        //     easing: Theme.easing;
                        // }
                        height: min(320px, root.total * 52px);
                        for r[i] in CommandBridge.results: ResultRow {
                            title: r.title;
                            subtitle: r.subtitle;
                            tag: r.tag;
                            kind: r.kind;
                            id: r.id;
                            selected: i == root.selected;
                            clicked => { root.pick-index(i); }
                        }
                    }

                    if CommandBridge.results.length == 0 && root.query != "": Text {
                        height: 52px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        text: @tr("No results");
                        font-size: 13px;
                        color: Theme.colors.third-font;
                    }
                }
            }
        }
    }
}
