import "./fonts/Rubik-Black.ttf";
import "./fonts/Rubik-Bold.ttf";
import "./fonts/Rubik-ExtraBold.ttf";
import "./fonts/Rubik-Light.ttf";
import "./fonts/Rubik-Medium.ttf";
import "./fonts/Rubik-Regular.ttf";
import "./fonts/Rubik-SemiBold.ttf";

export struct ThemeColors {
    primary-col: brush,
    secondary-col: color,
    third-col: color,
    fourth-col: color,
    primary-font: color,
    secondary-font: color,
    third-font: color,
    fourth-font: color,
    hover-col: color,
    border-col: color,
}

export struct ThemeDef {
    code: string,
    name: string,
    colors: ThemeColors,
}

export struct ThemeConfig {
    edges-shape: float,
    round-edges: bool,
    font: string,
    font-scale: float,
    topbar-always-on: bool,
    native-topbar: bool,
    bluriness: float,
    transparency: float,
    window-backpane-transparency: float,
}

export global Theme {
    in-out property <int> mode: 1;
    in-out property <bool> theme-selector;

    in-out property <ThemeConfig> config;

    out property <easing> easing: cubic-bezier(0.25, 0.96, 0.43, 0.98);
    out property <duration> animation-speed: 128ms;
    out property <length> font-header: 20px;

    out property <length> font-size: 13px * config.font-scale;
    out property <length> blur: config.bluriness * 10px;

    public pure function complementary(c: color) -> color {
        let hsv = c.to-hsv();
        let hue = Math.mod(hsv.hue + 180, 360);
        return Colors.hsv(hue, 1.0, 1.0, 1.0);
    }

    out property <color> compl-col: complementary(root.a-primary-col);

    callback config-changed();
    callback mode-changed(int);

    public function set-mode(idx: int) {
        root.mode = idx;
        root.mode-changed(idx);
        root.config-changed();
    }

    out property <[ThemeDef]> themes: [
        {
            code: "light",
            name: "Light",
            colors: {
                primary-col: #f1f1f1,
                secondary-col: #ddd,
                third-col: #ccc,
                fourth-col: #bfbfbf,
                primary-font: #1a1a1a,
                secondary-font: #333333,
                third-font: #555555,
                fourth-font: #888888,
                hover-col: #00000022,
                border-col: #cccccc,
            },
        },
        {
            code: "ultra-dark",
            name: "Oled",
            colors: {
                primary-col: #000,
                secondary-col: #090909,
                third-col: #121212,
                fourth-col: #171717,
                primary-font: #ffffff,
                secondary-font: #cccccc,
                third-font: #aaaaaa,
                fourth-font: #888888,
                hover-col: #ffffff27,
                border-col: #404040,
            },
        },
        {
            code: "dark",
            name: "Dark",
            colors: {
                primary-col: #1a1a1a,
                secondary-col: #1f1f1f,
                third-col: #272727,
                fourth-col: #333333,
                primary-font: #ffffff,
                secondary-font: #cccccc,
                third-font: #aaaaaa,
                fourth-font: #888888,
                hover-col: #ffffff27,
                border-col: #404040,
            },
        },
        {
            code: "sand",
            name: "Sand",
            colors: {
                primary-col: #f4efe6,
                secondary-col: #ebe4d6,
                third-col: #ddd3c0,
                fourth-col: #c5b9a1,
                primary-font: #2b2418,
                secondary-font: #4a4030,
                third-font: #6e6350,
                fourth-font: #948872,
                hover-col: #2b241820,
                border-col: #c5b9a1,
            },
        },
        {
            code: "solarized-dark",
            name: "Solarized Dark",
            colors: {
                primary-col: #002b36,
                secondary-col: #073642,
                third-col: #0d4350,
                fourth-col: #1a5563,
                primary-font: #fdf6e3,
                secondary-font: #eee8d5,
                third-font: #93a1a1,
                fourth-font: #839496,
                hover-col: #b5890022,
                border-col: #1a5563,
            },
        },
        {
            code: "gruvbox",
            name: "Gruvbox",
            colors: {
                primary-col: #282828,
                secondary-col: #32302f,
                third-col: #3c3836,
                fourth-col: #504945,
                primary-font: #ebdbb2,
                secondary-font: #d5c4a1,
                third-font: #bdae93,
                fourth-font: #928374,
                hover-col: #fabd2f20,
                border-col: #49483e,
            },
        },
        {
            code: "ice-cream",
            name: "Neapolitan ice cream",
            colors: {
                primary-col: #f1c5d4,
                secondary-col:#fcf7d9,
                third-col: #f6d8d6,
                fourth-col: #fae7e6,
                primary-font: #614736,
                secondary-font: #614736,
                third-font: #614736,
                fourth-font: #665a5255,
                hover-col: #fae7e6,
                border-col: #614736,
            },
        },
        {
            code: "glamour",
            name: "Glamour",
            colors: {
                primary-col: #5b0619,
                secondary-col:#710d23,
                third-col:#800e27,
                fourth-col: #9c192a,
                primary-font: #f1f1f1,
                secondary-font: #e1e1e1,
                third-font: #d1d1d1,
                fourth-font: #c1c1c1,
                hover-col: #a7252c,
                border-col: #8b1a29,
            },
        },
        {
            code: "goo",
            name: "Gooey",
            colors: {
                primary-col: #4f044e,
                secondary-col: #630962,
                third-col: #7d117c,
                fourth-col: #941e92,
                primary-font: #f1f1f1,
                secondary-font: #e1e1e1,
                third-font: #d1d1d1,
                fourth-font: #c1c1c1,
                hover-col: #961d95,
                border-col: #8f108d,
            },
        },
        {
            code: "fishy",
            name: "Fishy business",
            colors: {
                primary-col: #1b2d61,
                secondary-col: #234b8f,
                third-col: #2c6bbe,
                fourth-col: #2661ad,
                primary-font: #fff9f2,
                secondary-font:#d7f8f8,
                third-font: #b1f8ff,
                fourth-font: #67c8ff,
                hover-col: #5d9bff,
                border-col: #5d9bff,
            },
        },
        {
            code: "slime-or-grass",
            name: "Slime",
            colors: {
                primary-col: #0f4503,
                secondary-col: #1a610b,
                third-col: #247a11,
                fourth-col: #379c21,
                primary-font: #f7f7b7,
                secondary-font: #e3deaf,
                third-font: #f0e8c2,
                fourth-font: #ccb889,
                hover-col: #2da318,
                border-col: #4cbf37,
            },
        },
        {
            code: "high-contrast",
            name: "High Contrast",
            colors: {
                primary-col: #000000,
                secondary-col: #0a0a0a,
                third-col: #141414,
                fourth-col: #262626,
                primary-font: #ffffff,
                secondary-font: #f0f0f0,
                third-font: #ffff66,
                fourth-font: #c0c0c0,
                hover-col: #ffff0030,
                border-col: #ffffff,
            },
        },
    ];

    out property <ThemeColors> target: root.themes[root.mode].colors;

    in-out property <color> a-primary-col: root.target.primary-col;
    in-out property <color> a-secondary-col: root.target.secondary-col;
    in-out property <color> a-third-col: root.target.third-col;
    in-out property <color> a-fourth-col: root.target.fourth-col;
    in-out property <color> a-primary-font: root.target.primary-font;
    in-out property <color> a-secondary-font: root.target.secondary-font;
    in-out property <color> a-third-font: root.target.third-font;
    in-out property <color> a-fourth-font: root.target.fourth-font;
    in-out property <color> a-hover-col: root.target.hover-col;
    in-out property <color> a-border-col: root.target.border-col;

    out property <ThemeColors> colors: {
        primary-col: root.a-primary-col,
        secondary-col: root.a-secondary-col,
        third-col: root.a-third-col,
        fourth-col: root.a-fourth-col,
        primary-font: root.a-primary-font,
        secondary-font: root.a-secondary-font,
        third-font: root.a-third-font,
        fourth-font: root.a-fourth-font,
        hover-col: root.a-hover-col,
        border-col: root.a-border-col,
    };
}

export component ThemeAnimator inherits Rectangle {

    property <color> p-primary-col: Theme.target.primary-col;
    property <color> p-secondary-col: Theme.target.secondary-col;
    property <color> p-third-col: Theme.target.third-col;
    property <color> p-fourth-col: Theme.target.fourth-col;
    property <color> p-primary-font: Theme.target.primary-font;
    property <color> p-secondary-font: Theme.target.secondary-font;
    property <color> p-third-font: Theme.target.third-font;
    property <color> p-fourth-font: Theme.target.fourth-font;
    property <color> p-hover-col: Theme.target.hover-col;
    property <color> p-border-col: Theme.target.border-col;

    animate p-primary-col, p-secondary-col, p-third-col, p-fourth-col, p-primary-font, p-secondary-font, p-third-font, p-fourth-font, p-hover-col, p-border-col {
        duration: 250ms;
        easing: ease-in-out;
    }

    changed p-primary-col => { Theme.a-primary-col = root.p-primary-col; }
    changed p-secondary-col => { Theme.a-secondary-col = root.p-secondary-col; }
    changed p-third-col => { Theme.a-third-col = root.p-third-col; }
    changed p-fourth-col => { Theme.a-fourth-col = root.p-fourth-col; }
    changed p-primary-font => { Theme.a-primary-font = root.p-primary-font; }
    changed p-secondary-font => { Theme.a-secondary-font = root.p-secondary-font; }
    changed p-third-font => { Theme.a-third-font = root.p-third-font; }
    changed p-fourth-font => { Theme.a-fourth-font = root.p-fourth-font; }
    changed p-hover-col => { Theme.a-hover-col = root.p-hover-col; }
    changed p-border-col => { Theme.a-border-col = root.p-border-col; }
}
