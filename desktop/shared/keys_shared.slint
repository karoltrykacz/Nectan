import { Theme } from "theme.slint";

export struct Shortcut {
    keys: keys,
    alt-keys: keys,
}

export struct KeyMap {
    close: Shortcut,
    confirm: Shortcut,
    // Refers to movement of the cursor
    move-down: Shortcut,
    move-up: Shortcut,
    // Refers to directory traversal
    go-parent: Shortcut,
    go-inside: Shortcut,
    next: Shortcut,
    previous: Shortcut,
    essentials: Shortcut,
    tabs: Shortcut,
    toggle-sidebar: Shortcut,
    transfers: Shortcut,
    settings: Shortcut,
    history-forward: Shortcut,
    history-back: Shortcut,
    half-page-down: Shortcut,
    half-page-up: Shortcut,
    search-in-current: Shortcut,
    search-recursively: Shortcut,
    ripgrep: Shortcut,
    copy: Shortcut,
    cut: Shortcut,
    undo: Shortcut,
    redo: Shortcut,
    paste: Shortcut,
    trash: Shortcut,
    delete-permanently: Shortcut,
    select-all: Shortcut,
    select-regex: Shortcut,
    compress: Shortcut,
    rename: Shortcut,
    properties: Shortcut,
    refresh: Shortcut,
    create: Shortcut,
    toggle-hidden: Shortcut,
    list-view: Shortcut,
    grid-view: Shortcut,
    zoom-out: Shortcut,
    zoom-in: Shortcut,
}

export global Keys {
    in-out property <bool> change-shortcut;
    in-out property <bool> change-shortcut-alt;
    in-out property <string> change-shortcut-id: "";

    public function open-change(id: string, alt: bool) {
        change-shortcut-id = id;
        change-shortcut-alt = alt;
        change-shortcut = true;
    }

    public function close-change() {
        change-shortcut = false;
        change-shortcut-id = "";
    }

    callback make-keys(KeyEvent) -> keys;
    callback save-shortcut(string, keys, bool);

    in-out property <KeyMap> map;
}

export struct ShortcutItem { id: string, title: string, keys: keys, alt_keys: keys }

export struct ShortcutGroup {
    category: string,
    items: [ShortcutItem],
}

export component KeysBadge inherits Rectangle {

    in property <keys> keys;
    in property <bool> pressed;
    in property <string> shortcut-id;
    in property <bool> alt;
    in property <bool> interactive: true;

    in property <string> placeholder: @tr("None");

    private property <bool> empty: root.keys.to-string() == "";

    width: max(48px, label.preferred-width + 40px);
    height: 26px;
    border-radius: 8px;
    border-corner-shape: superellipse(Theme.config.edges-shape);
    background: Theme.colors.third-font;

    Rectangle {
        y: (root.pressed || ta.pressed) ? 0 : -1px;
        width: 100%;
        height: 24px;
        border-radius: 5px;
        background: ta.has-hover ? Theme.colors.primary-font.darker(0.1) : Theme.colors.primary-font;

        label := Text {
            text: root.empty ? root.placeholder : root.keys.to-string();
            color: root.empty
                ? Theme.colors.primary-col.with-alpha(0.55)
                : Theme.colors.primary-col;
            font-size: 11px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        enabled: root.interactive;
        mouse-cursor: pointer;
        clicked => { Keys.open-change(root.shortcut-id, root.alt); }
    }
}

export component ShortcutGroupView inherits VerticalLayout {
    in property <string> category;
    in property <[ShortcutItem]> items;

    alignment: start;
    spacing: 4px;

    Text {
        x: 12px;
        text: root.category;
        color: Theme.colors.secondary-font;
        font-size: 0.85rem;
        font-weight: 500;
    }

    Rectangle {
        background: Theme.colors.secondary-col;
        border-radius: 20px;
        border-corner-shape: superellipse(Theme.config.edges-shape);

        VerticalLayout {
            padding: 20px;
            padding-bottom: 0;
            padding-top: 0;

            for item[i] in root.items: Rectangle {
                height: 48px;

                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: item.title;
                        color: Theme.colors.primary-font;
                        font-size: 13px;
                        font-weight: 400;
                        vertical-alignment: center;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        cross-axis-alignment: center;

                        KeysBadge {
                            shortcut-id: item.id;
                            keys: item.keys;
                        }

                        if item.alt-keys.to-string() != "": Text {
                            text: @tr(" | ");
                            color: Theme.colors.third-font;
                            font-size: 11px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }

                        if item.alt-keys.to-string() != "": KeysBadge {
                            shortcut-id: item.id;
                            alt: true;
                            keys: item.alt-keys;
                        }
                    }
                }

                if i != root.items.length - 1: Rectangle {
                    y: parent.height - self.height;
                    height: 1px;
                    background: Theme.colors.fourth-col.with-alpha(0.5);
                }
            }
        }
    }
}
