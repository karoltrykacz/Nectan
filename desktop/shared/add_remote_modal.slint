enum AddMode { input, display }

export component AddDeviceModal inherits GeneralModal {

    property <bool> qr;
    property <bool> help;
    in-out property <AddMode> code-mode: AddMode.input;

    callback set-lookup-state(LookupState);

    set-lookup-state(state) => {
        AddDeviceBridge.lookup-state = state;
    }

    // Timer {
    //     interval: 1s;
    //     running: AddDeviceBridge.time-left > 0;
    //
    //     triggered => {
    //         if (AddDeviceBridge.time-left > 0) {
    //             AddDeviceBridge.time-left -= 1;
    //         }
    //     }
    // }


    on-close => { AddDeviceBridge.open = false; }

    fs := FocusScope {

        KeyBinding {
            keys: @keys(Tab);
            activated => {
                if !AddDeviceBridge.connecting {
                    if root.code-mode == AddMode.input {
                        root.code-mode = AddMode.display;
                    } else {
                        root.code-mode = AddMode.input;
                    }
                    fs.focus();
                }
            }
        }

        TouchArea {
            clicked => { AddDeviceBridge.open = false; }
        }

        Rectangle {
            width: min(620px, parent.width * 0.8);
            height: min(380px, parent.height * 0.8);
            background: Theme.colors.secondary-col;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.colors.border-col;
            drop-shadow-color: #00000088;
            drop-shadow-blur: 50px;
            clip: true;

            TouchArea { }

            VerticalLayout {
                padding: 20px;
                padding-top: 16px;

                HorizontalLayout {
                    spacing: 12px;

                    Text {
                        text: @tr("Add device");
                        color: Theme.colors.primary-font;
                        font-size: 20px;
                        font-weight: 600;
                    }

                    // IconButton {
                //     y: 4px;
                //     width: 28px;
                //     height: 28px;
                //     inner-bg: help.hovered ? Theme.colors.secondary-font : Theme.colors.primary-font;
                //     SvgIcon {
                //         source: @image-url("icons/qr.svg");
                //         size: 16px;
                //         fg: parent.hovered ? Theme.colors.primary-col : Theme.colors.fourth-col;
                //     }
                //
                //     clicked => { root.qr = true; }
                // }

                help := IconButton {
                        y: 4px;
                        width: 28px;
                        height: 28px;
                        inner-bg: help.hovered ? Theme.colors.secondary-font : Theme.colors.primary-font;
                        SvgIcon {
                            source: @image-url("icons/help-circle.svg");
                            size: 16px;
                            fg: parent.hovered ? Theme.colors.primary-col : Theme.colors.fourth-col;
                        }

                        clicked => { root.help = true; }
                    }
                }

                if root.code-mode == AddMode.display && !AddDeviceBridge.connecting: DisplayMode { }

                if root.code-mode == AddMode.input && !AddDeviceBridge.connecting: InputMode { }

                if AddDeviceBridge.connecting: ConnectingStatus { }

                if !AddDeviceBridge.connecting: HorizontalLayout {
                    alignment: end;
                    spacing: 12px;

                    PrimaryButton {
                        width: 112px;
                        text: root.code-mode == AddMode.display
                            ? @tr("Enter code")
                            : @tr("Show code");
                        image: root.code-mode == AddMode.display ?
                            @image-url("icons/edit.svg") : @image-url("icons/eye.svg");
                        animate-width: false;
                        clicked => {
                            if root.code-mode == AddMode.input {
                                root.code-mode = AddMode.display;
                            } else {
                                root.code-mode = AddMode.input;
                            }
                        }
                    }
                }
            }
        }

        if root.help: AddRemoteHelp {
            on-close => {
                root.help = false;
            }
        }
    }
}

    export global ConnectionOfferBridge {
    in-out property <bool> open;
    in-out property <string> remote-device-name;

    callback accept(bool);
}

export component ConnectionOfferModal inherits GeneralModal {

    on-close => {
        ConnectionOfferBridge.accept(false);
        ConnectionOfferBridge.open = false;
    }

    on-enter => {
        ConnectionOfferBridge.accept(true);
        ConnectionOfferBridge.open = false;
    }

    Rectangle {

        width: min(520px, parent.width - 80px);
        height: min(192px, parent.height - 80px);

        animate width, height {
            duration: 200ms;
            easing: cubic-bezier(0.34, 1, 0.64, 1);
        }

        background: Theme.colors.primary-col;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.colors.border-col;
        clip: true;

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => {}
        }

        VerticalLayout {
            padding: 20px;
            padding-top: 18px;

            HorizontalLayout {
                VerticalLayout {
                    alignment: start;
                    Text {
                        text: @tr("Accept connection");
                        font-size: 20px;
                        color: Theme.colors.primary-font;
                        font-weight: 600;
                    }

                    Rectangle {
                        height: 4px;
                    }

                    HorizontalLayout {
                        alignment: start;
                        Text {
                            text: ConnectionOfferBridge.remote-device-name;
                            font-size: 13px;
                            color: Theme.colors.secondary-font;
                            font-weight: 500;
                        }

                        Text {
                            text: @tr(" wants to connect to you.");
                            font-size: 13px;
                            color: Theme.colors.secondary-font;
                        }
                    }
                }
            }

            VerticalLayout {
                alignment: start;
                Rectangle {
                    height: 8px;
                }

                Text {
                    text: @tr("This action won't transfer any files.");
                    color: Theme.colors.primary-font;
                    font-size: 13px;
                    font-weight: 500;
                }

                Text {
                    text: @tr("Accepting will allow {} to send transfer offers to you.",
		    ConnectionOfferBridge.remote-device-name);
                    color: Theme.colors.primary-font;
                    wrap: word-wrap;
                    font-size: 13px;
                    font-weight: 500;
                }

                Rectangle {
                    height: 12px;
                }
            }

            HorizontalLayout {
                alignment: end;
                PrimaryButton {
                    text: @tr("Reject");
                    alt: true;
                    clicked => {
                        ConnectionOfferBridge.open = false;
                        ConnectionOfferBridge.accept(false);
                    }
                }

                Rectangle {
                    width: 12px;
                }

                PrimaryButton {
                    text: @tr("Accept");
                    clicked => {
                        ConnectionOfferBridge.open = false;
                        ConnectionOfferBridge.accept(true);
                    }
                }
            }
        }
    }
}
