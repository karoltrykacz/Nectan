export component DeviceRow inherits Rectangle {
    in property <string> name;
    in property <DeviceStatus> status;

    in property <bool> selected: false;
    property <bool> pressed: false;

    out property <bool> hovered: area.has-hover;
    in property <image> icon;

    height: 52px;
    border-radius: 4px;

    background: pressed
        ? Theme.colors.hover-col.with-alpha(0.05)
        : (selected
        ? Theme.colors.third-col
        : (area.has-hover ? Theme.colors.third-col : transparent));

    callback clicked;

    VerticalLayout {
        padding-left: 12px;
        alignment: center;

        Text {
            text: name;
            color: Theme.colors.primary-font;
            font-size: 13px;
            font-weight: 600;
        }

        DeviceStatusText {
            status: status;
        }
    }

    area := TouchArea {
        clicked => { clicked(); }
        pointer-event(event) => {

            if (event.kind == PointerEventKind.down) {
                pressed = true;
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                pressed = false;
            }
        }
    }
}


export component DeviceOptionsModal inherits Rectangle {
    property <DeviceItem> device: DevicesBridge.devices[DevicesBridge.device-details-open-idx];
    GeneralModal {
        on-close => { DevicesBridge.device-details-open = false; }

        Rectangle {
            width: min(512px, parent.width - 40px);
            height: min(256px,parent.height - 40px);
            clip: true;

            drop-shadow-color: #00000099;
            drop-shadow-blur: 28px;
            background: Theme.colors.primary-col;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.colors.border-col;

            TouchArea {
                clicked => {}
            }

            VerticalLayout {
                padding: 20px;

                VerticalLayout {
                    alignment: center;
                    Text {
                        font-size: 20px;
                        font-weight: 600;
                        color: Theme.colors.primary-font;
                        text: device.name;
                    }

                    DeviceStatusText {
                        status: device.status;
                    }
                }

                Rectangle {
                    height: 8px;
                }

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: @tr("Completed transfers");
                        color: Theme.colors.primary-font;
                        font-size: 14px;
                    }

                    Text {
                        text: device.completed-transfers;
                        font-size: 14px;
                        font-weight: 600;
                        color: Theme.colors.primary-font;
                    }
                }

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: @tr("Total exchanged data");
                        color: Theme.colors.primary-font;
                        font-size: 14px;
                    }

                    Text {
                        text: device.total-exchanged-data;
                        font-size: 14px;
                        font-weight: 600;
                        color: Theme.colors.primary-font;
                    }
                }

                Rectangle { }

                HorizontalLayout {
                    alignment: end;
                    PrimaryButton {
                        text: @tr("Close");
                        clicked => {
                            DevicesBridge.device-details-open = false;
                        }
                    }
                }
            }
        }
    }
}
