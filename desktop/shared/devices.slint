import { Theme } from "theme.slint";
import {
    PrimaryButton,
    GeneralModal,
    SvgIcon,
    IconButton,
} from "elements.slint";
import { OutcomingTransferModalBridge } from "transfer_offer_modal.slint";

export enum DeviceStatus {
    online,
    offline,
    nearby,
}

export struct DeviceItem {
    id: string,
    name: string,
    status: DeviceStatus,
    favourite: bool,
    completed-transfers: int,
    total-exchanged-data: string
}

export global DevicesBridge {
    in-out property <[DeviceItem]> devices: [];
    pure callback toggle-favourite(string);

    in-out property <int> device-details-open-idx: -1;
    in-out property <bool> device-details-open: false;
}

export component DeviceStatusText inherits Text {
    in property <DeviceStatus> status;

    text: status == DeviceStatus.online ? "Online" : status == DeviceStatus.nearby ? @tr("Nearby") : "Offline";
    color: Theme.colors.secondary-font;
    font-size: 12px;
    font-weight: 500;
}


