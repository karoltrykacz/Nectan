import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import {
    GeneralModal,
    PrimaryButton,
    LinkButton,
    Spinner,
} from "elements.slint";
import { Icons } from "icons.slint";
import { WindowBridge } from "window.slint";

export enum MediaKind {
    other,
    photo,
    video,
    audio,
    text,
}

export struct ImageProperties {
    has-image: bool,
    has-camera: bool,
    has-location: bool,
    has-details: bool,
    dimensions: string,
    megapixels: string,
    aspect-ratio: string,
    color-space: string,
    bit-depth: string,
    orientation: string,
    resolution: string,
    camera: string,
    lens: string,
    taken: string,
    exposure: string,
    aperture: string,
    iso: string,
    focal-length: string,
    focal-length-35: string,
    exposure-bias: string,
    exposure-program: string,
    metering: string,
    white-balance: string,
    flash: string,
    gps: string,
    gps-lat: float,
    gps-lon: float,
    altitude: string,
    software: string,
    artist: string,
    copyright: string,
}

export struct VideoProperties {
    no-ffprobe: bool,
    container: string,
    bitrate: string,
    title: string,
    created: string,
    dimensions: string,
    aspect-ratio: string,
    rotation: string,
    duration: string,
    frame-rate: string,
    video-codec: string,
    video-bitrate: string,
    pixel-format: string,
    bit-depth: string,
    color: string,
    hdr: string,
    subtitles: string,
    audio-codec: string,
    audio-info: string,
    audio-tracks: string,
}

export struct AudioProperties {
    title: string,
    artist: string,
    album: string,
    album-artist: string,
    composer: string,
    genre: string,
    year: string,
    track: string,
    disc: string,
    duration: string,
    codec: string,
    quality: string,
    bitrate: string,
    sample-rate: string,
    channels: string,
    bit-depth: string,
    cover: string,
}

export struct TextProperties {
    encoding: string,
    lines: string,
    line-endings: string,
}

export struct DirProperties {
    scanning: bool,
    size: string,
    size-on-disk: string,
    items: string,
    files: string,
    folders: string,
    hidden: string,
    links: string,
}

export struct DirEntryProperties {
    name: string,
    path: string,
    location: string,
    kind: string,
    is-dir: bool,
    is-symlink: bool,
    link-target: string,
    size: string,
    size-on-disk: string,
    modified: string,
    created: string,
    accessed: string,
    permissions: string,
    owner: string,
    group: string,
    hidden: bool,
    read-only: bool,
    icon: image,
    media: MediaKind,
    img: ImageProperties,
    vid: VideoProperties,
    aud: AudioProperties,
    txt: TextProperties,
}

export global PropertiesBridge {
    in-out property <bool> open;
    in-out property <bool> loading;
    in-out property <string> error;

    in-out property <DirEntryProperties> entry;
    in-out property <DirProperties> folder;

    callback copy-path();
    callback open-in-maps(float, float);
    callback closed();
}

component PropGroup inherits VerticalLayout {
    in property <string> title;

    spacing: 2px;

    Text {
        text: root.title;
        color: Theme.colors.third-font;
        font-size: 0.9rem;
        font-weight: 600;
        x: 4px;
    }

    Rectangle {
        background: Theme.colors.secondary-col;
        border-radius: 12px;
        border-corner-shape: superellipse(Theme.config.edges-shape);
        border-width: 1px;
        border-color: Theme.colors.fourth-col;
        vertical-stretch: 0;

        VerticalLayout {
            padding: 12px;
            spacing: 8px;

            @children
        }
    }
}

component PropRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> wrap-value: false;
    in property <string> action-text;

    callback action();

    spacing: 12px;

    Text {
        text: root.label;
        color: Theme.colors.third-font;
        font-size: 1rem;
    }

    Rectangle {
        horizontal-stretch: 1;
        clip: true;

        TextInput {
            width: parent.width;
            text: root.value;
            read-only: true;
            single-line: !root.wrap-value;
            wrap: root.wrap-value ? TextWrap.char-wrap : TextWrap.no-wrap;
            horizontal-alignment: end;
            selection-background-color: Theme.colors.third-font;
            selection-foreground-color: Theme.colors.primary-font;
            color: Theme.colors.primary-font;
            font-size: 1rem;
            font-weight: 500;
        }
    }

    if root.action-text != "": LinkButton {
        text: root.action-text;
        font-size: 0.9rem;

        clicked => {
            root.action();
        }
    }
}

export component Properties inherits GeneralModal {
    property <DirEntryProperties> ent: PropertiesBridge.entry;
    property <DirProperties> fol: PropertiesBridge.folder;
    property <ImageProperties> img: PropertiesBridge.entry.img;
    property <VideoProperties> vid: PropertiesBridge.entry.vid;
    property <AudioProperties> aud: PropertiesBridge.entry.aud;
    property <TextProperties> txt: PropertiesBridge.entry.txt;

    on-close => {
        PropertiesBridge.open = false;
        PropertiesBridge.closed();
    }

    init => {}

    function close() {
        root.restore-focus();
        root.on-close();
    }

    Rectangle {
        width: min(520px, parent.width - 160px);
        height: min(520px, parent.height - 160px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        background: Theme.colors.primary-col;
        border-radius: Theme.config.round-edges ? 24px : 4px;
        border-corner-shape: superellipse(Theme.config.edges-shape);
        border-width: 1px;
        border-color: Theme.colors.fourth-col;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000050;
        drop-shadow-offset-y: 8px;

        TouchArea {
            clicked => {}
        }

        scope := FocusScope {

            key-pressed(event) => { EventResult.reject }

            if PropertiesBridge.loading: VerticalLayout {
                alignment: center;
                cross-axis-alignment: center;
                spacing: 16px;

                Text {
                    text: @tr("Loading");
                    color: Theme.colors.primary-font;
                    font-size: 15px;
                    font-weight: 500;
                    overflow: elide;
                }

                Spinner { }
            }

            if !PropertiesBridge.loading: VerticalLayout {
                padding: 20px;
                padding-top: 16px;
                spacing: 16px;

                HorizontalLayout {
                    spacing: 14px;
                    height: 48px;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;

                        Text {
                            text: root.ent.name;
                            color: Theme.colors.primary-font;
                            font-size: 20px;
                            font-weight: 600;
                            overflow: elide;
                        }

                        Text {
                            text: root.ent.is-dir
                                ? root.ent.kind
                                : root.ent.kind + "  " + root.ent.size;
                            color: Theme.colors.third-font;
                            font-size: 0.9rem;
                            overflow: elide;
                        }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    horizontal-stretch: 1;

                    VerticalLayout {
                        width: 100%;
                        padding-right: 10px;
                        spacing: 14px;

                        PropGroup {
                            title: @tr("General");

                            PropRow {
                                label: @tr("Name");
                                value: root.ent.name;
                                wrap-value: true;
                            }

                            PropRow {
                                label: @tr("Type");
                                value: root.ent.kind;
                            }

                            PropRow {
                                label: @tr("Location");
                                value: root.ent.location;
                                wrap-value: true;
                            }

                            if root.ent.is-symlink: PropRow {
                                label: @tr("Links to");
                                value: root.ent.link-target;
                                wrap-value: true;
                            }

                            if !root.ent.is-dir: PropRow {
                                label: @tr("Size");
                                value: root.ent.size;
                            }

                            if !root.ent.is-dir && root.ent.size-on-disk != "": PropRow {
                                label: @tr("Size on disk");
                                value: root.ent.size-on-disk;
                            }

                            PropRow {
                                label: @tr("Hidden");
                                value: root.ent.hidden ? @tr("Yes") : @tr("No");
                            }
                        }

                        if root.ent.is-dir: PropGroup {
                            title: @tr("Contents");

                            PropRow {
                                label: @tr("Size");
                                value: root.fol.size;
                            }

                            PropRow {
                                label: @tr("Size on disk");
                                value: root.fol.size-on-disk;
                            }

                            PropRow {
                                label: @tr("Items");
                                value: root.fol.items;
                            }

                            PropRow {
                                label: @tr("Total files");
                                value: root.fol.files;
                            }

                            PropRow {
                                label: @tr("Total folders");
                                value: root.fol.folders;
                            }

                            PropRow {
                                label: @tr("Hidden items");
                                value: root.fol.hidden;
                            }

                            if root.fol.links != "" && root.fol.links != "0": PropRow {
                                label: @tr("Symlinks");
                                value: root.fol.links;
                            }

                            PropRow {
                                label: @tr("Status");
                                value: root.fol.scanning ? @tr("Scanning…") : @tr("Complete");
                            }
                        }

                        if root.ent.media == MediaKind.photo && root.img.has-image: PropGroup {
                            title: @tr("Image");

                            if root.img.dimensions != "": PropRow {
                                label: @tr("Dimensions");
                                value: root.img.dimensions;
                            }

                            if root.img.megapixels != "": PropRow {
                                label: @tr("Megapixels");
                                value: root.img.megapixels;
                            }

                            if root.img.aspect-ratio != "": PropRow {
                                label: @tr("Aspect ratio");
                                value: root.img.aspect-ratio;
                            }

                            if root.img.orientation != "": PropRow {
                                label: @tr("Orientation");
                                value: root.img.orientation;
                            }

                            if root.img.resolution != "": PropRow {
                                label: @tr("Resolution");
                                value: root.img.resolution;
                            }

                            if root.img.color-space != "": PropRow {
                                label: @tr("Color space");
                                value: root.img.color-space;
                            }

                            if root.img.bit-depth != "": PropRow {
                                label: @tr("Bit depth");
                                value: root.img.bit-depth;
                            }
                        }

                        if root.ent.media == MediaKind.photo && root.img.has-camera: PropGroup {
                            title: @tr("Camera");

                            if root.img.camera != "": PropRow {
                                label: @tr("Camera");
                                value: root.img.camera;
                            }

                            if root.img.lens != "": PropRow {
                                label: @tr("Lens");
                                value: root.img.lens;
                                wrap-value: true;
                            }

                            if root.img.taken != "": PropRow {
                                label: @tr("Taken");
                                value: root.img.taken;
                            }

                            if root.img.exposure != "": PropRow {
                                label: @tr("Exposure");
                                value: root.img.exposure;
                            }

                            if root.img.aperture != "": PropRow {
                                label: @tr("Aperture");
                                value: root.img.aperture;
                            }

                            if root.img.iso != "": PropRow {
                                label: @tr("ISO");
                                value: root.img.iso;
                            }

                            if root.img.focal-length != "": PropRow {
                                label: @tr("Focal length");
                                value: root.img.focal-length;
                            }

                            if root.img.focal-length-35 != "": PropRow {
                                label: @tr("Focal length (35mm)");
                                value: root.img.focal-length-35;
                            }

                            if root.img.exposure-bias != "": PropRow {
                                label: @tr("Exposure bias");
                                value: root.img.exposure-bias;
                            }

                            if root.img.exposure-program != "": PropRow {
                                label: @tr("Exposure program");
                                value: root.img.exposure-program;
                            }

                            if root.img.metering != "": PropRow {
                                label: @tr("Metering");
                                value: root.img.metering;
                            }

                            if root.img.white-balance != "": PropRow {
                                label: @tr("White balance");
                                value: root.img.white-balance;
                            }

                            if root.img.flash != "": PropRow {
                                label: @tr("Flash");
                                value: root.img.flash;
                                wrap-value: true;
                            }
                        }

                        if root.ent.media == MediaKind.photo && root.img.has-location: PropGroup {
                            title: @tr("Location");

                            if root.img.gps != "": PropRow {
                                label: @tr("Coordinates");
                                value: root.img.gps;
                                action-text: @tr("See on maps");
                                action => {
                                    PropertiesBridge.open-in-maps(
                                        root.img.gps-lat,
                                        root.img.gps-lon);
                                }
                            }

                            if root.img.altitude != "": PropRow {
                                label: @tr("Altitude");
                                value: root.img.altitude;
                            }
                        }

                        if root.ent.media == MediaKind.photo && root.img.has-details: PropGroup {
                            title: @tr("Details");

                            if root.img.software != "": PropRow {
                                label: @tr("Software");
                                value: root.img.software;
                                wrap-value: true;
                            }

                            if root.img.artist != "": PropRow {
                                label: @tr("Artist");
                                value: root.img.artist;
                                wrap-value: true;
                            }

                            if root.img.copyright != "": PropRow {
                                label: @tr("Copyright");
                                value: root.img.copyright;
                                wrap-value: true;
                            }
                        }

                        if root.ent.media == MediaKind.video: PropGroup {
                            title: @tr("Video");

                            if root.vid.no-ffprobe: Text {
                                text: "ffprobe not found";
                                color: Theme.colors.third-font;
                                font-size: 1rem;
                            }

                            if root.vid.dimensions != "": PropRow {
                                label: @tr("Dimensions");
                                value: root.vid.dimensions;
                            }

                            if root.vid.aspect-ratio != "": PropRow {
                                label: @tr("Aspect ratio");
                                value: root.vid.aspect-ratio;
                            }

                            if root.vid.rotation != "": PropRow {
                                label: @tr("Rotation");
                                value: root.vid.rotation;
                            }

                            if root.vid.duration != "": PropRow {
                                label: @tr("Duration");
                                value: root.vid.duration;
                            }

                            if root.vid.frame-rate != "": PropRow {
                                label: @tr("Frame rate");
                                value: root.vid.frame-rate;
                            }

                            if root.vid.video-codec != "": PropRow {
                                label: @tr("Codec");
                                value: root.vid.video-codec;
                            }

                            if root.vid.video-bitrate != "": PropRow {
                                label: @tr("Bitrate");
                                value: root.vid.video-bitrate;
                            }

                            if root.vid.pixel-format != "": PropRow {
                                label: @tr("Pixel format");
                                value: root.vid.pixel-format;
                            }

                            if root.vid.bit-depth != "": PropRow {
                                label: @tr("Bit depth");
                                value: root.vid.bit-depth;
                            }

                            if root.vid.color != "": PropRow {
                                label: @tr("Color");
                                value: root.vid.color;
                            }

                            if root.vid.hdr != "": PropRow {
                                label: @tr("HDR");
                                value: root.vid.hdr;
                            }

                            if root.vid.subtitles != "": PropRow {
                                label: @tr("Subtitles");
                                value: root.vid.subtitles;
                            }
                        }

                        if root.ent.media == MediaKind.video
                            && root.vid.audio-codec != "": PropGroup {
                            title: @tr("Audio track");

                            PropRow {
                                label: @tr("Codec");
                                value: root.vid.audio-codec;
                            }

                            if root.vid.audio-info != "": PropRow {
                                label: @tr("Details");
                                value: root.vid.audio-info;
                            }

                            if root.vid.audio-tracks != "": PropRow {
                                label: @tr("Tracks");
                                value: root.vid.audio-tracks;
                            }
                        }

                        if root.ent.media == MediaKind.video
                            && root.vid.container != "": PropGroup {
                            title: @tr("Container");

                            PropRow {
                                label: @tr("Format");
                                value: root.vid.container;
                            }

                            if root.vid.bitrate != "": PropRow {
                                label: @tr("Overall bitrate");
                                value: root.vid.bitrate;
                            }

                            if root.vid.title != "": PropRow {
                                label: @tr("Title");
                                value: root.vid.title;
                                wrap-value: true;
                            }

                            if root.vid.created != "": PropRow {
                                label: @tr("Created");
                                value: root.vid.created;
                            }
                        }

                        if root.ent.media == MediaKind.audio: PropGroup {
                            title: @tr("Audio");

                            if root.aud.title != "": PropRow {
                                label: @tr("Title");
                                value: root.aud.title;
                                wrap-value: true;
                            }

                            if root.aud.artist != "": PropRow {
                                label: @tr("Artist");
                                value: root.aud.artist;
                                wrap-value: true;
                            }

                            if root.aud.album != "": PropRow {
                                label: @tr("Album");
                                value: root.aud.album;
                                wrap-value: true;
                            }

                            if root.aud.album-artist != "": PropRow {
                                label: @tr("Album artist");
                                value: root.aud.album-artist;
                                wrap-value: true;
                            }

                            if root.aud.composer != "": PropRow {
                                label: @tr("Composer");
                                value: root.aud.composer;
                                wrap-value: true;
                            }

                            if root.aud.genre != "": PropRow {
                                label: @tr("Genre");
                                value: root.aud.genre;
                            }

                            if root.aud.year != "": PropRow {
                                label: @tr("Year");
                                value: root.aud.year;
                            }

                            if root.aud.track != "": PropRow {
                                label: @tr("Track");
                                value: root.aud.track;
                            }

                            if root.aud.disc != "": PropRow {
                                label: @tr("Disc");
                                value: root.aud.disc;
                            }

                            if root.aud.cover != "": PropRow {
                                label: @tr("Cover art");
                                value: root.aud.cover;
                            }

                            if root.aud.duration != "": PropRow {
                                label: @tr("Duration");
                                value: root.aud.duration;
                            }

                            if root.aud.codec != "": PropRow {
                                label: @tr("Codec");
                                value: root.aud.codec;
                            }

                            if root.aud.quality != "": PropRow {
                                label: @tr("Quality");
                                value: root.aud.quality;
                            }

                            if root.aud.bitrate != "": PropRow {
                                label: @tr("Bitrate");
                                value: root.aud.bitrate;
                            }

                            if root.aud.sample-rate != "": PropRow {
                                label: @tr("Sample rate");
                                value: root.aud.sample-rate;
                            }

                            if root.aud.bit-depth != "": PropRow {
                                label: @tr("Bit depth");
                                value: root.aud.bit-depth;
                            }

                            if root.aud.channels != "": PropRow {
                                label: @tr("Channels");
                                value: root.aud.channels;
                            }
                        }

                        if root.ent.media == MediaKind.text: PropGroup {
                            title: @tr("Text");

                            if root.txt.encoding != "": PropRow {
                                label: @tr("Encoding");
                                value: root.txt.encoding;
                            }

                            if root.txt.lines != "": PropRow {
                                label: @tr("Lines");
                                value: root.txt.lines;
                            }

                            if root.txt.line-endings != "": PropRow {
                                label: @tr("Line endings");
                                value: root.txt.line-endings;
                            }
                        }

                        PropGroup {
                            title: @tr("Dates");

                            PropRow {
                                label: @tr("Modified");
                                value: root.ent.modified;
                            }

                            PropRow {
                                label: @tr("Created");
                                value: root.ent.created;
                            }

                            PropRow {
                                label: @tr("Accessed");
                                value: root.ent.accessed;
                            }
                        }

                        PropGroup {
                            title: @tr("Permissions");

                            PropRow {
                                label: @tr("Access");
                                value: root.ent.read-only ? @tr("Read-only") : @tr("Read & write");
                            }

                            if root.ent.permissions != "": PropRow {
                                label: @tr("Mode");
                                value: root.ent.permissions;
                            }

                            if root.ent.owner != "": PropRow {
                                label: @tr("Owner");
                                value: root.ent.owner;
                            }

                            if root.ent.group != "": PropRow {
                                label: @tr("Group");
                                value: root.ent.group;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    PrimaryButton {
                        alt: true;
                        text: @tr("Copy path");
                        image: Icons.clipboard;
                        clicked => {
                            PropertiesBridge.copy-path();
                        }
                    }
                }
            }
        }
    }
}
