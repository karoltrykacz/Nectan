import { GeneralModal, SvgIcon } from "elements.slint";
import { Theme } from "theme.slint";

export global HoverBridge {
    in property <bool> hovering;
    in property <length> hover-x;
    in property <length> hover-y;

    // Absolute pos!
    public pure function is-hovered(pos: Point, width: length, height: length) -> bool {
        hover-x >= pos.x && hover-x <= pos.x + width
            && hover-y >= pos.y && hover-y <= pos.y + height
    }

    callback dropped(string);
}

export component HoverModal inherits GeneralModal {
    Rectangle {
        background: Theme.colors.primary-col;
        border-radius: 24px;
        // border-corner-shape: superellipse(Theme.config.edges-shape);
        border-width: 1px;
        border-color: Theme.colors.border-col;
        clip: true;

        Rectangle {

            VerticalLayout {
                alignment: center;
                cross-axis-alignment: center;

                Text {
                    text: HoverBridge.hover-x / 1px;
                    font-size: 20px;
                    color: Theme.colors.primary-font;
                    font-weight: 600;
                }

                Text {
                    text: HoverBridge.hover-y / 1px;
                    font-size: 20px;
                    color: Theme.colors.primary-font;
                    font-weight: 600;
                }

                Text {
                    text: @tr("Drop files");
                    font-size: 20px;
                    color: Theme.colors.primary-font;
                    font-weight: 600;
                }

                Rectangle {
                    height: 20px;
                }

                SvgIcon {
                    source: @image-url("icons/download.svg");
                    size: 36px;
                }
            }
        }
    }
}
