import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import { DropDownOption } from "dropdown.slint";
import {
    GeneralModal,
    PlainLineEdit,
    PrimaryButton,
    PrimarySmallButton,
    Dropdown,
} from "elements.slint";
import { Icons } from "icons.slint";
import { WindowBridge } from "window.slint";

export global HasherBridge {
    in-out property <bool> open;
    in-out property <bool> busy;
    in-out property <string> output;

    callback compute(string, string);
    callback abort-compute();

    function open-hasher() {
        abort-compute();
        open = true;
        busy = false;
        output = "";
    }
}

export component Hasher inherits GeneralModal {

    on-close => { HasherBridge.output = ""; HasherBridge.open = false; }

    property <[DropDownOption]> algorithms: [
        { code: "md5", name: "MD5" },
        { code: "sha1", name: "SHA-1" },
        { code: "sha224", name: "SHA-224" },
        { code: "sha256", name: "SHA-256" },
        { code: "sha384", name: "SHA-384" },
        { code: "sha512", name: "SHA-512" },
        { code: "sha512-224", name: "SHA-512/224" },
        { code: "sha512-256", name: "SHA-512/256" },
        { code: "sha3-224", name: "SHA3-224" },
        { code: "sha3-256", name: "SHA3-256" },
        { code: "sha3-384", name: "SHA3-384" },
        { code: "sha3-512", name: "SHA3-512" },
        { code: "blake2b", name: "BLAKE2b-512" },
        { code: "blake2s", name: "BLAKE2s-256" },
        { code: "blake3", name: "BLAKE3" },
        { code: "keccak224", name: "Keccak-224" },
        { code: "keccak256", name: "Keccak-256" },
        { code: "keccak384", name: "Keccak-384" },
        { code: "keccak512", name: "Keccak-512" },
    ];
    property <[DropDownOption]> formats: [
        { code: "hex", name: "Hex" },
        { code: "hex-upper", name: "Hex (uppercase)" },
        { code: "base64", name: "Base64" },
        { code: "base64-nopad", name: "Base64 (no padding)" },
        { code: "base64-url", name: "Base64 URL-safe" },
        { code: "base64-url-nopad", name: "Base64 URL-safe (no padding)" },
        { code: "base32", name: "Base32" },
        { code: "base32-nopad", name: "Base32 (no padding)" },
        { code: "base32-hex", name: "Base32 (extended hex)" },
        { code: "binary", name: "Binary" },
        { code: "decimal", name: "Decimal" },
    ];

    in-out property <int> algorithm-index: 0;
    in-out property <int> format-index: 0;

    property <bool> copied: false;

    function start-compute() {
        HasherBridge.compute(
                root.algorithms[root.algorithm-index].code,
                root.formats[root.format-index].code);
    }

    function close-modal() {
        root.restore-focus();
        root.on-close();
    }

    Timer {
        interval: 1200ms;
        running: root.copied;
        triggered => { root.copied = false; }
    }

    card := Rectangle {
        width: min(560px, parent.width - 48px);
        height: content.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        background: Theme.colors.primary-col;
        border-radius: Theme.config.round-edges ? 24px : 4px;
        border-corner-shape: superellipse(Theme.config.edges-shape);
        border-width: 1px;
        border-color: Theme.colors.fourth-col;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000050;
        drop-shadow-offset-y: 8px;

        TouchArea {
            clicked => {}
        }

        content := VerticalLayout {
            padding: 20px;
            spacing: 16px;

            Text {
                color: Theme.colors.primary-font;
                text: @tr("Hash file");
                font-weight: 600;
                font-size: 20px;
            }

            Rectangle {
                z: 10;
                height: 56px;

                HorizontalLayout {
                    spacing: 16px;

                    VerticalLayout {

                        Text {
                            text: @tr("Algorithm");
                            font-size: 12px;
                            font-weight: 500;
                            color: Theme.colors.secondary-font;
                        }

                        d1 := Dropdown {
                            list-min-height: 256px;
                            options: root.algorithms;
                            current: root.algorithm-index;

                            selected(idx) => {
                                root.algorithm-index = idx;
                                HasherBridge.output = "";
                            }
                        }
                    }

                    VerticalLayout {

                        Text {
                            text: @tr("Output format");
                            font-size: 12px;
                            font-weight: 500;
                            color: Theme.colors.secondary-font;
                        }

                        Dropdown {
                            list-min-height: 256px;
                            options: root.formats;
                            current: root.format-index;

                            selected(idx) => {
                                root.format-index = idx;
                                HasherBridge.output = "";
                            }
                        }
                    }
                }
            }

            VerticalLayout {
                spacing: 6px;

                Text {
                    text: @tr("Result");
                    font-size: 12px;
                    font-weight: 500;
                    color: Theme.colors.secondary-font;
                    vertical-alignment: center;
                }

                Rectangle {
                    height: 112px;
                    border-radius: 12px;
                    border-corner-shape: superellipse(Theme.config.edges-shape);
                    background: Theme.colors.secondary-col;
                    border-width: 1px;
                    border-color: Theme.colors.hover-col;
                    clip: true;

                    ScrollView {
                        width: parent.width;
                        height: parent.height;

                        VerticalLayout {
                            padding: 12px;

                            Text {
                                wrap: char-wrap;
                                font-size: 13px;
                                text: HasherBridge.busy ? @tr("Hashing...")
                                    : HasherBridge.output != "" ? HasherBridge.output
                                    : @tr("No hash");
                                color: HasherBridge.output != "" ? Theme.colors.primary-font
                                    : Theme.colors.third-font;
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                PrimaryButton {
                    alt: true;
                    text: @tr("Close");
                    clicked => { root.close-modal(); }
                }

                if HasherBridge.output != "" && !HasherBridge.busy: PrimaryButton {
                    text: root.copied ? @tr("Copied") : @tr("Copy");
                    image: Icons.clipboard;
                    button-loading: HasherBridge.busy;
                    clicked => {
                        WindowBridge.copy_str(HasherBridge.output);
                        root.copied = true;
                    }
                }

                PrimaryButton {
                    text: HasherBridge.busy ? @tr("Hashing") : @tr("Hash");
                    button-loading: HasherBridge.busy;
                    image: Icons.cpu;
                    clicked => {
                        root.start-compute();
                    }
                }
            }
        }
    }
}
