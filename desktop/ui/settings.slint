component Shortcuts inherits SettingsPage {
    title: @tr("Keyboard shortcuts");

    private property <KeyMap> m: Keys.map;

    private property <[ShortcutGroup]> shortcut-groups: [
        {
            category: @tr("General"),
            items: [
                { id: "close", title: @tr("Close"), keys: m.close.keys },
                { id: "confirm", title: @tr("Confirm"), keys: m.confirm.keys },
                {
                    id: "move-down",
                    title: @tr("Move down"),
                    keys: m.move-down.keys,
                    alt_keys: m.move-down.alt-keys
                },
                {
                    id: "move-up",
                    title: @tr("Move up"),
                    keys: m.move-up.keys,
                    alt_keys: m.move-up.alt-keys
                },
            ]
        },
        {
            category: @tr("Window"),
            items: [
                { id: "essentials", title: @tr("Essentials"), keys: m.essentials.keys },
                { id: "toggle-sidebar", title: @tr("Toggle sidebar"), keys: m.toggle-sidebar.keys },
                { id: "transfers", title: @tr("Transfers"), keys: m.transfers.keys },
                { id: "settings", title: @tr("Settings"), keys: m.settings.keys },
            ]
        },
        {
            category: @tr("File explorer"),
            items: [
                { id: "go-up", title: @tr("Go up"), keys: m.go-up.keys, alt_keys: m.go-up.alt-keys },
                {
                    id: "go-down",
                    title: @tr("Go down"),
                    keys: m.go-down.keys,
                    alt_keys: m.go-down.alt-keys
                },
                {
                    id: "history-forward",
                    title: @tr("Forward (History)"),
                    keys: m.history-forward.keys,
                    alt_keys: m.history-forward.alt-keys
                },
                {
                    id: "history-back",
                    title: @tr("Back (History)"),
                    keys: m.history-back.keys,
                    alt_keys: m.history-back.alt-keys
                },
                {
                    id: "half-page-down",
                    title: @tr("Move down half a page"),
                    keys: m.half-page-down.keys,
                    alt_keys: m.half-page-down.alt-keys
                },
                {
                    id: "half-page-up",
                    title: @tr("Move up half a page"),
                    keys: m.half-page-up.keys,
                    alt_keys: m.half-page-up.alt-keys
                },
                { id: "find", title: @tr("Find"), keys: m.find.keys, alt_keys: m.find.alt-keys },
                { id: "ripgrep", title: "Ripgrep", keys: m.ripgrep.keys, alt_keys: m.ripgrep.alt-keys },
                { id: "copy", title: @tr("Copy"), keys: m.copy.keys, alt_keys: m.copy.alt-keys },
                { id: "cut", title: @tr("Cut"), keys: m.cut.keys, alt_keys: m.cut.alt-keys },
                {
                    id: "trash",
                    title: @tr("Delete (Move to trash)"),
                    keys: m.trash.keys,
                    alt_keys: m.trash.alt-keys
                },
                {
                    id: "delete-permanently",
                    title: @tr("Delete (Permanently)"),
                    keys: m.delete-permanently.keys
                },
                { id: "select-all", title: @tr("Select all"), keys: m.select-all.keys },
                { id: "select-regex", title: @tr("Select matching (Regex)"), keys: m.select-regex.keys },
                { id: "rename", title: @tr("Rename"), keys: m.rename.keys, alt_keys: m.rename.alt-keys },
                { id: "properties", title: @tr("Show properties"), keys: m.properties.keys },
                {
                    id: "refresh",
                    title: @tr("Refresh"),
                    keys: m.refresh.keys,
                    alt_keys: m.refresh.alt-keys
                },
                { id: "create", title: @tr("Create"), keys: m.create.keys },
                { id: "toggle-hidden", title: @tr("Show/hide hidden"), keys: m.toggle-hidden.keys },
                { id: "list-view", title: @tr("List view"), keys: m.list-view.keys },
                { id: "grid-view", title: @tr("Grid view"), keys: m.grid-view.keys },
                { id: "zoom-out", title: @tr("Zoom out"), keys: m.zoom-out.keys },
                { id: "zoom-in", title: @tr("Zoom in"), keys: m.zoom-in.keys },
            ]
        },
    ];

    for group in shortcut-groups: ShortcutGroupView {
        category: group.category;
        items: group.items;
    }
}

export component Settings inherits GeneralModal {

    on-close => { SettingsBridge.open = false; }

    init => { fs.focus(); }

    fs := FocusScope {

        KeyBinding {
            keys: @keys(H);
            activated => { SettingsBridge.previous-tab() }
        }

        KeyBinding {
            keys: @keys(L);
            activated => { SettingsBridge.next-tab() }
        }

        KeyBinding {
            keys: @keys(Tab);
            activated => { SettingsBridge.next-tab() }
        }

        KeyBinding {
            keys: @keys(RightArrow);
            activated => { SettingsBridge.next-tab() }
        }

        KeyBinding {
            keys: @keys(LeftArrow);
            activated => { SettingsBridge.previous-tab() }
        }

        Rectangle {
            width: min(920px, parent.width - 40px);
            height: min(620px, parent.height - 40px);
            clip: true;

            background: Theme.colors.primary-col;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.colors.fourth-col.with-alpha(0.5);

            drop-shadow-color: #00000099;
            drop-shadow-blur: 50px;

            TouchArea {
                height: 100%;
                width: 100%;
                clicked => {}
            }

            HorizontalLayout {

                VerticalLayout {
                    width: 156px;
                    padding: 8px;
                    spacing: 2px;

                    SettingsTab {
                        tab-idx: 0;
                        tab-name: @tr("General");
                    }

                    SettingsTab {
                        tab-idx: 1;
                        tab-name: @tr("Transfers");
                    }

                    SettingsTab {
                        tab-idx: 2;
                        tab-name: @tr("Notifications");
                    }

                    SettingsTab {
                        tab-idx: 3;
                        tab-name: @tr("Appearance");
                    }

                    SettingsTab {
                        tab-idx: 4;
                        tab-name: @tr("Shortcuts");
                    }
                }

                Rectangle {
                    width: 1px;
                    background: Theme.colors.fourth-col.with-alpha(0.5);
                }

                if SettingsBridge.active-tab == 0: General { }

                if SettingsBridge.active-tab == 1: Transfers { }

                if SettingsBridge.active-tab == 2: Notifications { }

                if SettingsBridge.active-tab == 3: Appearance { }

                if SettingsBridge.active-tab == 4: Shortcuts { }
            }
        }

        if SettingsBridge.username-modal: ChangeUsernameModal {
            restore-focus => { fs.focus(); }
        }

        if Keys.change-shortcut: ChangeShortcut {
            restore-focus => { fs.focus(); }
        }

        if SettingsBridge.speed-limits-config: SpeedLimitsConfig {
            restore-focus => { fs.focus(); }
        }
    }
}
