import { ScrollView, TextEdit, VerticalBox, LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import {
    PrimaryButton,
    PlainLineEdit,
    Switch,
    Dropdown,
    LangSelection,
    Slider,
    GeneralModal,
} from "elements.slint";
import { WindowBridge } from "window.slint";
import {
    Keys,
    ShortcutGroup,
    KeyMap,
    KeysBadge,
    ShortcutItem,
} from "keys.slint";
import { IconButton, SvgIcon } from "elements/pure.slint";


export global SettingsBridge {

    in-out property <bool> username-modal;
    in-out property <bool> speed-limits-config;

    in-out property <float> upload-limit;
    in-out property <float> download-limit;

    pure callback format-speed(float) -> string;

    in-out property <bool> open;
    in-out property <int> active-tab: 0;
    in-out property <int> selected-row: -1;

    in-out property <bool> autostart;
    in-out property <string> default-download-dir;

    callback join_discord();
    callback open_github();
    callback open_privacy();
    callback toggle_autostart();
    callback change-default-dir();

    callback confirm-limits(bool, float, float);

    in-out property <bool> self-accept-nearby;
    in-out property <bool> self-accept-favourites;
    in-out property <bool> speed-limits-on;

    in-out property <bool> connection-offer-notification;
    in-out property <bool> transfers-notifications;
    in-out property <bool> devices-notification;

    callback toggle_accept_nearby();
    callback toggle_accept_favourites();
    callback save_hotkeys();

    property <int> tab-count: 5;

    public function next-tab() {
        active-tab = Math.mod(active-tab + 1, tab-count);
    }

    public function previous-tab() {
        active-tab = Math.mod(active-tab + tab-count - 1, tab-count);
    }
}

component ChangeShortcut inherits GeneralModal {
    property <keys> new-keys;
    property <string> shortcut-id: Keys.change-shortcut-id;
    property <bool> is-primary: !Keys.change-shortcut-alt;
    property <bool> pushed-down;

    function save() {
        root.restore-focus();
        if new-keys.to-string() != "" {
            Keys.save-shortcut(shortcut-id, new-keys, is-primary);
        }
        Keys.close-change();
    }

    on-close => {
        root.restore-focus();
        Keys.close-change();
    }

    init => { fs.focus(); }

    forward-focus: fs;

    fs := FocusScope {

        capture-key-pressed(event) => {
            pushed-down = true;
            EventResult.reject
        }

        capture-key-released(event) => {
            pushed-down = false;
            EventResult.reject
        }

        KeyBinding {
            keys: @keys(Return);
            activated => { save(); }
        }

        KeyBinding {
            keys: @keys(Escape);
            activated => {
                root.restore-focus();
                Keys.close-change();
            }
        }

        key-released(event) => {
            EventResult.accept
        }

        key-pressed(event) => {
            root.new-keys = Keys.make-keys(event);
            EventResult.accept
        }

        Rectangle {

            width: min(520px, parent.width - 80px);
            height: min(256px, parent.height - 80px);
            drop-shadow-color: #00000099;
            drop-shadow-blur: 28px;
            background: Theme.colors.primary-col;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.colors.border-col;
            clip: true;

            TouchArea {
                width: 100%;
                height: 100%;
                clicked => {}
            }

            VerticalLayout {
                padding: 20px;
                padding-top: 14px;

                VerticalLayout {
                    spacing: 4px;
                    alignment: start;
                    Text {
                        text: @tr("Change shortcut");
                        font-size: 20px;
                        color: Theme.colors.primary-font;
                        font-weight: 600;
                    }

                    VerticalLayout {
                        alignment: start;
                        Text {
                            text: @tr("Click enter to confirm.");
                            font-size: 13px;
                            color: Theme.colors.secondary-font;
                        }
                    }
                }

                Rectangle { }

                KeysBadge {
                    interactive: false;
                    cross-axis-self-alignment: center;
                    pressed: root.pushed-down;
                    keys: root.new-keys;
                }

                Rectangle { }

                HorizontalLayout {
                    alignment: end;
                    PrimaryButton {
                        text: @tr("Cancel");
                        alt: true;
                        clicked => {
                            root.restore-focus();
                            Keys.close-change();
                        }
                    }

                    Rectangle {
                        width: 12px;
                    }

                    PrimaryButton {
                        text: @tr("Save");
                        image: @image-url("icons/save.svg");
                        clicked => { save(); }
                    }
                }
            }
        }
    }
}

component SettingsPage inherits FocusScope {

    init => {
        self.focus();
        SettingsBridge.selected-row = -1;
    }

    in property <string> title;
    in property <int> row-count: 0;

    KeyBinding {
        keys: @keys(J);
        activated => {
            SettingsBridge.selected-row = Math.min(SettingsBridge.selected-row + 1, row-count - 1);
        }
    }

    KeyBinding {
        keys: @keys(K);
        activated => {
            SettingsBridge.selected-row = Math.max(SettingsBridge.selected-row - 1, 0);
        }
    }

    KeyBinding {
        keys: @keys(UpArrow);
        activated => {
            SettingsBridge.selected-row = Math.max(SettingsBridge.selected-row - 1, 0);
        }
    }

    KeyBinding {
        keys: @keys(DownArrow);
        activated => {
            SettingsBridge.selected-row = Math.min(SettingsBridge.selected-row + 1, row-count - 1);
        }
    }

    ScrollView {
        VerticalLayout {

            padding: 20px;
            padding-top: 16px;
            spacing: 8px;
            alignment: start;

            Text {
                text: title;
                color: Theme.colors.primary-font;
                font-size: 20px;
                font-weight: 700;
            }

            Rectangle {
                height: 4px;
            }

            @children
        }
    }
}



export component SettingsRow {

    in property <string> title;
    in property <string> subtitle;
    in property <int> idx;
    property <bool> selected: false;

    callback activate();

    changed selected => {
        if selected {
            fs.focus();
        }
    }

    fs := FocusScope {
        KeyBinding {
            keys: @keys(Return);
            activated => {
                activate();
            }
        }

        Rectangle {
            x: 0;
            height: 52px;
            border-radius: 8px;
            background: selected ? Theme.colors.third-col : transparent;
        }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding: 4px;
            alignment: space-between;

            VerticalLayout {
                spacing: 2px;
                alignment: start;

                Text {
                    text: root.title;
                    color: Theme.colors.primary-font;
                    font-size: 13px;
                    font-weight: 600;
                }

                Text {
                    text: root.subtitle;
                    color: Theme.colors.third-font;
                    font-size: 12px;
                }
            }

            VerticalLayout {
                alignment: center;
                cross-axis-alignment: center;
                @children
            }
        }
    }
}




component SettingsTab inherits Rectangle {
    in property <string> tab-name;
    in property <int> tab-idx;
    in property <image> icon;
    in property <length> icon-size;

    height: 28px;
    border-radius: 12px;
    border-corner-shape: superellipse(WindowBridge.edges-shape);
    background: SettingsBridge.active-tab == tab-idx ? Theme.colors.secondary-col
        : (ta.has-hover ? Theme.colors.secondary-col : transparent);
    border-width: 1px;
    border-color: SettingsBridge.active-tab == tab-idx ? Theme.colors.fourth-col : transparent;
    transform-scale: ta.pressed ? 0.9875 : 1.0;

    animate transform-scale {
        duration: 20ms;
        easing: ease;
    }

    HorizontalLayout {
        cross-axis-alignment: center;
        alignment: start;
        padding-left: 12px;
        spacing: 8px;

        SvgIcon {
            source: root.icon;
            size: root.icon-size;
        }

        Text {
            text: tab-name;
            color: SettingsBridge.active-tab == tab-idx
                ? Theme.colors.primary-font
                : (ta.has-hover ? Theme.colors.primary-font : Theme.colors.secondary-font);
            font-size: 12.5px;
            font-weight: 400;
        }
    }

    ta := TouchArea {
        enabled: SettingsBridge.open;
        clicked => {
            SettingsBridge.active-tab = tab-idx;
        }
    }
}


