component ShortcutGroupView inherits Rectangle {
    in property <string> category;
    in property <[ShortcutItem]> items;

    background: Theme.colors.secondary-col;
    border-radius: 12px;
    border-corner-shape: superellipse(WindowBridge.edges-shape);

    VerticalLayout {
        padding: 20px;
        padding-bottom: 0;
        padding-top: 16px;

        Text {
            text: root.category;
            color: Theme.colors.primary-font;
            font-size: 16px;
            font-weight: 500;
        }

        Rectangle {
            height: 10px;
        }

        for item[i] in root.items: Rectangle {
            height: 48px;

            HorizontalLayout {
                alignment: space-between;

                Text {
                    text: item.title;
                    color: Theme.colors.primary-font;
                    font-size: 13px;
                    font-weight: 400;
                    vertical-alignment: center;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    cross-axis-alignment: center;

                    KeysBadge {
                        shortcut-id: item.id;
                        alt: false;
                        keys: item.keys;
                    }

                    if item.alt-keys.to-string() != "": Text {
                        text: @tr(" | ");
                        color: Theme.colors.third-font;
                        font-size: 11px;
                        font-weight: 500;
                        vertical-alignment: center;
                    }

                    if item.alt-keys.to-string() != "": KeysBadge {
                        shortcut-id: item.id;
                        alt: true;
                        keys: item.alt-keys;
                    }
                }
            }

            if i != root.items.length - 1: Rectangle {
                y: parent.height - self.height;
                height: 1px;
                background: Theme.colors.fourth-col.with-alpha(0.5);
            }
        }
    }
}

component Shortcuts inherits SettingsPage {
    title: @tr("Keyboard shortcuts");

    private property <KeyMap> m: Keys.map;

    private property <[ShortcutGroup]> shortcut-groups: [
        {
            category: @tr("General"),
            items: [
                { id: "close", title: @tr("Close"), keys: m.close.keys, alt_keys: m.close.alt-keys },
                {
                    id: "confirm",
                    title: @tr("Confirm"),
                    keys: m.confirm.keys,
                    alt_keys: m.confirm.alt-keys
                },
                {
                    id: "move-down",
                    title: @tr("Move down"),
                    keys: m.move-down.keys,
                    alt_keys: m.move-down.alt-keys
                },
                {
                    id: "move-up",
                    title: @tr("Move up"),
                    keys: m.move-up.keys,
                    alt_keys: m.move-up.alt-keys
                },
                { id: "undo", title: @tr("Undo"), keys: m.undo.keys, alt_keys: m.undo.alt-keys },
                { id: "redo", title: @tr("Redo"), keys: m.redo.keys, alt_keys: m.redo.alt-keys },
            ]
        },
        {
            category: @tr("Window"),
            items: [
                {
                    id: "essentials",
                    title: @tr("Focus on essentials"),
                    keys: m.essentials.keys,
                    alt_keys: m.essentials.alt-keys
                },
                {
                    id: "toggle-sidebar",
                    title: @tr("Toggle sidebar"),
                    keys: m.toggle-sidebar.keys,
                    alt_keys: m.toggle-sidebar.alt-keys
                },
                {
                    id: "transfers",
                    title: @tr("Transfers"),
                    keys: m.transfers.keys,
                    alt_keys: m.transfers.alt-keys
                },
                {
                    id: "settings",
                    title: @tr("Settings"),
                    keys: m.settings.keys,
                    alt_keys: m.settings.alt-keys
                },
            ]
        },
        {
            category: @tr("File explorer"),
            items: [
                {
                    id: "go-parent",
                    title: @tr("Go to parent directory"),
                    keys: m.go-parent.keys,
                    alt_keys: m.go-parent.alt-keys
                },
                {
                    id: "go-down",
                    title: @tr("Go inside "),
                    keys: m.go-inside.keys,
                    alt_keys: m.go-inside.alt-keys
                },
                {
                    id: "history-forward",
                    title: @tr("Forward (History)"),
                    keys: m.history-forward.keys,
                    alt_keys: m.history-forward.alt-keys
                },
                {
                    id: "history-back",
                    title: @tr("Back (History)"),
                    keys: m.history-back.keys,
                    alt_keys: m.history-back.alt-keys
                },
                {
                    id: "half-page-down",
                    title: @tr("Move down half a page"),
                    keys: m.half-page-down.keys,
                    alt_keys: m.half-page-down.alt-keys
                },
                {
                    id: "half-page-up",
                    title: @tr("Move up half a page"),
                    keys: m.half-page-up.keys,
                    alt_keys: m.half-page-up.alt-keys
                },
                { id: "find", title: @tr("Find"), keys: m.find.keys, alt_keys: m.find.alt-keys },
                { id: "ripgrep", title: "Ripgrep", keys: m.ripgrep.keys, alt_keys: m.ripgrep.alt-keys },
                { id: "copy", title: @tr("Copy"), keys: m.copy.keys, alt_keys: m.copy.alt-keys },
                { id: "paste", title: @tr("Paste"), keys: m.paste.keys, alt_keys: m.paste.alt-keys },
                { id: "cut", title: @tr("Cut"), keys: m.cut.keys, alt_keys: m.cut.alt-keys },
                {
                    id: "trash",
                    title: @tr("Delete (Move to trash)"),
                    keys: m.trash.keys,
                    alt_keys: m.trash.alt-keys
                },
                {
                    id: "delete-permanently",
                    title: @tr("Delete (Permanently)"),
                    keys: m.delete-permanently.keys,
                    alt_keys: m.delete-permanently.alt-keys
                },
                {
                    id: "select-all",
                    title: @tr("Select all"),
                    keys: m.select-all.keys,
                    alt_keys: m.select-all.alt-keys
                },
                {
                    id: "select-regex",
                    title: @tr("Select matching (Regex)"),
                    keys: m.select-regex.keys,
                    alt_keys: m.select-regex.alt-keys
                },
                {
                    id: "compress",
                    title: @tr("compress"),
                    keys: m.compress.keys,
                    alt_keys: m.compress.alt-keys
                },
                { id: "rename", title: @tr("Rename"), keys: m.rename.keys, alt_keys: m.rename.alt-keys },
                {
                    id: "properties",
                    title: @tr("Show properties"),
                    keys: m.properties.keys,
                    alt_keys: m.properties.alt-keys
                },
                {
                    id: "refresh",
                    title: @tr("Refresh"),
                    keys: m.refresh.keys,
                    alt_keys: m.refresh.alt-keys
                },
                { id: "create", title: @tr("Create"), keys: m.create.keys, alt_keys: m.create.alt-keys },
                {
                    id: "toggle-hidden",
                    title: @tr("Show/hide hidden"),
                    keys: m.toggle-hidden.keys,
                    alt_keys: m.toggle-hidden.alt-keys
                },
                {
                    id: "list-view",
                    title: @tr("List view"),
                    keys: m.list-view.keys,
                    alt_keys: m.list-view.alt-keys
                },
                {
                    id: "grid-view",
                    title: @tr("Grid view"),
                    keys: m.grid-view.keys,
                    alt_keys: m.grid-view.alt-keys
                },
                {
                    id: "zoom-out",
                    title: @tr("Zoom out"),
                    keys: m.zoom-out.keys,
                    alt_keys: m.zoom-out.alt-keys
                },
                {
                    id: "zoom-in",
                    title: @tr("Zoom in"),
                    keys: m.zoom-in.keys,
                    alt_keys: m.zoom-in.alt-keys
                },
            ]
        },
    ];

    for group in shortcut-groups: ShortcutGroupView {
        category: group.category;
        items: group.items;
    }
}


export component Settings inherits GeneralModal {

    on-close => { SettingsBridge.open = false; }

    forward-focus: fs;

    fs := FocusScope {
        init => { self.focus(); }

        KeyBinding {
            keys: @keys(H);
            activated => { SettingsBridge.previous-tab() }
        }

        KeyBinding {
            keys: @keys(L);
            activated => { SettingsBridge.next-tab() }
        }

        KeyBinding {
            keys: @keys(Tab);
            activated => { SettingsBridge.next-tab() }
        }

        KeyBinding {
            keys: @keys(RightArrow);
            activated => { SettingsBridge.next-tab() }
        }

        KeyBinding {
            keys: @keys(LeftArrow);
            activated => { SettingsBridge.previous-tab() }
        }

        TouchArea {
            clicked => { SettingsBridge.open = false; }
        }

        Rectangle {
            width: min(920px, parent.width - 40px);
            height: min(620px, parent.height - 40px);
            clip: true;

            background: Theme.colors.primary-col;
            border-radius: 12px;
            border-corner-shape: superellipse(WindowBridge.edges-shape);
            border-width: 1px;
            border-color: Theme.colors.fourth-col.with-alpha(0.5);

            drop-shadow-color: #00000099;
            drop-shadow-blur: 50px;

            HorizontalLayout {

                VerticalLayout {
                    width: 156px;
                    padding: 8px;
                    spacing: 2px;

                    SettingsTab {
                        tab-idx: 0;
                        tab-name: @tr("General");
                        icon-size: 14px;
                        icon: @image-url("icons/settings.svg");
                    }

                    SettingsTab {
                        tab-idx: 1;
                        tab-name: @tr("Transfers");
                        icon-size: 14px;
                        icon: @image-url("icons/tranfsers.svg");
                    }

                    SettingsTab {
                        tab-idx: 2;
                        tab-name: @tr("Notifications");
                        icon-size: 14px;
                        icon: @image-url("icons/bell.svg");
                    }

                    SettingsTab {
                        tab-idx: 3;
                        tab-name: @tr("Appearance");
                        icon-size: 14px;
                        icon: @image-url("icons/palette.svg");
                    }

                    SettingsTab {
                        tab-idx: 4;
                        tab-name: @tr("Shortcuts");
                        icon-size: 14px;
                        icon: @image-url("icons/key.svg");
                    }
                }

                Rectangle {
                    width: 1px;
                    background: Theme.colors.fourth-col.with-alpha(0.5);
                }

                if SettingsBridge.active-tab == 0: General { }

                if SettingsBridge.active-tab == 1: Transfers { }

                if SettingsBridge.active-tab == 2: Notifications { }

                if SettingsBridge.active-tab == 3: Appearance { }

                if SettingsBridge.active-tab == 4: Shortcuts { }
            }
        }

        if SettingsBridge.username-modal: ChangeUsernameModal {
            restore-focus => { fs.focus(); }
        }

        if Keys.change-shortcut: ChangeShortcut {
            restore-focus => { fs.focus(); }
        }

        if SettingsBridge.speed-limits-config: SpeedLimitsConfig {
            restore-focus => { fs.focus(); }
        }
    }
}
