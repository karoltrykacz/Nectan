import { ScrollView, TextEdit, VerticalBox, LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import {
    PrimaryButton,
    GeneralModal,
    PlainLineEdit,
    Switch,
    Dropdown,
    LangSelection,
} from "elements.slint";
import { WindowBridge } from "window.slint";

export struct ShortcutItem {
    title: string,
    keys: [string],
    show_border: bool,
}

export struct ShortcutGroup {
    category: string,
    items: [ShortcutItem],
}

enum SubSettingsTab {
    general,
    transfers,
    advanced,
}

export global SettingsBridge {

    in-out property <bool> username-modal: false;
    in-out property <bool> open: false;
    in-out property <SubSettingsTab> active-tab: SubSettingsTab.general;

    in-out property <bool> autostart;
    in-out property <string> default-download-dir;

    callback join_discord();
    callback open_github();
    callback open_privacy();
    callback toggle_autostart();
    callback change-default-dir();

    // Transfer settings
    in-out property <bool> self-accept-nearby;
    in-out property <bool> self-accept-favourites;

    callback toggle_accept_nearby();
    callback toggle_accept_favourites();
}

export component KeyBadge {
    in property <string> key-name;

    Rectangle {
        height: 26px;
        min-width: 36px;
        border-radius: 5px;
        background: Theme.colors.third-font;

        Rectangle {
            y: -1.25px;
            width: 100%;
            height: 24px;
            border-radius: 5px;
            background: Theme.colors.primary-font;

            Text {
                text: root.key-name;
                color: Theme.colors.primary-col;
                font-family: Theme.font-heading;

                font-size: 11px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}


export component SettingsRow {
    in property <string> title;
    in property <string> subtitle;

    HorizontalLayout {
        alignment: space-between;

        VerticalLayout {
            spacing: 2px;
            alignment: start;

            Text {
                text: root.title;
                color: Theme.colors.primary-font;
                font-size: 13px;
                font-weight: 600;
            }

            Text {
                text: root.subtitle;
                color: Theme.colors.third-font;
                font-size: 12px;
            }
        }

        VerticalLayout {
            alignment: center;
            @children
        }
    }
}



component SettingsTab inherits Rectangle {
    in property <string> tab-name;
    in property <SubSettingsTab> tab-type;

    height: 28px;
    border-radius: 6px;
    background: SettingsBridge.active-tab == tab-type ? Theme.colors.secondary-col
        : (general.has-hover ? Theme.colors.secondary-col : transparent);

    Text {
        x: 12px;
        y: (parent.height - self.height) / 2;
        text: tab-name;
        color: SettingsBridge.active-tab == tab-type
            ? Theme.colors.primary-font
            : (general.has-hover ? Theme.colors.primary-font : Theme.colors.third-font);
        font-size: 13px;
        font-weight: 500;
    }

    general := TouchArea {
        enabled: SettingsBridge.open;
        clicked => {
            SettingsBridge.active-tab = tab-type;
        }
    }
}


component SettingsGeneralTab inherits Rectangle {

    width: 100%;
    height: 100%;

    VerticalLayout {
        padding: 20px;
        padding-top: 16px;
        spacing: 12px;
        alignment: start;

        Text {
            text: @tr("General ");
            color: Theme.colors.primary-font;
            font-size: 20px;
            font-weight: 700;
        }

        Rectangle {
            height: 4px;
        }

        SettingsRow {
            title: @tr("Username");
            subtitle: WindowBridge.username;

            PrimaryButton {
                text: @tr("Change");

                clicked => {
                    SettingsBridge.username-modal = true;
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.colors.fourth-col.with-alpha(0.5);
        }

        SettingsRow {
            z: 1;
            title: @tr("Language");
            subtitle: @tr("Change language.");
            LangSelection { }
        }

        Rectangle {
            height: 1px;
            background: Theme.colors.fourth-col.with-alpha(0.5);
        }

        SettingsRow {
            title: @tr("Community");
            subtitle: @tr("Join Nectan discord server.");

            PrimaryButton {
                text: @tr("Join");

                clicked => {
                    SettingsBridge.join_discord();
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.colors.fourth-col.with-alpha(0.5);
        }

        SettingsRow {
            title: @tr("GitHub");
            subtitle: @tr("Nectan is open source. ");

            PrimaryButton {
                text: @tr("Open");

                clicked => {
                    SettingsBridge.open_github();
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.colors.fourth-col.with-alpha(0.5);
        }

        SettingsRow {
            title: @tr("Privacy Policy");
            subtitle: @tr("See our privacy policy.");

            PrimaryButton {
                text: @tr("Open");

                clicked => {
                    SettingsBridge.open_privacy();
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.colors.fourth-col.with-alpha(0.5);
        }

        SettingsRow {
            title: @tr("Default download destination");
            subtitle: SettingsBridge.default-download-dir;
            PrimaryButton {
                text: @tr("Change");
                clicked => { SettingsBridge.change-default-dir(); }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.colors.fourth-col.with-alpha(0.5);
        }

        SettingsRow {
            z: 1;
            title: @tr("Theme");
            subtitle: Theme.themes[Theme.mode].name;
            PrimaryButton {
                text: @tr("Change");
                clicked => {
                    Theme.theme-selector = true;
                    SettingsBridge.open = false;
                }
            }
        }
    }
}

component SettingsTransfersTab inherits Rectangle {

    width: 100%;
    height: 100%;

    VerticalLayout {
        padding: 20px;
        padding-top: 16px;
        spacing: 12px;
        alignment: start;

        Text {
            text: @tr("Transfers ");
            color: Theme.colors.primary-font;
            font-size: 20px;
            font-weight: 700;
        }

        Rectangle {
            height: 4px;
        }

        SettingsRow {
            title: @tr("Auto-accept nearby");
            subtitle: @tr("Automatically accept transfers from nearby devices.");
            Switch {
                checked <=> SettingsBridge.self-accept-nearby;
                toggled => {
                    SettingsBridge.toggle_accept_nearby();
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.colors.fourth-col.with-alpha(0.5);
        }

        SettingsRow {
            title: @tr("Auto-accept from favourites");
            subtitle: @tr("Automatically accept transfers from favourites.");
            Switch {
                checked <=> SettingsBridge.self-accept-favourites;
                toggled => {
                    SettingsBridge.toggle_accept_favourites();
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.colors.fourth-col.with-alpha(0.5);
        }
    }
}



component ChangeUsernameModal inherits Rectangle {
    property <string> new-username;

    function save() {
        WindowBridge.change-username(new-username);
        WindowBridge.username = new-username;
        SettingsBridge.username-modal = false;
    }

    GeneralModal {

        on-close => {
            SettingsBridge.username-modal = false;
        }
        on-enter => { save(); }

        Rectangle {

            width: min(520px, parent.width - 80px);
            height: min(256px, parent.height - 80px);

            animate width, height {
                duration: 200ms;
                easing: cubic-bezier(0.34, 1, 0.64, 1);
            }

            drop-shadow-color: #00000099;
            drop-shadow-blur: 28px;
            background: Theme.colors.primary-col;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.colors.border-col;
            clip: true;

            TouchArea {
                width: 100%;
                height: 100%;
                clicked => {}
            }

            VerticalLayout {
                padding: 20px;
                padding-top: 14px;

                VerticalLayout {
                    spacing: 12px;

                    VerticalLayout {
                        spacing: 4px;
                        alignment: start;
                        Text {
                            text: @tr("Change username");
                            font-size: 20px;
                            color: Theme.colors.primary-font;
                            font-family: Theme.font-heading;
                            font-weight: 600;
                        }

                        VerticalLayout {
                            alignment: start;
                            Text {
                                text: @tr("New username will be visible to other devices after app restart.");
                                font-size: 13px;
                                color: Theme.colors.secondary-font;
                            }
                        }
                    }

                    Rectangle { }

                    Rectangle {
                        border-radius: 8px;
                        background: Theme.colors.third-col;
                        VerticalLayout {
                            PlainLineEdit {
                                placeholder-text: @tr("Enter username");
                                input-text <=> new-username;
                                accepted => { save(); }
                            }
                        }
                    }

                    Rectangle { }

                    HorizontalLayout {
                        alignment: end;
                        PrimaryButton {
                            text: @tr("Cancel");
                            alt: true;
                            clicked => {
                                SettingsBridge.username-modal = false;
                            }
                        }

                        Rectangle {
                            width: 12px;
                        }

                        PrimaryButton {
                            text: @tr("Save");
                            clicked => { save(); }
                        }
                    }
                }
            }
        }
    }
}

export component SettingsModal inherits GeneralModal {

    on-close => { SettingsBridge.open = false; }

    Rectangle {
        width: min(820px, parent.width - 40px);
        height: min(560px,parent.height - 40px);
        clip: true;

        background: Theme.colors.primary-col;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.colors.fourth-col.with-alpha(0.5);

        TouchArea {
            height: 100%;
            width: 100%;
            clicked => {}
        }

        HorizontalLayout {

            Rectangle {
                width: 156px;

                VerticalLayout {
                    padding: 8px;
                    spacing: 4px;

                    SettingsTab {
                        tab-type: SubSettingsTab.general;
                        tab-name: @tr("General");
                    }

                    SettingsTab {
                        tab-type: SubSettingsTab.transfers;
                        tab-name: @tr("Transfers");
                    }

                    SettingsTab {
                        tab-type: SubSettingsTab.advanced;
                        tab-name: @tr("Advanced");
                    }
                }
            }

            Rectangle {
                width: 1px;
                background: Theme.colors.fourth-col.with-alpha(0.5);
            }

            Rectangle {
                if SettingsBridge.active-tab == SubSettingsTab.general: SettingsGeneralTab { }

                if SettingsBridge.active-tab == SubSettingsTab.transfers: SettingsTransfersTab { }
            }
        }
    }

    if SettingsBridge.username-modal: ChangeUsernameModal { }
}

