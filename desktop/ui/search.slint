

import { GeneralModal, PlainLineEdit, SvgIcon } from "elements.slint";
import { DeviceItem, DeviceRow, DevicesBridge } from "devices.slint";
import { Theme } from "theme.slint";
import { ListView } from "std-widgets.slint";

export enum SearchItemKind { device, action } 

export struct ResultItem {
    kind: SearchItemKind,
    id: string,
    title: string,
    subtitle: string,
    tag: string,
}

export global SearchBridge {
    in-out property <bool> open;
    in-out property <[ResultItem]> results;
    callback query-changed(string);
    callback action(SearchItemKind, string);
}

component ResultRow inherits Rectangle {
    in property <string> title;
    in property <string> id;
    in property <string> subtitle;
    in property <string> tag;
    in property <SearchItemKind> kind;
    in property <bool> selected;
    callback clicked;

    height: 52px;
    border-radius: 8px;
    background: selected ? Theme.colors.third-col : t.has-hover ? Theme.colors.secondary-col : transparent;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        cross-axis-alignment: center;
        alignment: start;

        Rectangle {
            background: Theme.colors.fourth-col;
            width: 32px;
            height: 32px;
            border-radius: 8px;

            if root.kind == SearchItemKind.device: SvgIcon {
                source: @image-url("icons/cpu.svg");
                size: 16px;
            }
            if root.id == "settings":SvgIcon {
                source: @image-url("icons/settings.svg");
                size: 16px;
            }
            if root.id == "vaults":SvgIcon {
                source: @image-url("icons/archive.svg");
                size: 16px;
            }
            if root.id == "transfers":SvgIcon {
                source: @image-url("icons/tranfsers.svg");
                size: 16px;
            }
            if root.id == "send-files":SvgIcon {
                source: @image-url("icons/file.svg");
                size: 16px;
            }
            if root.id == "send-folder":SvgIcon {
                source: @image-url("icons/folder.svg");
                size: 16px;
            }
            if root.id == "add-device":SvgIcon {
                source: @image-url("icons/link.svg");
                size: 16px;
            }
        }

        Text {
            text: root.title;
            vertical-alignment: center;
            font-size: 14px;
            font-weight: 500;
            color: Theme.colors.primary-font;
        }
    }

    t := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component Search inherits GeneralModal {
    property <string> query;
    property <int> total: SearchBridge.results.length;
    property <int> selected: 0;

    function pick-index(i: int) {
        SearchBridge.action(SearchBridge.results[i].kind, SearchBridge.results[i].id);
        SearchBridge.open = false;
    }

    function move(delta: int) {
        let n = SearchBridge.results.length;
        if (n == 0) { return; }
        root.selected = Math.mod(root.selected + delta + n, n);

        let row-top = root.selected * 52px;
        if (row-top < -list.viewport-y) {
            list.viewport-y = -row-top;
        } else if (row-top + 52px > -list.viewport-y + list.height) {
            list.viewport-y = -(row-top + 52px - list.height);
        }
    }

    init => { SearchBridge.query-changed(""); }

    on-close => { SearchBridge.open = false; }

    on-enter => {
        if SearchBridge.results.length > 0 {
            pick-index(root.selected);
        }
    }

    Rectangle {
        width: min(820px, parent.width * 0.8);
        height: layout.preferred-height;
        y: parent.height / 3;
        x: (parent.width - self.width) / 2;

        background: Theme.colors.primary-col;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.colors.hover-col;

        TouchArea { }

        FocusScope {
            capture-key-pressed(e) => {
                if e.text == Key.DownArrow { root.move(1); return accept; }
                if e.text == Key.UpArrow { root.move(-1); return accept; }
                if e.text == Key.Tab {
                    if e.modifiers.shift {
                        root.move(-1);
                    } else {
                        root.move(1);
                    }
                    return accept;
                }
                reject
            }

            layout := VerticalLayout {
                HorizontalLayout {
                    height: 56px;
                    cross-axis-alignment: center;
                    padding-left: 20px;
                    spacing: 8px;

                    SvgIcon {
                        source: @image-url("icons/search.svg");
                        fg: Theme.colors.fourth-font;
                        size: 16px;
                    }

                    PlainLineEdit {
                        input-text <=> root.query;
                        placeholder-text: @tr("Search...");
                        edited(t) => {
                            root.selected = 0;
                            list.viewport-y = 0;
                            SearchBridge.query-changed(t);
                        }
                        accepted => { root.on-enter(); }
                    }
                }

                VerticalLayout {
                    padding-top: 0;
                    padding: 8px;

                    list := ListView {
                        height: min(320px, root.total * 52px);
                        for r[i] in SearchBridge.results: ResultRow {
                            title: r.title;
                            subtitle: r.subtitle;
                            tag: r.tag;
                            kind: r.kind;
                            id: r.id;
                            selected: i == root.selected;
                            clicked => { root.pick-index(i); }
                        }
                    }

                    if SearchBridge.results.length == 0 && root.query != "": Text {
                        height: 52px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        text: @tr("No results");
                        font-size: 13px;
                        font-family: Theme.font-body;
                        color: Theme.colors.third-font;
                    }
                }
            }
        }
    }
}

export component SearchBar inherits Rectangle {
    background: h.has-hover ? Theme.colors.fourth-col : Theme.colors.third-col;
    height: 32px;
    border-radius: 12px;

    transform-scale: h.pressed ? 0.98 : 1.0;
    animate transform-scale { duration: 100ms; }

    HorizontalLayout {
        padding-left: 8px;
        spacing: 8px;
        cross-axis-alignment: center;

        SvgIcon {
            source: @image-url("icons/search.svg");
            fg: Theme.colors.third-font;
            size: 16px;
        }

        Text {
            vertical-alignment: center;
            text: @tr("Search...");
            font-size: 13px;
            font-family: Theme.font-body;
            color: Theme.colors.third-font;
        }
    }

    h := TouchArea {
        clicked => {
            SearchBridge.open = true;
        }
    }
}
