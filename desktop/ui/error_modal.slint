import { Theme } from "theme.slint";
import { PrimaryButton, GeneralModal } from "elements.slint";


export global Error {

    in-out property <bool> open: false;
    in-out property <string> title: "";
    in-out property <string> message: "";

    callback show-error(string, string);
    callback close-error();

    show-error(title, message) => {
        open = true;
        root.message = message;
        root.title = title;
    }
}

export component ErrorModal inherits GeneralModal {

    on-close => { Error.open = false; }
    on-enter => { Error.open = false; }

    init => { fs.focus(); }

    TouchArea { }

    fs := FocusScope {

        // Close on any key
        key-pressed(event) => {
            Error.open = false;
            EventResult.accept
        }

        Rectangle {
            width: 520px;
            height: 196px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.colors.primary-col;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.colors.border-col;

            TouchArea {
                width: 100%;
                height: 100%;
            }

            VerticalLayout {
                padding: 20px;
                padding-top: 14px;
                spacing: 12px;

                Text {
                    text: Error.title;
                    color: Theme.colors.primary-font;
                    font-size: 20px;
                    font-weight: 600;
                }

                Text {
                    text: Error.message;
                    color: Theme.colors.secondary-font;
                    font-size: 14px;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    horizontal-stretch: 1;
                    alignment: end;

                    PrimaryButton {
                        text: @tr("Close");
                        clicked => { Error.open = false; }
                    }
                }
            }
        }
    }
}
