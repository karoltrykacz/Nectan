import { Theme } from "theme.slint";
import {
    IconButton,
    SvgIcon,
    PrimaryButton,
    GeneralModal,
} from "elements.slint";
import { ListView, VerticalBox } from "std-widgets.slint";
import { SettingsBridge, SettingsModal, SettingsRow } from "settings.slint";
import { TransfersBridge, Transfers, TransferItem } from "transfers.slint";
import {
    AddDeviceModal,
    AddDeviceBridge,
    ConnectionOfferBridge,
    ConnectionOfferModal,
} from "add_remote_modal.slint";
import { ErrorModal } from "error_modal.slint";
import {
    DeviceItem,
    DevicesBridge,
    DeviceStatus,
    DeviceScreen,
} from "devices.slint";
import {
    IncomingTransferOfferModal,
    IncomingTransferOfferBridge,
    OutcomingTransferModal,
    OutcomingTransferModalBridge,
} from "transfer_offer_modal.slint";
import { SearchBridge, Search, SearchBar } from "search.slint";

export {
    Theme,
    DeviceItem,
    TransferItem,
    SearchBridge,
    DevicesBridge,
    SettingsBridge,
    AddDeviceBridge,
    TransfersBridge,
    ConnectionOfferBridge,
    IncomingTransferOfferBridge,
    OutcomingTransferModalBridge,
}
export enum Window {
    device,
    vaults,
    transfers,
}

export global NotificationsBridge {
    in-out property <bool> notifications-visible: false;
}

export global WindowBridge {

    callback reorder-requested(int, int);
    callback close-requested(int);

    in-out property <bool> nectan-modal-open: false;

    in-out property <bool> topbar-hover: false;

    in-out property <bool> sidebar-visible: true;
    in-out property <bool> sidebar-hover: true;
    in-out property <length> sidebar-width: 200px;

    in-out property <Window> current-window: transfers;
    in-out property <int> current-ref-id: 0;

    in-out property <length> border-radius: 12px;

    callback drag-window();

    callback minimize-window();
    callback maximize-window();
    callback close-window();
}


component NectanModal inherits GeneralModal {

    on-close => { WindowBridge.nectan-modal-open = false; }

    Rectangle {
        width: min(620px, parent.width * 0.8);
        height: min(420px, parent.height * 0.8);

        background: Theme.colors.primary-col;
        border-radius: 14px;
        border-width: 1px;
        border-color: Theme.colors.third-col;
        clip: true;

        VerticalLayout {
            alignment: start;
            padding-top: 64px;
            cross-axis-alignment: center;

            Image {
                source: @image-url("icons/tray.png");
                width: 96px;
                height: 96px;
            }

            Rectangle {
                height: 8px;
            }

            Text {
                text: "Nectan";
                font-family: "Montserrat";
                color: Theme.colors.primary-font;
                font-size: 42px;
                font-weight: 700;
            }

            Text {
                text: "1.0.0";
                font-family: Theme.font-body;
                font-size: 13px;
                font-weight: 500;
                color: Theme.colors.third-font;
            }

            Rectangle {
                height: 96px;
            }

            SettingsRow {
                width: 420px;
                title: @tr("Source code");
                subtitle: @tr("Leave a star if you find Nectan useful.");

                PrimaryButton {
                    text: @tr("Open");
                    image: @image-url("icons/github.svg");
                    clicked => {
                        SettingsBridge.username-modal = true;
                    }
                }
            }
        }
    }
}

component SidebarDevice inherits Rectangle {
    clip: true;

    in property <DeviceItem> device;
    in property <bool> selected: false;

    height: 36px;
    border-radius: 12px;

    background: drag.dragging ? Theme.colors.fourth-font : selected ? Theme.colors.fourth-col : area.has-hover ? Theme.colors.third-col : transparent;

    transform-scale: area.pressed ? 0.99 : 1.0;
    animate transform-scale { duration: 100ms; }

    callback clicked;
    drag := DragArea {
        data: Api.make-data();
        allow-move: true;
        allow-copy: true;
        drag-image: @image-url("icons/link.svg");

        HorizontalLayout {
            padding-left: 12px;
            alignment: start;
            cross-axis-alignment: center;

            Rectangle {
                height: 6px;
                width: 6px;
                border-radius: 4px;
                background: device.status == DeviceStatus.online ? #ff9800 :
                    (device.status == DeviceStatus.nearby ? #0288d1 : Theme.colors.third-font);
            }

            Rectangle {
                width: 4px;
            }

            Text {
                vertical-alignment: center;
                height: root.height;
                text: device.name;
                color: Theme.colors.primary-font;
                font-size: 13px;
                font-weight: 600;
                font-family: Theme.font-heading;
            }
        }

        area := TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.clicked(); }
        }
    }
}

export global Api {
    pure callback make-data() -> data-transfer;
    pure callback can-drop() -> DragAction;
    callback dropped();
}

component TopBarShower inherits Rectangle {
    x: WindowBridge.sidebar-hover ? WindowBridge.sidebar-width + 20px : 0;
    z: 3;
    y: 0;
    width: 100%;
    height: WindowBridge.sidebar-hover ? 30px : 50px;

    TouchArea {
        property <bool> maybe-dragging: false;
        moved => {
            if (self.maybe-dragging) {
                WindowBridge.drag-window();
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                self.maybe-dragging = true;
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                self.maybe-dragging = false;
            }
            if self.mouse-y > 20px {
                WindowBridge.topbar-hover = false;
            }
            if self.mouse-y < 20px {
                WindowBridge.topbar-hover = true;
            }
        }
    }
}

component MainWindowTouchArea inherits TouchArea {
    width: 100%;
    height: 100%;
    pointer-event(event) => {
        if self.mouse-y > 40px {
            WindowBridge.topbar-hover = false;
        }
    }
    scroll-event(event) => {
        if event.delta-x > 10px {
            WindowBridge.sidebar-visible = true;
        }
        if event.delta-x < -10px {
            WindowBridge.sidebar-visible = false;
        }
        return accept;
    }
}

component SidebarShower inherits Rectangle {
    x: 0;
    z: 1;
    width: WindowBridge.sidebar-visible ? 0 : WindowBridge.sidebar-hover ? WindowBridge.sidebar-width + 60px : 20px;
    sidebar-toggle := TouchArea {
        pointer-event(event) => {
            if self.mouse-x > WindowBridge.sidebar-width {
                WindowBridge.sidebar-hover = false;
            }
            if self.mouse-x < 20px {
                WindowBridge.sidebar-hover = true;
            }
        }
    }
}

component Sidebar inherits Rectangle {
    background: Theme.colors.primary-col;
    x: WindowBridge.sidebar-visible ? 0 : (WindowBridge.sidebar-hover ? 0 : -WindowBridge.sidebar-width);
    width: WindowBridge.sidebar-width;
    z: 2;
    border-radius: 8px;
    border-width: 1px;
    border-color: WindowBridge.sidebar-visible ? transparent : Theme.colors.border-col;

    animate x, border-color {
        duration: 128ms;
        easing: ease;
    }
    TouchArea {

        property <bool> maybe-dragging: false;
        moved => {
            if (self.maybe-dragging) {
                WindowBridge.drag-window();
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                self.maybe-dragging = true;
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                self.maybe-dragging = false;
            }
        }
    }

    VerticalLayout {
        padding: 8px;
        padding-bottom: 4px;

        HorizontalLayout {
            // alignment: space-between;

            IconButton {
                width: 28px;
                height: 28px;

                Image {
                    source: @image-url("icons/tray.png");
                    width: 16px;
                    height: 16px;
                }

                clicked => {
                    WindowBridge.nectan-modal-open = true;
                }
            }

            Rectangle { }

            // IconButton {
            //     width: 28px;
            //     height: 28px;
            //
            //     SvgIcon {
            //         source: @image-url("icons/bell.svg");
            //         size: 16px;
            //         fg: parent.hovered ? Theme.colors.secondary-font : Theme.colors.fourth-font;
            //     }
            //
            //     clicked => {
            //         NotificationsBridge.notifications-visible = !NotificationsBridge.notifications-visible;
            //     }
            // }

            IconButton {
                width: 28px;
                height: 28px;
                SvgIcon {
                    source: @image-url("icons/sidebar.svg");
                    fg: parent.hovered ? Theme.colors.secondary-font : Theme.colors.fourth-font;
                    size: 16px;
                }

                clicked => {
                    WindowBridge.sidebar-visible = !WindowBridge.sidebar-visible;
                }
            }
        }

        Rectangle {
            height: 8px;
        }

        SearchBar { }

        Rectangle {
            height: 8px;
        }

        GridLayout {
            spacing: 8px;
            Row {

                IconButton {
                    border-radius: 12px;
                    height: 36px;
                    inner-bg: self.hovered ? Theme.colors.fourth-col : Theme.colors.third-col;
                    transform-y: 0;
                    inner-border: AddDeviceBridge.open ? Theme.colors.fourth-col : transparent;

                    SvgIcon {
                        source: @image-url("icons/link.svg");
                        fg: parent.hovered ? Theme.colors.secondary-font : Theme.colors.fourth-font;
                        size: 16px;
                    }

                    clicked => { AddDeviceBridge.open = true; }
                }

                IconButton {
                    border-radius: 12px;
                    height: 36px;
                    inner-bg: self.hovered ? Theme.colors.fourth-col : Theme.colors.third-col;
                    transform-y: 0;
                    inner-border: WindowBridge.current-window == Window.transfers ? Theme.colors.fourth-col : transparent;

                    SvgIcon {
                        source: @image-url("icons/tranfsers.svg");
                        fg: parent.hovered ? Theme.colors.secondary-font : Theme.colors.fourth-font;
                        size: 17px;
                    }

                    clicked => { WindowBridge.current-window = Window.transfers; }
                }

                IconButton {
                    border-radius: 12px;
                    height: 36px;
                    inner-bg: self.hovered ? Theme.colors.fourth-col : Theme.colors.third-col;
                    transform-y: 0;
                    inner-border: WindowBridge.current-window == Window.vaults ? Theme.colors.fourth-col : transparent;

                    SvgIcon {
                        source: @image-url("icons/archive.svg");
                        fg: parent.hovered ? Theme.colors.secondary-font : Theme.colors.fourth-font;
                        size: 15px;
                    }

                    clicked => { WindowBridge.current-window = Window.vaults; }
                }
            }

            // Row {
            //
            //     IconButton {
            //         border-radius: 12px;
            //         height: 36px;
            //         inner-bg: self.hovered ? Theme.colors.fourth-col : Theme.colors.third-col;
            //         transform-y: 0;
            //         SvgIcon {
            //             source: @image-url("icons/search.svg");
            //             fg: parent.hovered ? Theme.colors.secondary-font : Theme.colors.fourth-font;
            //             size: 16px;
            //         }
            //
            //         clicked => { AddDeviceBridge.open = true; }
            //     }
            //
            //     IconButton {
            //         border-radius: 12px;
            //         height: 36px;
            //         inner-bg: self.hovered ? Theme.colors.fourth-col : Theme.colors.third-col;
            //         transform-y: 0;
            //         SvgIcon {
            //             source: @image-url("icons/hard-drive.svg");
            //             fg: parent.hovered ? Theme.colors.secondary-font : Theme.colors.fourth-font;
            //             size: 16px;
            //         }
            //
            //         clicked => { AddDeviceBridge.open = true; }
            //     }
            // }
        }

        Rectangle {
            height: 8px;
        }

        for d[i] in DevicesBridge.devices: SidebarDevice {
            device: d;
            selected: true;
            clicked => {
                DevicesBridge.device-details-open-idx = i;
                WindowBridge.current-window = Window.device;
            }
        }

        Rectangle { }

        HorizontalLayout {
            alignment: space-between;
            IconButton {
                width: 28px;
                height: 28px;
                SvgIcon {
                    source: @image-url("icons/settings.svg");
                    fg: parent.hovered ? Theme.colors.secondary-font : Theme.colors.fourth-font;
                    size: 16px;
                }

                clicked => {
                    SettingsBridge.open = true;
                }
            }
        }

        Rectangle {
            height: 4px;
        }
    }
}

component Topbar inherits Rectangle {
    x: 0;
    y: 0;
    z: 10;
    height: 20px;
    opacity: WindowBridge.topbar-hover ? 1.0 : 0.0;

    animate opacity {
        delay: 200ms;
        duration: 200ms;
        easing: ease;
    }

    HorizontalLayout {
        padding-top: 7px;
        padding-right: 8px;
        height: 28px;
        alignment: end;
        spacing: 12px;

        IconButton {
            width: 20px;
            height: 20px;
            inner-bg: transparent;
            enabled: WindowBridge.topbar-hover;
            SvgIcon {
                source: @image-url("icons/minimize.svg");
                fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.secondary-font;
                size: 16px;
            }

            clicked => {
                WindowBridge.minimize-window();
            }
        }

        IconButton {
            width: 20px;
            height: 20px;
            inner-bg: transparent;
            enabled: WindowBridge.topbar-hover;
            SvgIcon {
                source: @image-url("icons/maximize.svg");
                fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.secondary-font;
                size: 16px;
            }

            clicked => {
                WindowBridge.maximize-window();
            }
        }

        IconButton {
            width: 20px;
            height: 20px;
            inner-bg: transparent;
            enabled: WindowBridge.topbar-hover;
            SvgIcon {
                source: @image-url("icons/close.svg");
                fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.secondary-font;
                size: 16px;
            }

            clicked => {
                WindowBridge.close-window();
            }
        }
    }
}

export component NectanWindow inherits Window {

    title: "Nectan";
    preferred-width: 1128px;
    preferred-height: 720px;
    min-width: 400px;
    min-height: 200px;
    default-font-family: Theme.font-body;
    resize-border-width: 8px;

    no-frame: true;
    background: transparent;

    in-out property <bool> error_open: false;

    in-out property <string> error_title: "";
    in-out property <string> error_message: "";

    callback show-error(string, string);
    callback close-error();
    callback pasted();

    show-error(title, message) => {
        root.error_open = true;
        root.error_message = message;
        root.error_title = title;
    }

    forward-focus: focus-scope;

    focus-scope := FocusScope {
        focus-on-click: true;
        width: 100%;
        height: 100%;

        init => {
            self.focus();
        }

        key-pressed(event) => {

            if (event.text == Key.F11) {
                root.maximized = !root.maximized;
            }
            if (event.modifiers.shift) {
                if (event.text == "A") {
                    AddDeviceBridge.open = true;
                }
            }
            if (event.modifiers.control || event.modifiers.meta) {

                if (event.text == Key.S) {
                    WindowBridge.sidebar-visible = !WindowBridge.sidebar-visible;
                    WindowBridge.sidebar-hover = false;
                }
                if (event.text == Key.V) {
                    pasted();
                }
                if (event.text == Key.K) {
                    SearchBridge.open = true;
                }
                if (event.text == Key.I) {
                    SettingsBridge.open = true;
                }
                if (event.text == Key.T) {
                    WindowBridge.current-window = Window.transfers;
                }
                return accept;
            }
            return reject;
        }

        MainWindowTouchArea { }

        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.colors.primary-col;

            border-width: root.maximized ? 0 : 1px;
            border-radius: root.maximized ? 0 : 12px;

            border-color: Theme.colors.fourth-col;
            padding: 20px;
            clip: true;

            TopBarShower { }

            SidebarShower { }

            Sidebar { }

            Topbar { }

            HorizontalLayout {
                spacing: 8px;
                padding: 8px;
                padding-top: WindowBridge.topbar-hover ? 24px : 8px;
                padding-left: !WindowBridge.sidebar-visible ? 8px : WindowBridge.sidebar-width;

                animate x, padding-left {
                    duration: 128ms;
                    easing: ease;
                }

                animate padding-top {
                    delay: 200ms;
                    duration: 128ms;
                    easing: ease;
                }

                Rectangle {
                    // opacity: 0.5;
                    background: Theme.colors.secondary-col;
                    border-radius: 8px;

                    if WindowBridge.current-window == Window.device: DeviceScreen { }

                    if WindowBridge.current-window == Window.transfers: Transfers { }
                }
            }
        }

        // VerticalBox {
        //     padding-bottom: NotificationsBridge.notifications-visible ? parent.height : 0;
        //     animate padding-bottom {
        //         duration: 80ms;
        //         easing: ease;
        //     }
        //     opacity: 0.8;
        //     Rectangle {
        //         background: red;
        //     }
        // }

	property <bool> any-modal-open:
    	SettingsBridge.open
            || WindowBridge.nectan-modal-open
            || AddDeviceBridge.open
            || SearchBridge.open
            || OutcomingTransferModalBridge.open;

        changed any-modal-open => {
            if !any-modal-open {
                focus-scope.focus();
            }
        }

        if SettingsBridge.open: SettingsModal { }

        if WindowBridge.nectan-modal-open: NectanModal { }

        if AddDeviceBridge.open:  AddDeviceModal { }

        if SearchBridge.open: Search { }

        if OutcomingTransferModalBridge.open: OutcomingTransferModal { }

        if error_open: ErrorModal {
            title <=> error_title;
            message <=> error_message;
            open <=> error_open;
            closed => { error_open = false; }
        }
    }
}

