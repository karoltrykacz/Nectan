import { Theme } from "theme.slint";
import {
    IconButton,
    SvgIcon,
    PrimaryButton,
    GeneralModal,
} from "elements.slint";
import { ListView } from "std-widgets.slint";
import { SettingsBridge, SettingsModal } from "settings.slint";
import { TransfersBridge, Transfers, TransferItem } from "transfers.slint";
import { Api, WindowBridge, TabsGrid } from "tabs.slint";
import {
    AddRemoteDeviceModal,
    AddDeviceBridge,
    ConnectionOfferBridge,
    ConnectionOfferModal,
} from "add_remote_modal.slint";
import { ErrorModal } from "error_modal.slint";
import { DeviceItem, DevicesBridge, DeviceStatus } from "devices.slint";
import { TreeNode, TreeList } from "path_tree.slint";
import {
    IncomingTransferOfferModal,
    IncomingTransferOfferBridge,
    OutcomingTransferModal,
    OutcomingTransferModalBridge,
} from "transfer_offer_modal.slint";

export {
    Api,
    DeviceItem,
    WindowBridge,
    AddDeviceBridge,
    TransferItem,
    DevicesBridge,
    TransfersBridge,
    ConnectionOfferBridge,
    IncomingTransferOfferBridge,
    OutcomingTransferModalBridge,
}
export component DeviceRow inherits Rectangle {
    in property <string> name: "Device";
    in property <DeviceStatus> status;
    in property <bool> selected: false;
    in property <image> icon;

    property <bool> pressed: false;

    out property <bool> hovered: area.has-hover;

    height: 32px;
    border-radius: 8px;

    transform-scale-x: root.pressed ? 0.99 : 1.0;
    transform-scale-y: root.pressed ? 0.999 : 1.0;
    animate transform-scale-x, transform-scale-y {
        duration: 50ms;
        easing: ease-out;
    }

    background: root.selected
        ? Theme.colors.third-col
        : (area.has-hover ? Theme.colors.third-col : transparent);
    callback clicked;

    VerticalLayout {
        padding-left: 16px;
        alignment: center;

        Text {
            text: root.name;
            color: Theme.colors.primary-font;
            font-size: 13px;
            font-weight: 500;
            font-family: Theme.font-heading;
        }
    }

    area := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
        pointer-event(event) => {

            if (event.kind == PointerEventKind.down) {
                root.pressed = true;
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.pressed = false;
            }
        }
    }
}


component ActionButton inherits Rectangle {
    height: 42px;
    in property <length> icon-size: 16px;
    in property <image> icon;
    in property <string> text;
    in property <color> icon-color: Theme.colors.fourth-col;
    in property <color> text-color: Theme.colors.third-font;

    callback clicked();

    border-radius: 12px;
    background: Theme.colors.third-col;

    states [
        hovered when touch.has-hover: {
            background: Theme.colors.fourth-col;
        }
    ]

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    if icon != @image-url(""): SvgIcon {
        source: icon;
        fg: Theme.colors.third-font;
        size: icon-size;
    }
}

