import { Theme } from "theme.slint";
import {
    IconButton,
    SvgIcon,
    PrimaryButton,
    GeneralModal,
} from "elements.slint";
import { ListView } from "std-widgets.slint";
import { SettingsBridge, SettingsModal } from "settings.slint";
import { TransfersBridge, Transfers } from "transfers.slint";
import { MainBody, WindowBridge, TabDragGhost } from "tabs.slint";
import { AddRemoteDeviceModal, AddDeviceBridge } from "add_remote_modal.slint";

export { WindowBridge, AddDeviceBridge }
export struct TreeNode {
    filename: string,
    path: string,
    depth: int,
    expanded: bool,
    is-file: bool,
}

export component TreeList {

    in property <[TreeNode]> nodes;
    callback toggle-node(int, string);

    ListView {
        for node[i] in nodes: Rectangle {

            background: touch.has-hover ? Theme.colors.secondary-col : transparent;

            height: 28px;
            Rectangle {
                height: 4px;
            }

            HorizontalLayout {

                padding-left: 12px + node.depth * 16px;
                alignment: start;

                if !node.is-file: SvgIcon {
                    y: (28px - 12px) / 2;
                    visible: true;
                    source: node.expanded ? @image-url("icons/chevron-down.svg") : @image-url("icons/chevron-right.svg");
                    fg: Theme.colors.third-font;
                    size: 12px;
                }

                Rectangle {
                    width: 4px;
                }

                SvgIcon {
                    y: (28px - 14px) / 2;
                    vertical-alignment: center;
                    source: node.is-file ? @image-url("icons/file.svg") : @image-url("icons/folder.svg");
                    fg: node.is-file ? Theme.colors.primary-font : #f4c255;
                    size: 14px;
                }

                Rectangle {
                    width: 8px;
                }

                Text {
                    text: node.filename;
                    vertical-alignment: center;
                    font-family: Theme.font-body;
                    font-size: 14px;
                    color: Theme.colors.primary-font;
                }
            }

            touch := TouchArea {
                clicked => {
                    root.toggle-node(i,node.path);
                    debug("Node toggled!");
                }
                double-clicked => {
                    debug("Node double click");
		    // OPEN PREVIEw
                }
            }
        }
    }
}

component TransferSizeEntriesInfoHeader inherits Rectangle {
    in property <int> total-entries;
    in property <string> total-size;

    VerticalLayout {
        cross-axis-alignment: end;
        alignment: start;
        Text {
            text: total-size;
            font-size: 14px;
            color: Theme.colors.primary-font;
            font-family: Theme.font-heading;
            font-weight: 600;
        }

        HorizontalLayout {
            Text {
                text: total-entries;
                font-size: 14px;
                color: Theme.colors.primary-font;
                font-family: Theme.font-heading;
                font-weight: 600;
            }

            Text {
                text: " entries";
                color: Theme.colors.secondary-font;
                font-size: 13px;
                font-weight: 500;
            }
        }
    }
}

export struct TransferOfferItem {
    name: string,
    size-text: string,
}

export struct IncomingTransferOffer {
    transfer-name: string,
    from: string,
    total-entries: int,
    total-size: string,
}

export global IncomingTransferOfferBridge {
    in-out property <bool> is-open: false;
    in-out property <IncomingTransferOffer> offer;
    in-out property <[TreeNode]> nodes;

    // Index, path 
    callback toggle-node(int, string);

    callback accept();
    callback reject();
}


export component IncomingTransferOfferModal inherits Rectangle {
    GeneralModal {
        open <=> IncomingTransferOfferBridge.is-open;

        on-close => {
            IncomingTransferOfferBridge.reject();
        }
        on-enter => {
            IncomingTransferOfferBridge.accept();
        }

        Rectangle {
            width: min(820px, parent.width - 40px);
            height: min(560px, parent.height - 40px);
            clip: true;
            background: Theme.colors.primary-col;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.colors.border-col;

            TouchArea {
                width: 100%;
                height: 100%;
                clicked => {}
            }

            VerticalLayout {
                padding: 20px;

                VerticalLayout {
                    spacing: 12px;

                    HorizontalLayout {
                        VerticalLayout {
                            alignment: start;
                            Text {
                                text: IncomingTransferOfferBridge.offer.transfer-name;
                                font-size: 20px;
                                color: Theme.colors.primary-font;
                                font-family: Theme.font-heading;
                                font-weight: 600;
                            }

                            HorizontalLayout {
                                alignment: start;
                                Text {
                                    text: "Incoming transfer from ";
                                    font-size: 13px;
                                    color: Theme.colors.secondary-font;
                                }

                                Text {
                                    text: IncomingTransferOfferBridge.offer.from;
                                    font-size: 13px;
                                    color: Theme.colors.secondary-font;
                                    font-weight: 600;
                                }
                            }
                        }

                        TransferSizeEntriesInfoHeader {
                            total-entries: IncomingTransferOfferBridge.offer.total-entries;
                            total-size: IncomingTransferOfferBridge.offer.total-size;
                        }
                    }

                    Rectangle {
                        border-radius: 12px;
                        background: Theme.colors.third-col;

                        VerticalLayout {
                            Rectangle {
                                height: 8px;
                            }

                            Text {
                                x: 12px;
                                text: "Contents";
                                color: Theme.colors.primary-font;
                                font-size: 13px;
                                font-weight: 500;
                                font-family: Theme.font-heading;
                            }

                            Rectangle {
                                height: 8px;
                            }

                            TreeList {
                                nodes: IncomingTransferOfferBridge.nodes;
                                toggle-node(id, path) => {
                                    IncomingTransferOfferBridge.toggle-node(id, path)
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: end;
                        PrimaryButton {
                            text: "Reject";
                            alt: true;
                            clicked => {
                                IncomingTransferOfferBridge.reject();
                            }
                        }

                        Rectangle {
                            width: 12px;
                        }

                        PrimaryButton {
                            text: "Accept";
                            clicked => {
                                IncomingTransferOfferBridge.accept();
                            }
                        }
                    }
                }
            }
        }
    }
}

export component NectanWindow inherits Window {
    no-frame: true;
    background: transparent;
    title: "Nectan";
    preferred-width: 1128px;
    preferred-height: 720px;
    min-width: 400px;
    min-height: 200px;
    max-width: 20050px;
    max-height: 20050px;
    default-font-family: Theme.font-body;
    resize-border-width: 8px;

    in-out property <bool> error_open: false;
    in-out property <string> error_title: "";
    in-out property <string> error_message: "";
    callback show-error(string, string);
    callback close-error();

    show-error(title, message) => {
        root.error_open = true;
        root.error_message = message;
        root.error_title = title;
    }

    forward-focus: focus-scope;

    focus-scope := FocusScope {
        width: 100%;
        height: 100%;

        init => {
            self.focus();
        }

        key-pressed(event) => {
	    // Toggle sidebar
            if (event.text == "b"
                && (event.modifiers.control || event.modifiers.meta)) {
                WindowBridge.sidebar-visible = !WindowBridge.sidebar-visible;
                return accept;
            }
            return reject;
        }

        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.colors.primary-col;
            border-width: 1px;
            border-color: #FFFFFF1B;
            border-radius: 8px;
            clip: true;

            MainBody { }

            if SettingsBridge.settings_open: SettingsModal { }

            if IncomingTransferOfferBridge.is-open: IncomingTransferOfferModal { }

            if AddDeviceBridge.add_device_open: AddRemoteDeviceModal { }

            TabDragGhost { }
        }
    }
}
