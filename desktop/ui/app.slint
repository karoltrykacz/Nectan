import { Theme } from "theme.slint";
import { IconButton, SvgIcon, PrimaryButton } from "elements.slint";
import { ListView } from "std-widgets.slint";
import { SettingsBridge, SettingsModal } from "settings.slint";

export struct TreeNode {
    filename: string,
    path: string,
    depth: int,
    expanded: bool,
    is-file: bool,
}

export component TreeList {

    in property <[TreeNode]> nodes;
    callback toggle-node(int, string);

    ListView {
        for node[i] in nodes: Rectangle {

            background: touch.has-hover ? Theme.colors.secondary-col : transparent;

            height: 28px;
            Rectangle {
                height: 4px;
            }

            HorizontalLayout {

                padding-left: 12px + node.depth * 16px;
                alignment: start;

                if !node.is-file: SvgIcon {
                    y: (28px - 12px) / 2;
                    visible: true;
                    source: node.expanded ? @image-url("icons/chevron-down.svg") : @image-url("icons/chevron-right.svg");
                    fg: Theme.colors.third-font;
                    size: 12px;
                }

                Rectangle {
                    width: 4px;
                }

                SvgIcon {
                    y: (28px - 14px) / 2;
                    vertical-alignment: center;
                    source: node.is-file ? @image-url("icons/file.svg") : @image-url("icons/folder.svg");
                    fg: node.is-file ? Theme.colors.primary-font : #f4c255;
                    size: 14px;
                }

                Rectangle {
                    width: 8px;
                }

                Text {
                    text: node.filename;
                    vertical-alignment: center;
                    font-family: Theme.font-body;
                    font-size: 14px;
                    color: Theme.colors.primary-font;
                }
            }

            touch := TouchArea {
                clicked => {
                    root.toggle-node(i,node.path);
                    debug("Node toggled!");
                }
                double-clicked => {
                    debug("Node double click");
		    // OPEN PREVIEw
                }
            }
        }
    }
}

export global WindowBridge {
    in-out property <bool> sidebar-visible: true;
    in-out property <length> sidebar-width: 200px;

    callback drag-window();

    callback minimize-window();
    callback maximize-window();
    callback close-window();
}

component TitleBar inherits Rectangle {

    height: 40px;
    background: Theme.colors.third-col;
    TouchArea {
        moved => {
            WindowBridge.drag-window();
        }
        pointer-event(event) => {}
    }

    HorizontalLayout {
        Rectangle {
            width: 42px;
            height: 42px;

            IconButton {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;

                width: 28px;
                height: 28px;

                SvgIcon {
                    source: @image-url("icons/sidebar.svg");
                    fg: Theme.colors.third-font;
                    size: 18px;
                }

                clicked => { WindowBridge.sidebar-visible = !WindowBridge.sidebar-visible; }
            }
        }

        Rectangle {
            width: WindowBridge.sidebar-visible ? WindowBridge.sidebar-width : 0;
            animate width {
                duration: 75ms;
                easing: ease;
            }
        }

        Rectangle { }

        HorizontalLayout {
            IconButton {
                width: 40px;
                height: 40px;
                round: false;
                transform: false;
                SvgIcon {
                    source: @image-url("icons/minimize.svg");
                    fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.third-font;
                    size: 18px;
                }

                clicked => {
                    debug("minimize-window");
                    WindowBridge.minimize-window();
                }
            }

            IconButton {
                width: 40px;
                height: 40px;
                round: false;
                transform: false;
                SvgIcon {
                    source: @image-url("icons/maximize.svg");
                    fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.third-font;
                    size: 18px;
                }

                clicked => {
                    WindowBridge.maximize-window();
                }
            }

            IconButton {
                width: 40px;
                height: 40px;
                round: false;
                transform: false;
                SvgIcon {
                    source: @image-url("icons/close.svg");
                    fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.third-font;
                    size: 18px;
                }

                clicked => {
                    WindowBridge.close-window();
                }
            }
        }
    }
}


