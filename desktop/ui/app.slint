    IconButton,
    SvgIcon,
    PrimaryButton,
    GeneralModal,
    ThemeSelector,
    Carousel,
    DragGridTileData,
    DragGrid,
} from "elements.slint";
import { ListView, VerticalBox } from "std-widgets.slint";
import { SettingsBridge, Settings, SettingsRow } from "settings.slint";
import { TransfersBridge, Transfers, TransferItem } from "transfers.slint";
import {
    AddDeviceModal,
    AddDeviceBridge,
    ConnectionOfferBridge,
    ConnectionOfferModal,
} from "add_remote_modal.slint";
import { ErrorModal, Error } from "error_modal.slint";
import {
    DeviceItem,
    DevicesBridge,
    DeviceStatus,
    DeviceScreen,
} from "devices.slint";
import {
    IncomingTransferOfferModal,
    IncomingTransferOfferBridge,
    OutcomingTransferModal,
    OutcomingTransferModalBridge,
} from "transfer_offer_modal.slint";
import { SearchBridge, Search, SearchBar } from "search.slint";
import { WindowBridge, Window } from "window.slint";
import { WelcomeScreen } from "welcome.slint";
