import { Theme } from "theme.slint";
import {
    IconButton,
    SvgIcon,
    PrimaryButton,
    GeneralModal,
} from "elements.slint";
import { ListView, VerticalBox } from "std-widgets.slint";
import { SettingsBridge, SettingsModal, SettingsRow } from "settings.slint";
import { TransfersBridge, Transfers, TransferItem } from "transfers.slint";
import {
    AddRemoteDeviceModal,
    AddDeviceBridge,
    ConnectionOfferBridge,
    ConnectionOfferModal,
} from "add_remote_modal.slint";
import { ErrorModal } from "error_modal.slint";
import {
    DeviceItem,
    DevicesBridge,
    DeviceStatus,
    DeviceScreen,
} from "devices.slint";
import { TreeNode, TreeList } from "path_tree.slint";
import {
    IncomingTransferOfferModal,
    IncomingTransferOfferBridge,
    OutcomingTransferModal,
    OutcomingTransferModalBridge,
} from "transfer_offer_modal.slint";
import { SearchBridge, Search, SearchBar } from "search.slint";

export {
    DeviceItem,
    AddDeviceBridge,
    TransferItem,
    DevicesBridge,
    TransfersBridge,
    ConnectionOfferBridge,
    IncomingTransferOfferBridge,
    OutcomingTransferModalBridge,
}
export enum Window { transfers, device, add_remote }

export global WindowBridge {

    callback reorder-requested(int, int);
    callback close-requested(int);

    in-out property <bool> nectan-modal-visible: false;

    in-out property <bool> sidebar-visible: true;
    in-out property <bool> sidebar-hover: true;
    in-out property <length> sidebar-width: 200px;

    in-out property <Window> current-window: transfers;
    in-out property <int> current-ref-id: 0;

    in-out property <length> border-radius: 12px;

    callback drag-window();

    callback minimize-window();
    callback maximize-window();
    callback close-window();
}


component ActionButton inherits Rectangle {
    height: 42px;
    in property <length> icon-size: 16px;
    in property <image> icon;
    in property <string> text;
    in property <color> icon-color: Theme.colors.fourth-col;
    in property <color> text-color: Theme.colors.third-font;

    callback clicked();

    transform-scale: touch.pressed ? 0.97 : 1.0;
    animate transform-scale { duration: 100ms; }

    border-radius: 12px;
    background: Theme.colors.third-col;

    states [
        hovered when touch.has-hover: {
            background: Theme.colors.fourth-col;
            tip.opacity: 1;
            in {
                animate tip.opacity {
                    delay: 500ms;
                    duration: 80ms;
                }
            }
            out {
                animate tip.opacity { duration: 80ms; }
            }
        }
    ]

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    if icon != @image-url(""): SvgIcon {
        source: icon;
        fg: Theme.colors.third-font;
        size: icon-size;
    }

    tip := Rectangle {
        z: 4;
        x: root.width + 4px;
        height: 24px;
        width: self.min-width + 20px;
        border-radius: 4px;
        background: Theme.colors.primary-col;
        border-color: Theme.colors.fourth-col;
        border-width: 1px;
        opacity: 0;
        Text {
            text: text;
            font-size: 12px;
            font-family: Theme.font-heading;
        }
    }
}


