component GeneralModal inherits Rectangle {

    in-out property <bool> open;
    callback on-close();
    callback on-enter();

    forward-focus: focus-scope;

    focus-scope := FocusScope {
        enabled: open;
        visible: open;

        changed enabled => {
            if (open) {
                self.focus();
            }
        }

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                open = false;
                on-close();
                return accept;
            }
            if (event.text == "w"
                && (event.modifiers.control || event.modifiers.meta)) {
                open = false;
                on-close();
                return accept;
            }
            if (event.text == Key.Return) {
                on-enter();
                return accept;
            }
            return reject;
        }

        Rectangle {
            width: 100%;
            height: 100%;
            background: #00000077;
        }

        TouchArea {
            width: 100%;
            height: 100%;
            enabled: open;
            clicked => {
                open = false;
                on-close();
            }
        }

        @children
    }
}

component FoundNearbyModal { }

component OutcomingTransferOfferModal { }

export struct TransferOfferItem {
    name: string,
    size-text: string,
}

export struct IncomingTransferOffer {
    transfer-id: string,
    transfer-name: string,
    from: string,
    total-entries: int,
    total-size: string,
}

export global IncomingTransferOfferBridge {
    in-out property <bool> is-open: false;
    in-out property <IncomingTransferOffer> offer;
    in-out property <[TreeNode]> nodes;

    // Index, path 
    callback toggle-node(int, string);

    callback accept();
    callback reject();
}


export component IncomingTransferOfferModal inherits Rectangle {
    GeneralModal {
        open <=> IncomingTransferOfferBridge.is-open;

        on-close => {
            IncomingTransferOfferBridge.reject();
        }
        on-enter => {
            IncomingTransferOfferBridge.accept();
        }

        Rectangle {
            width: min(820px, parent.width - 40px);
            height: min(560px, parent.height - 40px);
            clip: true;
            background: Theme.colors.primary-col;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.colors.border-col;

            TouchArea {
                width: 100%;
                height: 100%;
                clicked => {}
            }

            VerticalLayout {
                padding: 20px;

                VerticalLayout {
                    spacing: 12px;

                    HorizontalLayout {
                        VerticalLayout {
                            alignment: start;
                            Text {
                                text: IncomingTransferOfferBridge.offer.transfer-name;
                                font-size: 20px;
                                color: Theme.colors.primary-font;
                                font-family: Theme.font-heading;
                                font-weight: 600;
                            }

                            HorizontalLayout {
                                alignment: start;
                                Text {
                                    text: "Incoming transfer from ";
                                    font-size: 13px;
                                    color: Theme.colors.secondary-font;
                                }

                                Text {
                                    text: IncomingTransferOfferBridge.offer.from;
                                    font-size: 13px;
                                    color: Theme.colors.secondary-font;
                                    font-weight: 600;
                                }
                            }
                        }

                        TransferSizeEntriesInfoHeader {
                            total-entries: IncomingTransferOfferBridge.offer.total-entries;
                            total-size: IncomingTransferOfferBridge.offer.total-size;
                        }
                    }

                    Rectangle {
                        border-radius: 12px;
                        background: Theme.colors.third-col;

                        VerticalLayout {
                            Rectangle {
                                height: 8px;
                            }

                            Text {
                                x: 12px;
                                text: "Contents";
                                color: Theme.colors.primary-font;
                                font-size: 13px;
                                font-weight: 500;
                                font-family: Theme.font-heading;
                            }

                            Rectangle {
                                height: 8px;
                            }

                            TreeList {
                                nodes: IncomingTransferOfferBridge.nodes;
                                toggle-node(id, path) => {
                                    IncomingTransferOfferBridge.toggle-node(id, path)
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: end;
                        PrimaryButton {
                            text: "Reject";
                            alt: true;
                            clicked => {
                                IncomingTransferOfferBridge.reject();
                            }
                        }

                        Rectangle {
                            width: 12px;
                        }

                        PrimaryButton {
                            text: "Accept";
                            clicked => {
                                IncomingTransferOfferBridge.accept();
                            }
                        }
                    }
                }
            }
        }
    }
}

