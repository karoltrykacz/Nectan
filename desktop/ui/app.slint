    SearchExplorer,
} from "explorer.slint";

export {
    Theme,
    Error,
    Window,
    DirEntry,
    DeviceItem,
    TransferItem,
    SearchBridge,
    WindowBridge,
    DevicesBridge,
    SidebarBridge,
    SettingsBridge,
    ExplorerBridge,
    AddDeviceBridge,
    TransfersBridge,
    DragGridTileData,
    ConnectionOfferBridge,
    IncomingTransferOfferBridge,
    OutcomingTransferModalBridge,
}
export global NotificationsBridge {
    in-out property <bool> notifications-visible: false;
}

component NectanModal inherits GeneralModal {

    on-close => { WindowBridge.nectan-modal-open = false; }
    init => { self.focus(); }

    Rectangle {
        width: min(620px, parent.width * 0.8);
        height: min(420px, parent.height * 0.8);

        background: Theme.colors.primary-col;
        border-radius: 14px;
        border-width: 1px;
        border-color: Theme.colors.third-col;
        clip: true;

        VerticalLayout {
            cross-axis-alignment: center;
            alignment: center;

            Image {
                source: @image-url("icons/tray.png");
                width: 96px;
                height: 96px;
            }

            Rectangle {
                height: 8px;
            }

            Text {
                text: "Nectan";
                font-family: "Montserrat";
                color: Theme.colors.primary-font;
                font-size: 42px;
                font-weight: 700;
            }

            Text {
                text: "1.0.0";
                font-family: Theme.font-body;
                font-size: 13px;
                font-weight: 500;
                color: Theme.colors.third-font;
            }
        }
    }
}


export global Api {
    pure callback make-data() -> data-transfer;
    pure callback can-drop() -> DragAction;
    callback dropped();
}

component TopBarShower inherits Rectangle {
    x: WindowBridge.sidebar-hover || WindowBridge.sidebar-visible ? WindowBridge.sidebar-width + 20px : 0;
    z: 3;
    y: 0;
    width: 100%;
    height: 25px;

    TouchArea {
        property <bool> maybe-dragging: false;
        moved => {
            if (self.maybe-dragging) {
                WindowBridge.drag-window();
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                self.maybe-dragging = true;
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                self.maybe-dragging = false;
            }
            if self.mouse-y > 20px {
                WindowBridge.topbar-hover = false;
            }
            if self.mouse-y < 20px {
                WindowBridge.topbar-hover = true;
            }
        }
    }
}

component MainWindowTouchArea inherits TouchArea {
    width: 100%;
    height: 100%;
    pointer-event(event) => {
        if self.mouse-y > 40px {
            WindowBridge.topbar-hover = false;
        }
    }
    scroll-event(event) => {
        if event.delta-x > 10px {
            WindowBridge.sidebar-visible = true;
        }
        if event.delta-x < -10px {
            WindowBridge.sidebar-visible = false;
        }
        return accept;
    }
}


component Topbar inherits Rectangle {
    x: 0;
    y: 0;
    z: 10;
    height: 20px;
    opacity: WindowBridge.topbar-hover ? 1.0 : 0.0;

    animate opacity {
        delay: 200ms;
        duration: 200ms;
        easing: ease;
    }

    HorizontalLayout {
        padding-top: 7px;
        padding-right: 8px;
        height: 28px;
        alignment: end;
        spacing: 12px;

        IconButton {
            width: 20px;
            height: 20px;
            inner-bg: transparent;
            enabled: WindowBridge.topbar-hover;
            SvgIcon {
                source: @image-url("icons/minimize.svg");
                fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.secondary-font;
                size: 16px;
            }

            clicked => {
                WindowBridge.minimize-window();
            }
        }

        IconButton {
            width: 20px;
            height: 20px;
            inner-bg: transparent;
            enabled: WindowBridge.topbar-hover;
            SvgIcon {
                source: @image-url("icons/maximize.svg");
                fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.secondary-font;
                size: 16px;
            }

            clicked => {
                WindowBridge.maximize-window();
            }
        }

        IconButton {
            width: 20px;
            height: 20px;
            inner-bg: transparent;
            enabled: WindowBridge.topbar-hover;
            SvgIcon {
                source: @image-url("icons/close.svg");
                fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.secondary-font;
                size: 16px;
            }

            clicked => {
                WindowBridge.close-window();
            }
        }
    }
}


export component NectanWindow inherits Window {

    title: "Nectan";
    preferred-width: 1128px;
    preferred-height: 720px;
    min-width: 400px;
    min-height: 200px;
    default-font-family: Theme.font-body;
    resize-border-width: 8px;

    no-frame: true;
    background: transparent;
    maximized: true;

    callback pasted();

    ThemeAnimator { }

    forward-focus: focus-scope;

    focus-scope := FocusScope {
        focus-on-click: true;
        width: 100%;
        height: 100%;

        init => {
            self.focus();
        }

        KeyBinding {
            keys: @keys(Slash);
            activated => { SearchBridge.open = true; }
        }

        KeyBinding {
            keys: @keys(Shift + A);
            activated => { AddDeviceBridge.open = true; }
        }

        KeyBinding {
            keys: @keys(F11);
            activated => { root.maximized = !root.maximized; }
        }

        KeyBinding {
            keys: @keys(E);
            activated => {
                sidebar.essentials();
            }
        }

        key-pressed(event) => {
            if (event.modifiers.control || event.modifiers.meta) {
                if (event.text == Key.S) {
                    WindowBridge.sidebar-visible = !WindowBridge.sidebar-visible;
                    WindowBridge.sidebar-hover = false;
                    return accept;
                }
                if (event.text == Key.V) {
                    pasted();
                    return accept;
                }
                if (event.text == Key.K) {
                    SearchBridge.open = !SearchBridge.open;
                    return accept;
                }
                if (event.text == Key.I) {
                    SettingsBridge.open = true;
                    return accept;
                }
                if (event.text == Key.T) {
                    WindowBridge.current-window = Window.transfers;
                    return accept;
                }
            }
            return reject;
        }

        MainWindowTouchArea { }

        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.colors.primary-col;
            border-color: Theme.colors.fourth-col;
            border-width: root.maximized ? 0 : 1px;
            border-radius: root.maximized ? 0 : 12px;

            clip: true;

            TopBarShower { }

            SidebarShower { }

            sidebar := Sidebar { }

            Topbar { }

            HorizontalLayout {
                spacing: 8px;
                padding: 8px;
                padding-top: WindowBridge.topbar-hover ? 24px : 8px;
                padding-left: !WindowBridge.sidebar-visible ? 8px : WindowBridge.sidebar-width;

                animate x, padding-left {
                    duration: 128ms;
                    easing: ease;
                }

                animate padding-top {
                    delay: 200ms;
                    duration: 128ms;
                    easing: ease;
                }

                Rectangle {
                    background: Theme.colors.secondary-col;
                    border-radius: 8px;

                    if WindowBridge.current-window == Window.device: DeviceScreen { }

                    if WindowBridge.current-window == Window.transfers: Transfers { }

                    if WindowBridge.current-window == Window.vaults: Explorer { }

                    if Theme.theme-selector: ThemeSelector { }
                }
            }
        }

        property <bool> any-modal-open: SettingsBridge.open
            || WindowBridge.nectan-modal-open
            || AddDeviceBridge.open
            || SearchBridge.open
            || OutcomingTransferModalBridge.open
            || IncomingTransferOfferBridge.open
            || WindowBridge.welcome-open
            || Error.open
            || Theme.theme-selector;

        changed any-modal-open => {
            if !any-modal-open {
                focus-scope.focus();
            }
            WindowBridge.any-modal-open = any-modal-open;
        }

        if SettingsBridge.open: Settings { }

        if WindowBridge.nectan-modal-open: NectanModal { }

        if OutcomingTransferModalBridge.open: OutcomingTransferModal { }

        if IncomingTransferOfferBridge.open: IncomingTransferOfferModal { }

        if AddDeviceBridge.open:  AddDeviceModal { }

        if SearchBridge.open: Search { }

        if ExplorerBridge.searching: SearchExplorer { }

        if Error.open: ErrorModal { }

        if WindowBridge.welcome-open: WelcomeScreen {
            border-radius: root.maximized ? 0 : 12px;
        }
    }
}
