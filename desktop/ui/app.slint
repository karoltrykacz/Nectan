import { Theme } from "theme.slint";
import {
    IconButton,
    SvgIcon,
    PrimaryButton,
    GeneralModal,
} from "elements.slint";
import { ListView } from "std-widgets.slint";
import { SettingsBridge, SettingsModal } from "settings.slint";
import { TransfersBridge, Transfers, TransferItem } from "transfers.slint";
import { MainBody, WindowBridge, TabDragGhost } from "tabs.slint";
import {
    AddRemoteDeviceModal,
    AddDeviceBridge,
    ConnectionOfferBridge,
    ConnectionOfferModal,
} from "add_remote_modal.slint";
import { ErrorModal } from "error_modal.slint";
import { DeviceItem, DevicesBridge } from "devices.slint";
import { TreeNode, TreeList } from "path_tree.slint";
import {
    IncomingTransferOfferModal,
    IncomingTransferOfferBridge,
    OutcomingTransferModal,
    OutcomingTransferModalBridge,
} from "transfer_offer_modal.slint";

export {
    DeviceItem,
    WindowBridge,
    AddDeviceBridge,
    TransferItem,
    DevicesBridge,
    TransfersBridge,
    ConnectionOfferBridge,
    IncomingTransferOfferBridge,
    OutcomingTransferModalBridge,
}
export component NectanWindow inherits Window {
    no-frame: true;
    background: transparent;
    title: "Nectan";
    preferred-width: 1128px;
    preferred-height: 720px;
    min-width: 400px;
    min-height: 200px;
    max-width: 20050px;
    max-height: 20050px;
    default-font-family: Theme.font-body;
    resize-border-width: 8px;

    in-out property <bool> error_open: false;
    in-out property <string> error_title: "";
    in-out property <string> error_message: "";
    callback show-error(string, string);
    callback close-error();

    show-error(title, message) => {
        root.error_open = true;
        root.error_message = message;
        root.error_title = title;
    }

    forward-focus: focus-scope;

    focus-scope := FocusScope {
        width: 100%;
        height: 100%;

        init => {
            self.focus();
        }

        key-pressed(event) => {
	    // Toggle sidebar
            if (event.text == "b"
                && (event.modifiers.control || event.modifiers.meta)) {
                WindowBridge.sidebar-visible = !WindowBridge.sidebar-visible;
                return accept;
            }
            return reject;
        }

        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.colors.primary-col;
            border-width: 1px;
            border-color: #FFFFFF1B;
            border-radius: 8px;
            clip: true;

            MainBody { }

            AddRemoteDeviceModal { }

            if SettingsBridge.settings_open: SettingsModal { }

            if ConnectionOfferBridge.open: ConnectionOfferModal { }

            if OutcomingTransferModalBridge.sending-open: OutcomingTransferModal { }

            if IncomingTransferOfferBridge.is-open: IncomingTransferOfferModal { }

            if root.error_open: ErrorModal {
                open: root.error_open;
                title: root.error_title;
                message: root.error_message;

                closed => {
                    root.error_open = false;
                }
            }

            TabDragGhost { }
        }
    }
}
