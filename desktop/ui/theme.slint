export component ThemeAnimator inherits Rectangle {

    property <color> p-primary-col: Theme.target.primary-col;
    property <color> p-secondary-col: Theme.target.secondary-col;
    property <color> p-third-col: Theme.target.third-col;
    property <color> p-fourth-col: Theme.target.fourth-col;
    property <color> p-primary-font: Theme.target.primary-font;
    property <color> p-secondary-font: Theme.target.secondary-font;
    property <color> p-third-font: Theme.target.third-font;
    property <color> p-fourth-font: Theme.target.fourth-font;
    property <color> p-hover-col: Theme.target.hover-col;
    property <color> p-border-col: Theme.target.border-col;

    animate p-primary-col, p-secondary-col, p-third-col, p-fourth-col, p-primary-font, p-secondary-font, p-third-font, p-fourth-font, p-hover-col, p-border-col {
        duration: 250ms;
        easing: ease-in-out;
    }

    changed p-primary-col => { Theme.a-primary-col = root.p-primary-col; }
    changed p-secondary-col => { Theme.a-secondary-col = root.p-secondary-col; }
    changed p-third-col => { Theme.a-third-col = root.p-third-col; }
    changed p-fourth-col => { Theme.a-fourth-col = root.p-fourth-col; }
    changed p-primary-font => { Theme.a-primary-font = root.p-primary-font; }
    changed p-secondary-font => { Theme.a-secondary-font = root.p-secondary-font; }
    changed p-third-font => { Theme.a-third-font = root.p-third-font; }
    changed p-fourth-font => { Theme.a-fourth-font = root.p-fourth-font; }
    changed p-hover-col => { Theme.a-hover-col = root.p-hover-col; }
    changed p-border-col => { Theme.a-border-col = root.p-border-col; }
}
