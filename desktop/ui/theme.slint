    out property <ThemeColors> target: root.themes[root.mode].colors;

    in-out property <color> a-primary-col: root.target.primary-col;
    in-out property <color> a-secondary-col: root.target.secondary-col;
    in-out property <color> a-third-col: root.target.third-col;
    in-out property <color> a-fourth-col: root.target.fourth-col;
    in-out property <color> a-primary-font: root.target.primary-font;
    in-out property <color> a-secondary-font: root.target.secondary-font;
    in-out property <color> a-third-font: root.target.third-font;
    in-out property <color> a-fourth-font: root.target.fourth-font;
    in-out property <color> a-hover-col: root.target.hover-col;
    in-out property <color> a-border-col: root.target.border-col;

    out property <ThemeColors> colors: {
        primary-col: root.a-primary-col,
        secondary-col: root.a-secondary-col,
        third-col: root.a-third-col,
        fourth-col: root.a-fourth-col,
        primary-font: root.a-primary-font,
        secondary-font: root.a-secondary-font,
        third-font: root.a-third-font,
        fourth-font: root.a-fourth-font,
        hover-col: root.a-hover-col,
        border-col: root.a-border-col,
    };
