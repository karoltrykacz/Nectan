export struct ThemeColors {
    primary-col: color,
    secondary-col: color,
    third-col: color,
    fourth-col: color,
    primary-font: color,
    secondary-font: color,
    third-font: color,
    fourth-font: color,
    hover-col: color,
    border-col: color,
}

export struct ThemeDef {
    code: string,
    name: string,
    colors: ThemeColors,
}

export global Theme {
    in-out property <int> mode: 0;
    in-out property <bool> theme-selector;

    out property <string> font-heading: "Rubik";
    out property <string> font-body: "Inter";

    callback mode-changed(int);

    public function set-mode(idx: int) {
        root.mode = idx;
        root.mode-changed(idx);
    }

