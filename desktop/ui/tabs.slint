import { Theme } from "theme.slint";
import { IconButton, SvgIcon, Spinner, PrimaryButton } from "elements.slint";
import { Transfers } from "transfers.slint";
import { SettingsBridge } from "settings.slint";
import { DeviceRow, DeviceScreen, DevicesBridge } from "devices.slint";

// Containers, search
export enum selected-window { transfers, device, vpn }
export struct NectanTab { display: string, id: int, kind: selected-window, ref-id: int }

export global WindowBridge {
    callback reorder-requested(int, int);
    callback close-requested(int);

    callback open-tab(selected-window, int, string);

    in-out property <[NectanTab]> tabs: [];
    in-out property <int> current-tab: 0;

    in-out property <bool> is-dragging: false;
    in-out property <length> ghost-x: 0px;
    in-out property <length> ghost-y: 0px;
    in-out property <string> dragging-title: "";

    in-out property <bool> sidebar-visible: true;
    in-out property <length> sidebar-width: 200px;

    in-out property <selected-window> current-window: transfers;

    in-out property <int> current-ref-id: 0;

    callback drag-window();

    callback minimize-window();
    callback maximize-window();
    callback close-window();
}

export component Tabs inherits Rectangle {
    horizontal-stretch: 1;
    clip: true;
    property <int> active-drag-idx: -1;
    property <length> press-start-x: 0px;
    property <length> press-start-y: 0px;
    property <length> drag-start-offset-x: 0px;
    property <length> drag-start-offset-y: 0px;
    property <length> drag-threshold: 5px;

    VerticalLayout {
        spacing: 0px;
        padding: 0px;

        Rectangle {
            background: Theme.colors.third-col;
            height: 40px;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 8px;
                padding-top: 8px;
                alignment: start;
                spacing: 5px;

                for tab[idx] in WindowBridge.tabs: Container := Rectangle {
                    horizontal-stretch: 1;
                    min-width: 16px;
                    max-width: tab-content.preferred-width + 42px;
                    height: 32px;

                    tab-touch := TouchArea {
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                WindowBridge.current-tab = idx;
                                WindowBridge.current-window = tab.kind;
                                WindowBridge.current-ref-id = tab.ref-id;
                                root.press-start-x = self.mouse-x;
                                root.press-start-y = self.mouse-y;
                                root.drag-start-offset-x = self.mouse-x;
                                root.drag-start-offset-y = self.mouse-y;
                            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                                if (WindowBridge.is-dragging && root.active-drag-idx == idx) {
                                    WindowBridge.reorder-requested(
                                        idx,
                                        Math.max(0, Math.min(WindowBridge.tabs.length - 1,
                                            Math.round((WindowBridge.ghost-x - (self.absolute-position.x - (idx * Container.width))) / Container.width))));
                                }
                                root.active-drag-idx = -1;
                                WindowBridge.is-dragging = false;
                            }
                        }
                        moved => {
                            if (root.active-drag-idx == -1 && !WindowBridge.is-dragging) {
                                if (Math.abs(self.mouse-x - root.press-start-x) > root.drag-threshold ||
                                    Math.abs(self.mouse-y - root.press-start-y) > root.drag-threshold) {

                                    root.active-drag-idx = idx;
                                    WindowBridge.is-dragging = true;
                                    WindowBridge.dragging-title = tab.display;
                                }
                            }
                            if (WindowBridge.is-dragging && root.active-drag-idx == idx) {
                                WindowBridge.ghost-x = self.absolute-position.x + self.mouse-x - root.drag-start-offset-x;
                                WindowBridge.ghost-y = self.absolute-position.y + self.mouse-y - root.drag-start-offset-y;
                            }
                        }
                    }

                    tab-content := Rectangle {
                        height: 32px;
                        background: WindowBridge.current-tab == idx
                            ? Theme.colors.primary-col
                            : transparent;
                        border-top-left-radius: 10px;
                        border-top-right-radius: 10px;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 4px;
                            spacing: 12px;
                            alignment: space-between;

                            Text {
                                text: tab.display;
                                font-size: 13px;
                                color: WindowBridge.current-tab == idx ? Theme.colors.primary-font
                                    : (tab-touch.has-hover ? Theme.colors.primary-font : Theme.colors.third-font);
                                font-weight: 500;
                                overflow: elide;
                                vertical-alignment: center;
                            }

                            close-btn := TouchArea {
                                width: 22px;
                                height: 22px;

                                clicked => {
                                    WindowBridge.close-requested(idx);
                                }

                                Rectangle {

                                    y: 4px;
                                    border-radius: 6px;
                                    background: close-btn.has-hover ? Theme.colors.third-col : transparent;

                                    Text {
                                        text: "×";
                                        font-size: 18px;
                                        color: close-btn.has-hover ? Theme.colors.primary-font
                                            : (tab-touch.has-hover ? Theme.colors.third-font : transparent);
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        if WindowBridge.current-tab == idx: Rectangle {
                            x: -16px;
                            y: 16px;
                            width: 16px;
                            height: 16px;
                            background: Theme.colors.primary-col;

                            Rectangle {
                                width: 100%;
                                height: 100%;
                                background: Theme.colors.third-col;
                                border-bottom-right-radius: 8px;
                            }
                        }

                        if WindowBridge.current-tab == idx: Rectangle {
                            x: parent.width;
                            y: 16px;
                            width: 16px;
                            height: 16px;
                            background: Theme.colors.primary-col;

                            Rectangle {
                                width: 100%;
                                height: 100%;
                                background: Theme.colors.third-col;
                                border-bottom-left-radius: 8px;
                            }
                        }
                    }
                }
            }
        }
    }
}

export component TabDragGhost {

    if WindowBridge.is-dragging: 
    Rectangle {
        x: WindowBridge.ghost-x - root.absolute-position.x;
        y: WindowBridge.ghost-y - root.absolute-position.y;
        width: 92px;
        height: 36px;

        background: Theme.colors.primary-col;
        border-radius: 10px;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000040;
        opacity: 0.9;

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            alignment: center;

            Text {
                text: WindowBridge.dragging-title;
                font-size: 13px;
                color: Theme.colors.primary-font;
                font-weight: 500;
                vertical-alignment: center;
            }
        }
    }
}

export component MainBody inherits VerticalLayout {

    height: 100%;
    width: 100%;

    // Titlebar
    Rectangle {
        height: 40px;
        background: Theme.colors.third-col;
        TouchArea {

            property <bool> maybe-dragging: false;
            moved => {
                if (self.maybe-dragging) {
                    WindowBridge.drag-window();
                }
            }
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    self.maybe-dragging = true;
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    self.maybe-dragging = false;
                }
            }
        }

        HorizontalLayout {
            // Sidebar toggle
                Rectangle {
                width: 42px;
                height: 42px;

                IconButton {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;

                    width: 28px;
                    height: 28px;

                    SvgIcon {
                        source: @image-url("icons/sidebar.svg");
                        fg: Theme.colors.third-font;
                        size: 18px;
                    }

                    clicked => { WindowBridge.sidebar-visible = !WindowBridge.sidebar-visible; }
                }
            }

            Rectangle {
                width: WindowBridge.sidebar-visible ? WindowBridge.sidebar-width : 0;
                animate width {
                    duration: 75ms;
                    easing: ease;
                }
            }

            Tabs { }

            HorizontalLayout {
                IconButton {
                    width: 40px;
                    height: 40px;
                    round: false;
                    transform: false;
                    SvgIcon {
                        source: @image-url("icons/minimize.svg");
                        fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.third-font;
                        size: 18px;
                    }

                    clicked => {
                        debug("minimize-window");
                        WindowBridge.minimize-window();
                    }
                }

                IconButton {
                    width: 40px;
                    height: 40px;
                    round: false;
                    transform: false;
                    SvgIcon {
                        source: @image-url("icons/maximize.svg");
                        fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.third-font;
                        size: 18px;
                    }

                    clicked => {
                        WindowBridge.maximize-window();
                    }
                }

                IconButton {
                    width: 40px;
                    height: 40px;
                    round: false;
                    transform: false;
                    SvgIcon {
                        source: @image-url("icons/close.svg");
                        fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.third-font;
                        size: 18px;
                    }

                    clicked => {
                        WindowBridge.close-window();
                    }
                }
            }
        }
    }
            // Body
    HorizontalLayout {
        vertical-stretch: 1;
        Rectangle {
            width: 40px;
            background: WindowBridge.sidebar-visible ? Theme.colors.secondary-col : Theme.colors.primary-col;

            animate background {
                duration: 75ms;
                easing: ease;
            }

            VerticalLayout {
                padding-top: 8px;
                padding-bottom: 8px;
                cross-axis-alignment: center;

                IconButton {
                    width: 20px;
                    height: 20px;
                    inner-bg: self.hovered ? Theme.colors.third-font : Theme.colors.primary-font;
                    SvgIcon {
                        source: @image-url("icons/plus.svg");
                        fg: Theme.colors.primary-col;
                        size: 14px;
                    }

                    clicked => {
                        // AddDeviceBridge.add_device_open = true;
                    }
                }

                Rectangle {
                    height: 12px;
                }

                IconButton {
                    width: 28px;
                    height: 28px;
                    SvgIcon {
                        source: @image-url("icons/tranfsers.svg");
                        fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.third-font;
                        size: 18px;
                    }

                    clicked => {
                        debug("Opening transfers");
                        WindowBridge.open-tab(selected-window.transfers, 0, "Transfers");
                    }
                }

                Rectangle {
                    height: 8px;
                }

                IconButton {
                    width: 28px;
                    height: 28px;
                    SvgIcon {
                        source: @image-url("icons/shield.svg");
                        fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.third-font;
                        size: 18px;
                    }

                    clicked => {
                        WindowBridge.open-tab(selected-window.vpn, 0, "VPN");
                    }
                }

                // Rectangle {
                //     height: 8px;
                // }
                //
                // IconButton {
                //     width: 28px;
                //     height: 28px;
                //     SvgIcon {
                //         source: @image-url("icons/archive.svg");
                //         fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.third-font;
                //         size: 16px;
                //     }
                //
                //     clicked => {
                //         WindowBridge.open-tab(selected-window.containers, 0, "Containers");
                //     }
                // }

                Rectangle {
                    vertical-stretch: 1;
                }

                IconButton {
                    width: 28px;
                    height: 28px;
                    SvgIcon {
                        source: @image-url("icons/settings.svg");
                        fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.third-font;
                        size: 18px;
                    }

                    clicked => {
                        SettingsBridge.settings_open = true;
                    }
                }
            }
        }

        Rectangle {
            width: 1px;
            background: Theme.colors.third-col;
        }
                // Sidebar
        Rectangle {
            width: WindowBridge.sidebar-visible ? WindowBridge.sidebar-width : 0px;
            clip: true;
            background: Theme.colors.secondary-col;
            border-width: 1px;
            border-color: Theme.colors.secondary-col;

            animate width {
                duration: 75ms;
                easing: ease;
            }
            VerticalLayout {
                padding: 8px;
                spacing: 4px;
                alignment: start;

                if DevicesBridge.devices.length == 0: Rectangle {
                    height: 50px;
                    Text {
                        text: "No devices";
                        font-weight: 500;
                        font-size: 13px;
                        color: Theme.colors.secondary-font;
                        horizontal-alignment: center;
                    }
                }

                for device[idx] in DevicesBridge.devices: DeviceRow {
                    name: device.name;
                    status: device.status;
                    selected: WindowBridge.current-window == selected-window.device
                        && WindowBridge.current-ref-id == device.id;

                    clicked => {
                        WindowBridge.open-tab(selected-window.device, idx, device.name);
                    }
                }
            }
        }

        if WindowBridge.current-window == selected-window.transfers: Transfers { }
        if WindowBridge.current-window == selected-window.device: DeviceScreen {
            device-idx: WindowBridge.current-ref-id;
        }
    }
}
