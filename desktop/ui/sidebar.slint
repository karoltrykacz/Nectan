import {
    IconButton,
    SvgIcon,
    DragGridTileData,
    DragGrid,
} from "elements.slint";
import { SearchBar } from "search.slint";
import { DeviceItem } from "devices.slint";
import { Window, WindowBridge } from "window.slint";
import { Theme } from "theme.slint";
import { DevicesBridge } from "devices.slint";
import { AddDeviceBridge } from "add_remote_modal.slint";
import { ExplorerBridge } from "explorer.slint";
import { SettingsBridge } from "settings.slint";


export global SidebarBridge {
    in-out property <[DragGridTileData]> essentials;

    in-out property <bool> essentials-select;

    callback reorder(int, int);
    pure callback id-at-slot(int) -> int;
    callback clicked(int);

    callback name();
}

export component SidebarShower inherits Rectangle {
    x: 0;
    z: 1;
    width: WindowBridge.sidebar-visible ? 0 : WindowBridge.sidebar-hover ? WindowBridge.sidebar-width + 60px : 20px;
    sidebar-toggle := TouchArea {
        pointer-event(event) => {
            if self.mouse-x > WindowBridge.sidebar-width {
                WindowBridge.sidebar-hover = false;
            }
            if self.mouse-x < 20px {
                WindowBridge.sidebar-hover = true;
            }
        }
    }
}

component SidebarDevice inherits Rectangle {
    clip: true;

    in property <DeviceItem> device;
    in property <bool> selected: false;

    height: 36px;
    border-radius: 12px;

    background: area.has-hover ? Theme.colors.fourth-col : selected ? Theme.colors.third-col : Theme.colors.secondary-col;

    transform-scale: area.pressed ? 0.98 : 1.0;
    animate transform-scale {
        duration: 25ms;
        easing: ease;
    }

    callback clicked;

    HorizontalLayout {
        padding-left: 12px;
        alignment: start;
        cross-axis-alignment: center;

        // Rectangle {
        //     height: 6px;
        //     width: 6px;
        //     border-radius: 4px;
        //     background: device.status == DeviceStatus.online ? #ff9800 :
        //         (device.status == DeviceStatus.nearby ? #0288d1 : Theme.colors.third-font);
        // }
        //
        // Rectangle {
        //     width: 4px;
        // }

        Text {
            vertical-alignment: center;
            height: root.height;
            text: device.name;
            overflow: elide;
            color: Theme.colors.primary-font;
            font-size: 13px;
            font-weight: 600;
            font-family: Theme.font-heading;
        }
    }

    area := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Sidebar inherits Rectangle {

    background: Theme.colors.primary-col;
    x: WindowBridge.sidebar-visible ? 0 : ((WindowBridge.sidebar-hover || SidebarBridge.essentials-select) ? 0 : -WindowBridge.sidebar-width);
    width: WindowBridge.sidebar-width;
    z: 2;
    border-radius: 8px;
    border-width: 1px;
    border-color: WindowBridge.sidebar-visible ? transparent : Theme.colors.border-col;

    animate x, border-color {
        duration: 128ms;
        easing: ease;
    }

    callback leave();

    property <int> cursor: -1;

    callback essentials();

    essentials => {
        cursor = 4;
        fs.focus();
        SidebarBridge.essentials-select = true;
    }

    pure function count() -> int {
        SidebarBridge.essentials.length
    }

    function move-to(target: int) {
        if target >= 0 && target < count() {
            cursor = target;
        }
    }

    leave => {
        cursor = -1;
        ExplorerBridge.focus();
        SidebarBridge.essentials-select = false;
    }

    forward-focus: fs;

    fs := FocusScope {
        changed has-focus => {
            if !self.has-focus {
                root.cursor = -1;
            }
        }

        key-pressed(event) => {
            if root.cursor < 0 && event.text != Key.Escape {
                return EventResult.accept;
            }
            if event.text == "l" || event.text == Key.RightArrow {
                root.move-to(root.cursor + 1);
                return EventResult.accept;
            }
            if event.text == "h" || event.text == Key.LeftArrow {
                root.move-to(root.cursor - 1);
                return EventResult.accept;
            }
            if event.text == "j" || event.text == Key.DownArrow {
                root.move-to(root.cursor + grid.cols);
                return EventResult.accept;
            }
            if event.text == "k" || event.text == Key.UpArrow {
                root.move-to(root.cursor - grid.cols);
                return EventResult.accept;
            }
            if event.text == Key.Return || event.text == " " {
                SidebarBridge.clicked(SidebarBridge.id-at-slot(root.cursor));
                root.leave();
                return EventResult.accept;
            }
            if event.text == Key.Escape || event.text == "s" {
                root.leave();
                return EventResult.accept;
            }
            root.leave();
            EventResult.reject
        }

        TouchArea {

            property <bool> maybe-dragging: false;

            moved => {
                if (self.maybe-dragging) {
                    WindowBridge.drag-window();
                }
            }
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    self.maybe-dragging = true;
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    self.maybe-dragging = false;
                }
            }
        }

        VerticalLayout {
            padding: 8px;
            padding-bottom: 4px;

            HorizontalLayout {
                IconButton {
                    width: 28px;
                    height: 28px;

                    Image {
                        source: @image-url("icons/tray.png");
                        width: 16px;
                        height: 16px;
                    }

                    clicked => {
                        WindowBridge.nectan-modal-open = true;
                    }
                }

                Rectangle { }

                // IconButton {
                //     width: 28px;
                //     height: 28px;
                //
                //     SvgIcon {
                //         source: @image-url("icons/bell.svg");
                //         size: 16px;
                //         fg: parent.hovered ? Theme.colors.secondary-font : Theme.colors.fourth-font;
                //     }
                //
                //     clicked => {
                //         NotificationsBridge.notifications-visible = !NotificationsBridge.notifications-visible;
                //     }
                // }

                IconButton {
                    width: 28px;
                    height: 28px;
                    SvgIcon {
                        source: @image-url("icons/sidebar.svg");
                        fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.third-font;
                        size: 16px;
                    }

                    clicked => {
                        WindowBridge.sidebar-visible = !WindowBridge.sidebar-visible;
                    }
                }
            }

            Rectangle {
                height: 8px;
            }

            SearchBar { }

            Rectangle {
                height: 8px;
            }

            grid := DragGrid {
                gap: 8px;
                min-cell-w: 42px;
                cell-h: 36px;
                tiles: SidebarBridge.essentials;
                highlighted-slot: root.cursor;

                reorder(id, target) => { SidebarBridge.reorder(id, target); }
                id-at-slot(slot) => { return SidebarBridge.id-at-slot(slot); }
                clicked(id) => { SidebarBridge.clicked(id) }
            }

            Rectangle {
                height: 8px;
            }

            GridLayout {

                spacing: 8px;
                Row {

                    IconButton {
                        border-radius: 12px;
                        height: 36px;
                        transform-y: 0;
                        inner-bg: self.hovered ? Theme.colors.fourth-col : Theme.colors.third-col;
                        inner-border: AddDeviceBridge.open ? Theme.colors.fourth-col : transparent;

                        SvgIcon {
                            source: @image-url("icons/link.svg");
                            fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.third-font;
                            size: 16px;
                        }

                        clicked => { AddDeviceBridge.open = true; }
                    }

                    IconButton {
                        border-radius: 12px;
                        height: 36px;
                        inner-bg: self.hovered ? Theme.colors.fourth-col : Theme.colors.third-col;
                        transform-y: 0;
                        inner-border: WindowBridge.current-window == Window.transfers ? Theme.colors.fourth-col : transparent;

                        SvgIcon {
                            source: @image-url("icons/tranfsers.svg");
                            fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.third-font;
                            size: 17px;
                        }

                        clicked => { WindowBridge.current-window = Window.transfers; }
                    }

                    IconButton {
                        border-radius: 12px;
                        height: 36px;
                        inner-bg: self.hovered ? Theme.colors.fourth-col : Theme.colors.third-col;
                        transform-y: 0;
                        inner-border: WindowBridge.current-window == Window.vaults ? Theme.colors.fourth-col : transparent;

                        SvgIcon {
                            source: @image-url("icons/archive.svg");
                            fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.third-font;
                            size: 15px;
                        }

                        clicked => { WindowBridge.current-window = Window.vaults; }
                    }
                }

                // Row {
                //
                //     IconButton {
                //         border-radius: 12px;
                //         height: 36px;
                //         inner-bg: self.hovered ? Theme.colors.fourth-col : Theme.colors.third-col;
                //         transform-y: 0;
                //         SvgIcon {
                //             source: @image-url("icons/search.svg");
                //             fg: parent.hovered ? Theme.colors.secondary-font : Theme.colors.fourth-font;
                //             size: 16px;
                //         }
                //
                //         clicked => { AddDeviceBridge.open = true; }
                //     }
                //
                //     IconButton {
                //         border-radius: 12px;
                //         height: 36px;
                //         inner-bg: self.hovered ? Theme.colors.fourth-col : Theme.colors.third-col;
                //         transform-y: 0;
                //         SvgIcon {
                //             source: @image-url("icons/hard-drive.svg");
                //             fg: parent.hovered ? Theme.colors.secondary-font : Theme.colors.fourth-font;
                //             size: 16px;
                //         }
                //
                //         clicked => { AddDeviceBridge.open = true; }
                //     }
                // }
            }

            Rectangle {
                height: 8px;
            }

            VerticalLayout {
                spacing: 8px;

                for d[i] in DevicesBridge.devices: SidebarDevice {
                    device: d;
                    selected: true;
                    clicked => {
                        DevicesBridge.device-details-open-idx = i;
                        WindowBridge.current-window = Window.device;
                    }
                }

                if DevicesBridge.devices.length == 0: Rectangle {
                    height: 32px;

                    Text {
                        x: 52px;
                        y: 12px;
                        height: root.height;
                        text: "Add first device";
                        color: Theme.colors.primary-font;
                        font-size: 13px;
                        font-weight: 600;
                        font-family: Theme.font-heading;
                    }

                    SvgIcon {
                        x: 20px;
                        source: @image-url("icons/corner-left-up.svg");
                    }
                }
            }

            Rectangle {
                height: 8px;
            }

            HorizontalLayout {
                alignment: space-between;
                IconButton {
                    width: 28px;
                    height: 28px;
                    SvgIcon {
                        source: @image-url("icons/settings.svg");
                        fg: parent.hovered ? Theme.colors.secondary-font : Theme.colors.fourth-font;
                        size: 16px;
                    }

                    clicked => {
                        SettingsBridge.open = true;
                    }
                }
            }

            Rectangle {
                height: 4px;
            }
        }
    }
}
