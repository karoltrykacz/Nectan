                PrimaryButton {
                    text: @tr("Compress");
                    image: @image-url("icons/cpu.svg");
                    button-enabled: root.passwords-match;
                    clicked => { root.compress(); }
                }
            }
        }
    }
}

export component Explorer {

    property <bool> renaming;

    property <string> new-name;

    property <int> focus-tick <=> ExplorerBridge.focus-tick;
    changed focus-tick => { fs.focus(); }

    property <bool> any-modal <=> WindowBridge.any-modal-open;
    changed any-modal => {
        debug("changed");
        if !any-modal {
            fs.focus();
        }
    }

    property <int> cursor;
    property <int> cursor-hover;

    property <Drag> drag;

    property <bool> selecting;
    property <bool> did-select;
    property <length> sel-x0;
    property <length> sel-y0;
    property <length> sel-x1;
    property <length> sel-y1;

    property <int> anchor: -1;

    property <length> target-y: 0px;
    property <bool> pending-g;

    function update-selection() {
        let h = ExplorerBridge.item-height();
        let n = ExplorerBridge.entries.length;
        if n > 0 {
            root.anchor = Math.min(Math.max(Math.floor(root.sel-y0 / h), 0), n - 1);
            root.cursor = Math.min(Math.max(Math.floor(root.sel-y1 / h), 0), n - 1);
        }
    }

    function move-cursor(delta: int) {
        let max-index = ExplorerBridge.entries.length - 1;
        root.cursor = Math.min(Math.max(root.cursor + delta, 0), max-index);
        ensure-visible();
    }

    function move-end() {
        let max-index = ExplorerBridge.entries.length - 1;
        root.cursor = max-index;
        ensure-visible();
    }

    function move-start() {
        root.cursor = 0;
        ensure-visible();
    }

    function ensure-visible() {
        let h = ExplorerBridge.item-height();
        let top = root.cursor * h;
        let bottom = top + h;

        if (top + root.target-y < 0px) {
            root.target-y = -top;
        } else if (bottom + root.target-y > list.height) {
            root.target-y = list.height - bottom;
        }
        list.content-y = root.target-y;
    }

    pure function visible-rows() -> int {
        list.content-height / ExplorerBridge.item-height()
    }

    function open-at(i: int) {
        if (i >= 0 && i < ExplorerBridge.entries.length) {
            ExplorerBridge.open(ExplorerBridge.entries[i], i);
            root.cursor = 0;
        }
        clear-selection();
    }

    function is-selected(idx: int) -> bool {
        if root.anchor != -1 {
            idx >= min(root.anchor, root.cursor) && idx <= max(root.anchor, root.cursor)
        } else {
            root.cursor == idx
        }
    }
    function rename() {
        root.new-name = ExplorerBridge.entries[root.cursor].name;
        root.renaming = true;
    }

    function clear-selection() {
        root.anchor = -1;
    }

    function delete-permanently() {
        ExplorerBridge.delete-items(min(root.anchor, root.cursor), max(root.cursor, root.anchor));
        clear-selection();
    }

    function trash() {
        ExplorerBridge.trash-items(min(root.anchor, root.cursor), max(root.cursor, root.anchor));
        clear-selection();
    }

    function copy() {
        ExplorerBridge.copy(min(root.anchor, root.cursor), max(root.cursor, root.anchor));
        clear-selection();
    }

    function paste() {
        ExplorerBridge.paste();
        clear-selection();
    }

    height: 100%;
    width: 100%;

    VerticalLayout {

        padding-left: 8px;
        padding-right: 0px;
        padding-bottom: 8px;

        TopBar { }

        forward-focus: fs;

        fs := FocusScope {

            init => { self.focus(); }

            KeyBinding {
                keys: Keys.map.delete-permanently.keys;
                activated => { delete-permanently(); }
            }

            KeyBinding {
                keys: Keys.map.delete-permanently.alt-keys;
                activated => { delete-permanently(); }
            }

            KeyBinding {
                keys: Keys.map.trash.keys;
                activated => { trash(); }
            }

            KeyBinding {
                keys: Keys.map.trash.alt-keys;
                activated => { trash(); }
            }

            KeyBinding {
                keys: @keys(Shift + V);
                activated => { anchor = root.cursor; }
            }

            KeyBinding {
                keys: @keys(V);
                activated => { anchor = root.cursor; }
            }

            KeyBinding {
                keys: Keys.map.close.keys;
                activated => {
                    root.anchor = -1;
                }
            }

            KeyBinding {
                keys: Keys.map.close.alt-keys;
                activated => {
                    root.anchor = -1;
                }
            }

            KeyBinding {
                keys: Keys.map.history-back.keys;
                activated => {
                    ExplorerBridge.back();
                }
            }

            KeyBinding {
                keys: Keys.map.history-back.alt-keys;
                activated => {
                    ExplorerBridge.back();
                }
            }

            KeyBinding {
                keys: Keys.map.history-forward.keys;
                activated => {
                    ExplorerBridge.forward();
                }
            }

            KeyBinding {
                keys: Keys.map.history-forward.alt-keys;
                activated => {
                    ExplorerBridge.forward();
                }
            }

            KeyBinding {
                keys: Keys.map.half-page-down.keys;
                activated => {
                    move-cursor(visible-rows() / 2);
                }
            }

            KeyBinding {
                keys: Keys.map.half-page-down.alt-keys;
                activated => {
                    move-cursor(visible-rows() / 2);
                }
            }

            KeyBinding {
                keys: Keys.map.half-page-up.keys;
                activated => {
                    move-cursor(-(visible-rows() / 2));
                }
            }

            KeyBinding {
                keys: Keys.map.half-page-up.alt-keys;
                activated => {
                    move-cursor(-(visible-rows() / 2));
                }
            }

            KeyBinding {
                keys: Keys.map.refresh.keys;
                activated => {
                    ExplorerBridge.refresh();
                }
            }

            KeyBinding {
                keys: Keys.map.refresh.alt-keys;
                activated => {
                    ExplorerBridge.refresh();
                }
            }

            KeyBinding {
                keys: Keys.map.rename.keys;
                activated => { rename(); }
            }

            KeyBinding {
                keys: Keys.map.rename.alt-keys;
                activated => { rename(); }
            }

            KeyBinding {
                keys: Keys.map.move-down.keys;
                activated => {
                    move-cursor(1);
                }
            }

            KeyBinding {
                keys: Keys.map.move-down.alt-keys;
                activated => {
                    move-cursor(1);
                }
            }

            KeyBinding {
                keys: Keys.map.move-up.keys;
                activated => {
                    move-cursor(-1);
                }
            }

            KeyBinding {
                keys: Keys.map.move-up.alt-keys;
                activated => {
                    move-cursor(-1);
                }
            }

            KeyBinding {
                keys: Keys.map.go-inside.keys;
                activated => {
                    root.open-at(root.cursor);
                    clear-selection();
                }
            }

            KeyBinding {
                keys: Keys.map.go-inside.alt-keys;
                activated => {
                    root.open-at(root.cursor);
                    clear-selection();
                }
            }

            KeyBinding {
                keys: Keys.map.go-parent.keys;
                activated => {
                    ExplorerBridge.up();
                    clear-selection();
                }
            }

            KeyBinding {
                keys: Keys.map.go-parent.alt-keys;
                activated => {
                    ExplorerBridge.up();
                    clear-selection();
                }
            }

            KeyBinding {
                keys: Keys.map.find.keys;
                activated => {
                    ExplorerBridge.searching = true;
                }
            }

            KeyBinding {
                keys: Keys.map.find.alt-keys;
                activated => {
                    ExplorerBridge.searching = true;
                }
            }

            KeyBinding {
                keys: Keys.map.ripgrep.keys;
                activated => {
                    ExplorerBridge.ripgrepping = true;
                }
            }

            KeyBinding {
                keys: Keys.map.ripgrep.alt-keys;
                activated => {
                    ExplorerBridge.ripgrepping = true;
                }
            }

            KeyBinding {
                keys: Keys.map.confirm.keys;
                activated => {
                    root.open-at(root.cursor);
                }
            }

            KeyBinding {
                keys: Keys.map.confirm.alt-keys;
                activated => {
                    root.open-at(root.cursor);
                }
            }

            KeyBinding {
                keys: Keys.map.zoom-in.keys;
                activated => { ExplorerBridge.zoom-in(); }
            }

            KeyBinding {
                keys: Keys.map.zoom-in.alt-keys;
                activated => { ExplorerBridge.zoom-in(); }
            }

            KeyBinding {
                keys: Keys.map.zoom-out.keys;
                activated => { ExplorerBridge.zoom-out(); }
            }

            KeyBinding {
                keys: Keys.map.zoom-out.alt-keys;
                activated => { ExplorerBridge.zoom-out(); }
            }

            KeyBinding {
                keys: Keys.map.copy.keys;
                activated => { copy(); }
            }

            KeyBinding {
                keys: Keys.map.copy.alt-keys;
                activated => { copy(); }
            }

            KeyBinding {
                keys: Keys.map.cut.keys;
                activated => {
                    debug("Cut");
                    clear-selection();
                }
            }

            KeyBinding {
                keys: Keys.map.cut.alt-keys;
                activated => {
                    debug("Cut");
                    clear-selection();
                }
            }

            KeyBinding {
                keys: Keys.map.paste.keys;
                activated => {
                    clear-selection();
                    ExplorerBridge.paste();
                }
            }

            KeyBinding {
                keys: Keys.map.paste.alt-keys;
                activated => {
                    clear-selection();
                    ExplorerBridge.paste();
                }
            }

            KeyBinding {
                keys: Keys.map.undo.keys;
                activated => {
                    debug("Undo");
                    clear-selection();
                    // ExplorerBridge.undo(); // or fucking window brdige???
                }
            }

            KeyBinding {
                keys: Keys.map.undo.alt-keys;
                activated => {
                    debug("Undo");
                    clear-selection();
                    // ExplorerBridge.paste();
                }
            }

            KeyBinding {
                keys: Keys.map.redo.keys;
                activated => {
                    debug("Redo");
                    // ExplorerBridge.undo(); // or fucking window brdige???
                }
            }

            KeyBinding {
                keys: Keys.map.redo.alt-keys;
                activated => {
                    debug("Redo");
                    // ExplorerBridge.paste();
                }
            }

            KeyBinding {
                keys: Keys.map.compress.keys;
                activated => {
                    ExplorerBridge.compressing = true;
                }
            }

            KeyBinding {
                keys: Keys.map.compress.alt-keys;
                activated => {
                    ExplorerBridge.compressing = true;
                }
            }

            key-pressed(event) => {
                debug("Explorer event");
                let was-pending-g = root.pending-g;
                root.pending-g = false;
                if event.text == Key.G {
                    if was-pending-g {
                        move-start();
                    } else {
                        root.pending-g = true;
                    }
                    return EventResult.accept;
                }
                if event.text == "G" {
                    move-end();
                    return EventResult.accept;
                }
                EventResult.reject
            }

            ta := TouchArea {
                pointer-event(event) => {
                    let at = Math.floor((-list.content-y + self.mouse-y) / ExplorerBridge.item-height());

                    if event.kind == PointerEventKind.move {
                        cursor-hover = at;

                        if self.pressed {
                            root.sel-x1 = Math.min(Math.max(self.mouse-x, 0px), self.width);
                            root.sel-y1 = Math.min(Math.max(self.mouse-y - list.content-y, 0px), list.content-height);

                            if !root.selecting
                                && (Math.abs((root.sel-x1 - root.sel-x0) / 1px) > 4
                                || Math.abs((root.sel-y1 - root.sel-y0) / 1px) > 4) {
                                root.selecting = true;
                                root.did-select = true;
                            }
                            if root.selecting {
                                update-selection();
                            }
                        }
                    }
                    if event.kind == PointerEventKind.cancel {
                        root.selecting = false;
                    }
                    if event.button == PointerEventButton.right {
                        debug("right click");
                    }
                    if event.button == PointerEventButton.left {
                        if event.kind == PointerEventKind.down {
                            root.sel-x0 = self.mouse-x;
                            root.sel-y0 = self.mouse-y - list.content-y;
                            root.sel-x1 = root.sel-x0;
                            root.sel-y1 = root.sel-y0;
                            root.selecting = false;
                            root.did-select = false;
                        }
                        if event.kind == PointerEventKind.up {
                            root.selecting = false;
                        }
                    }
                }
                clicked => {
                    if !root.did-select {
                        root.open-at(Math.floor((-list.content-y + self.mouse-y) / ExplorerBridge.item-height()));
                    }
                    fs.focus();
                }
            }

            list := ListView {

                for entry[i] in ExplorerBridge.entries: Rectangle {
                    z: 0;
		    // Space for scrollbar
                    width: parent.width - 12px;
                    height: ExplorerBridge.view == View.grid ? ExplorerBridge.grid-height : ExplorerBridge.list-height;
                    background: is-selected(i) ? Theme.colors.fourth-col :
                        cursor-hover == i ? Theme.colors.third-col : transparent;

                    border-radius: 12px;
                    border-corner-shape: superellipse(WindowBridge.edges-shape);

                    transform-scale-y: (ta.pressed && root.cursor-hover == i) ? 0.99 : 1.0;
                    transform-scale-x: (ta.pressed && root.cursor-hover == i) ? 0.998 : 1.0;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        cross-axis-alignment: center;
                        spacing: 8px;

                        if entry.type == EntryType.directory: Image {
                            source: @image-url("icons/folder.svg");
                            height: ExplorerBridge.item-height() - 12px;
                            width: ExplorerBridge.item-height() - 12px;
                            colorize: Theme.colors.fourth-font;
                        }

                        if entry.type == EntryType.file: Image {
                            source: @image-url("icons/file.svg");
                            height: ExplorerBridge.item-height() - 12px;
                            width: ExplorerBridge.item-height() - 12px;
                            colorize: Theme.colors.fourth-font;
                        }

                        Text {
                            text: entry.name;
                            font-size: 11px;
                            color: Theme.colors.primary-font;
                            font-weight: 400;
                        }

                        Rectangle { }

                        if entry.type == EntryType.file: Text {
                            text: entry.size;
                            font-size: 11px;
                            color: Theme.colors.third-font;
                            font-weight: 400;
                        }
                    }
                }
            }

            if root.selecting: Rectangle {
                z: 1;
                x: Math.min(root.sel-x0, root.sel-x1);
                y: Math.min(root.sel-y0, root.sel-y1) + list.content-y;
                width: Math.max(root.sel-x0, root.sel-x1) - Math.min(root.sel-x0, root.sel-x1);
                height: Math.max(root.sel-y0, root.sel-y1) - Math.min(root.sel-y0, root.sel-y1);
                background: Theme.colors.fourth-col.brighter(1.0).with-alpha(0.5);
                border-color: Theme.colors.fourth-font;
                border-width: 1px;
                border-radius: 8px;
            }
        }
    }

    if root.renaming: RenameModal {
        new-name <=> root.new-name;
        selection-end: ExplorerBridge.get-dot-pos(root.cursor);

        on-close => {
            debug("Closed renaming");
            renaming = false;
            fs.focus();
        }
        save => {
            ExplorerBridge.rename(root.cursor, new-name);
            renaming = false;
            fs.focus();
        }
    }

    if ExplorerBridge.compressing: CompressModal {
        on-close => {
            fs.focus();
            ExplorerBridge.compressing = false;
        }
    }
}
