import { Theme } from "theme.slint";
import {
    GeneralModal,
    PlainLineEdit,
    PrimaryButton,
    Spinner,
    Switch,
} from "elements.slint";
import { ListView, ScrollView } from "std-widgets.slint";
import { WindowBridge } from "window.slint";
import { IconButton, SvgIcon } from "elements/pure.slint";
import { Keys } from "keys.slint";
import { SettingsRow } from "settings.slint";

export enum View { grid, list }

export enum EntryType { directory, symlink, file }

export struct DirEntry { name: string, type: EntryType, size: string, preview: image }

export enum Builtin { recent, documents, pictures, videos, downloads, home, music, trash, drives }

export global ExplorerBridge {
    in-out property <string> current-dir;
    in-out property <View> view: View.list;
    in-out property <[DirEntry]> entries;

    in-out property <[string]> search-result;

    in-out property <length> list-height: 32px;
    in-out property <length> grid-height: 48px;

    in-out property <bool> searching;
    in-out property <bool> ripgrepping;
    in-out property <bool> compressing;

    // Dir navigation
    callback open(DirEntry, int);
    callback up();

    // History
    callback forward();
    callback back();

    callback copy(int, int);

    callback cut(int, int);
    callback paste();
    callback delete-items(int, int);
    callback trash-items(int, int);
    callback rename(int, string);
    callback new-folder();
    callback new-file();
    callback refresh();
    callback properties(int);
    callback compress-items(int, int, string, string);

    callback builtin(Builtin);
    pure callback get-dot-pos(int) -> int;

    public pure function item-height() -> length {
        if root.view == View.list {
            root.list-height
        } else {
            root.grid-height
        }
    }

    public function zoom-in() {
        if root.view == View.list {
            root.list-height += 2px;
        } else {
            root.grid-height += 2px;
        }
    }

    public function zoom-out() {
        if root.view == View.list {
            root.list-height -= 2px;
        } else {
            root.grid-height -= 2px;
        }
    }

    in-out property <int> focus-tick;
    public function focus() {
        root.focus-tick += 1;
    }
}


component TopBar inherits HorizontalLayout {
    padding: 12px;
    padding-left: 4px;
    padding-right: 12px;
    cross-axis-alignment: center;

    IconButton {
        width: 28px;
        height: 28px;
        inner-bg: self.hovered ? Theme.colors.third-col : transparent;

        SvgIcon {
            source: @image-url("icons/chevron-left.svg");
            fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.third-font;
            size: 18px;
        }

        clicked => {
            ExplorerBridge.back();
            EventResult.accept
        }
    }

    Rectangle {
        width: 2px;
    }

    IconButton {
        width: 28px;
        height: 28px;
        inner-bg: self.hovered ? Theme.colors.third-col : transparent;

        SvgIcon {
            source: @image-url("icons/chevron-right.svg");
            fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.third-font;
            size: 18px;
        }

        clicked => {
            ExplorerBridge.forward();
        }
    }

    Rectangle {
        width: 12px;
    }

    TextInput {
        text: ExplorerBridge.current-dir;
        selection-background-color: Theme.colors.secondary-font;
        selection-foreground-color: Theme.colors.fourth-col;
        color: Theme.colors.primary-font;
        font-size: 14px;
        font-weight: 500;
        read-only: true;
    }

    Rectangle { }

    IconButton {
        width: 28px;
        height: 28px;
        inner-bg: self.hovered ? Theme.colors.third-col : transparent;

        SvgIcon {
            source: @image-url("icons/search.svg");
            fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.third-font;
            size: 16px;
        }

        clicked => {}
    }

    Rectangle {
        width: 8px;
    }

    IconButton {
        width: 28px;
        height: 28px;
        inner-bg: self.hovered ? Theme.colors.third-col : transparent;

        SvgIcon {
            source: @image-url("icons/filter.svg");
            fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.third-font;
            size: 16px;
        }

        clicked => {}
    }

    Rectangle {
        width: 8px;
    }

    IconButton {
        width: 28px;
        height: 28px;
        inner-bg: self.hovered ? Theme.colors.third-col : transparent;

        SvgIcon {
            source: ExplorerBridge.view == View.grid ? @image-url("icons/grid.svg") : @image-url("icons/list.svg");
            fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.third-font;
            size: 16px;
        }

        clicked => {
            if ExplorerBridge.view == View.grid {
                ExplorerBridge.view = list;
            } else {
                ExplorerBridge.view = grid;
            }
        }
    }
}


struct Drag { x: length, y: length }

component DirectoryIcon inherits Rectangle {

    in property <length> size: 14px;

    i := Image {
        source: @image-url("icons/directory.svg");
        colorize: #f7cb52;
        height: root.size;
    }
}

export component SearchExplorer inherits GeneralModal {

    property <string> query;
    property <bool> scanning: true;

    in-out property <float> split-ratio: 0.575;

    property <length> min-pane-width: 200px;
    property <length> max-content-width: 1070px;
    property <length> handle-width: 20px;

    property <length> available: max(0px, row.width - 80px - handle-width);
    property <length> content-w: min(max-content-width, available);
    property <length> left-w: content-w * split-ratio;
    property <length> right-w: content-w * (1 - split-ratio);
    property <length> panel-h: min(512px, row.height - 80px);

    property <float> min-ratio: min(0.5, min-pane-width / max(content-w, 1px));
    property <float> max-ratio: 1 - min-ratio;

    init => { self.focus(); }

    on-close => {
        close();
    }
    on-enter => {
        close();
    }

    function close() {
        ExplorerBridge.searching = false;
        ExplorerBridge.focus();
    }

    Timer {
        running: scanning;
        interval: 600ms;
        triggered => {
            scanning = false;
        }
    }

    row := HorizontalLayout {
        spacing: 0px;
        alignment: center;
        cross-axis-alignment: center;

        Rectangle {
            height: root.panel-h;
            width: root.left-w;
            drop-shadow-color: #00000099;
            drop-shadow-blur: 28px;
            background: Theme.colors.primary-col;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.colors.border-col;
            clip: true;

            TouchArea {
                width: 100%;
                height: 100%;
                clicked => {}
            }

            VerticalLayout {
                padding: 20px;
                padding-top: 14px;

                HorizontalLayout {
                    Text {
                        text: @tr("Searching in {}", ExplorerBridge.current-dir);
                        font-size: 16px;
                        color: Theme.colors.primary-font;
                        font-weight: 500;
                        overflow: elide;
                    }

                    if root.scanning: Spinner { }
                }

                Text {
                    cross-axis-self-alignment: end;
                    width: 60px;
                    text: "0 / 123 ";
                }

                Rectangle {
                    border-radius: 8px;
                    background: Theme.colors.third-col;
                    height: 32px;

                    le := PlainLineEdit {
                        input-text <=> query;
                        accepted => { close(); }
                    }
                }
            }
        }

        Rectangle {
            width: root.handle-width;
            height: root.panel-h;

            Rectangle {
                width: 2px;
                height: 20px;
                border-radius: 2px;
                background: handle-area.pressed ? Theme.colors.primary-font
                    : handle-area.has-hover ? Theme.colors.primary-font.with-alpha(0.6)
                    : Theme.colors.border-col;
                animate background { duration: 120ms; }
            }

            handle-area := TouchArea {
                mouse-cursor: MouseCursor.col-resize;

                property <length> start-x;

                pointer-event(event) => {
                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                        self.start-x = self.mouse-x;
                    }
                }

                moved => {
                    if (self.pressed) {
                        root.split-ratio = max(root.min-ratio, min(root.max-ratio,
                            root.split-ratio + (self.mouse-x - self.start-x) / max(root.content-w, 1px)));
                    }
                }

                double-clicked => {
                    root.split-ratio = 0.55;
                }
            }
        }

        Rectangle {
            height: root.panel-h;
            width: root.right-w;
            drop-shadow-color: #00000099;
            drop-shadow-blur: 28px;
            background: Theme.colors.primary-col;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.colors.border-col;
            clip: true;
        }
    }
}

component RenameModal inherits GeneralModal {
    in property <int> selection-end;

    init => { self.focus(); }

    in-out property <string> new-name;
    callback save();
    callback close();

    on-enter => { root.save(); }

    Rectangle {

        height: min(196px, parent.height - 80px);
        width: min(512px, parent.width - 80px);
        drop-shadow-color: #00000099;
        drop-shadow-blur: 28px;
        background: Theme.colors.primary-col;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.colors.border-col;
        clip: true;

        TouchArea {
            clicked => {}
        }

        VerticalLayout {
            padding: 20px;
            padding-top: 14px;

            Text {
                text: @tr("Rename");
                font-size: 20px;
                color: Theme.colors.primary-font;
                font-weight: 600;
            }

            Rectangle { }

            Rectangle {

                border-radius: 8px;
                background: Theme.colors.third-col;
                border-corner-shape: superellipse(WindowBridge.edges-shape);

                le := PlainLineEdit {
                    input-text <=> new-name;
                    start: 0;
                    end: root.selection-end;

                    accepted => {
                        root.save();
                    }
                }
            }

            Rectangle { }

            HorizontalLayout {
                alignment: end;
                PrimaryButton {
                    text: @tr("Cancel");
                    alt: true;
                    clicked => {
                        root.close();
                    }
                }

                Rectangle {
                    width: 12px;
                }

                PrimaryButton {
                    text: @tr("Save");
                    image: @image-url("icons/save.svg");
                    clicked => { save(); }
                }
            }
        }
    }
}

