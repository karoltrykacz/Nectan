component Appearance inherits SettingsPage {
    title: @tr("Appearance");
    row-count: 5;

    SettingsRow {
        title: @tr("Theme");
        subtitle: Theme.themes[Theme.mode].name;
        PrimaryButton {
            text: @tr("Change");
            clicked => {
                Theme.theme-selector = true;
                SettingsBridge.open = false;
            }
        }
    }

    Rectangle {
        height: 1px;
        background: Theme.colors.fourth-col.with-alpha(0.5);
    }

    SettingsRow {

        title: @tr("Font");
        subtitle: Theme.config.font;

        HorizontalLayout {
            spacing: 12px;
            cross-axis-alignment: center;

            if Theme.config.font != "Rubik": IconButton {
                width: 28px;
                height: 28px;
                SvgIcon {
                    source: Icons.refresh;
                    fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.third-font;
                    size: 16px;
                }

                clicked => { Theme.config.font = "Rubik"; Theme.config-changed(); }
            }
            PrimaryButton {
                text: @tr("Change");
                clicked => {
                    SettingsBridge.font-modal = true;
                }
            }
        }
    }

    Rectangle {
        height: 1px;
        background: Theme.colors.fourth-col.with-alpha(0.5);
    }

    SettingsRow {
        idx: 2;
        title: @tr("Font scaling");
        subtitle: @tr("Change font scale factor");

        HorizontalLayout {
            spacing: 12px;
            cross-axis-alignment: center;

            if Theme.config.font-scale != 1.0: IconButton {
                width: 28px;
                height: 28px;
                SvgIcon {
                    source: Icons.refresh;
                    fg: parent.hovered ? Theme.colors.primary-font : Theme.colors.third-font;
                    size: 16px;
                }

                clicked => { Theme.config.font-scale = 1.0; font-factor.value = 1.0; Theme.config-changed(); }
            }

            font-factor := Slider {
                width: 100px;
                minimum: 0.75;
                maximum: 1.5;
                value <=> Theme.config.font-scale;
                released => {
                    Theme.config-changed();
                }
            }
        }
    }

    Rectangle {
        height: 1px;
        background: Theme.colors.fourth-col.with-alpha(0.5);
    }

    SettingsRow {
        idx: 1;
        title: @tr("Window edges rounded");
        subtitle: @tr("Round window edges");

        HorizontalLayout {
            spacing: 24px;
            cross-axis-alignment: center;
            Switch {
                checked <=> Theme.config.round-edges;
                toggled => {
                    Theme.config-changed();
                }
            }
        }
    }

    Rectangle {
        height: 1px;
        background: Theme.colors.fourth-col.with-alpha(0.5);
    }

    SettingsRow {
        idx: 2;
        title: @tr("Edges shape");
        subtitle: @tr("Change edges shape");
        Slider {
            width: 100px;
            value <=> Theme.config.edges-shape;
            minimum: 1.0;
            maximum: 5.0;
            released => {
                Theme.config-changed();
            }
        }
    }

    Rectangle {
        height: 1px;
        background: Theme.colors.fourth-col.with-alpha(0.5);
    }

    SettingsRow {
        idx: 3;
        title: @tr("Native topbar");
        subtitle: @tr("Use native window decorations.");
        Switch {
            checked <=> Theme.config.native-topbar;
            toggled => { Theme.config-changed() }
        }
    }

    Rectangle {
        height: 1px;
        background: Theme.colors.fourth-col.with-alpha(0.5);
    }

    SettingsRow {
        idx: 4;
        title: @tr("Topbar always on");
        subtitle: @tr("Don't hide topbar");

        Switch {
            checked <=> Theme.config.topbar-always-on;
            toggled => { Theme.config-changed() }
        }
    }
}



export component Settings inherits GeneralModal {

    on-close => { SettingsBridge.open = false; }

    forward-focus: fs;

    fs := FocusScope {
        init => { self.focus(); }

        KeyBinding {
            keys: @keys(H);
            activated => { SettingsBridge.previous-tab() }
        }

        KeyBinding {
            keys: @keys(L);
            activated => { SettingsBridge.next-tab() }
        }

        KeyBinding {
            keys: @keys(Tab);
            activated => { SettingsBridge.next-tab() }
        }

        KeyBinding {
            keys: @keys(RightArrow);
            activated => { SettingsBridge.next-tab() }
        }

        KeyBinding {
            keys: @keys(LeftArrow);
            activated => { SettingsBridge.previous-tab() }
        }

        TouchArea {
            clicked => { SettingsBridge.open = false; }
        }

        Rectangle {
            width: min(920px, parent.width - 240px);
            height: min(620px, parent.height - 160px);
            clip: true;

            background: Theme.colors.primary-col;
            border-radius: 20px;
            border-corner-shape: superellipse(Theme.config.edges-shape);
            border-width: 1px;
            border-color: Theme.colors.fourth-col.with-alpha(0.5);

            drop-shadow-color: #00000099;
            drop-shadow-blur: 50px;

            TouchArea { }

            HorizontalLayout {

                VerticalLayout {
                    width: 196px;
                    padding: 8px;
                    spacing: 2px;

                    SettingsTab {
                        tab-name: @tr("General");
                        icon-size: 14px;
                        icon: Icons.settings;
                    }

                    SettingsTab {
                        tab-idx: 1;
                        tab-name: @tr("Transfers");
                        icon-size: 14px;
                        icon: Icons.transfers;
                    }

                    SettingsTab {
                        tab-idx: 2;
                        tab-name: @tr("Notifications");
                        icon-size: 14px;
                        icon: Icons.bell;
                    }

                    SettingsTab {
                        tab-idx: 3;
                        tab-name: @tr("Appearance");
                        icon-size: 14px;
                        icon: Icons.palette;
                    }
                }

                Rectangle {
                    width: 1px;
                    background: Theme.colors.fourth-col.with-alpha(0.5);
                }

                if SettingsBridge.active-tab == 0: General { }

                if SettingsBridge.active-tab == 1: Transfers { }

                if SettingsBridge.active-tab == 2: Notifications { }

                if SettingsBridge.active-tab == 3: Appearance { }
            }
        }

        if SettingsBridge.username-modal: ChangeUsernameModal {
            restore-focus => { fs.focus(); }
        }

        if SettingsBridge.font-modal: FontModal {
            restore-focus => { fs.focus(); }
        }

        if SettingsBridge.speed-limits-config: SpeedLimitsConfig {
            restore-focus => { fs.focus(); }
        }
    }
}
