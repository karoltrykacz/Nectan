import { GeneralModal, PrimaryButton } from "../../shared/elements.slint";
import { Theme } from "../../shared/theme.slint";
import {
    OutcomingTransferModalBridge,
} from "../../shared/transfer_offer_modal.slint";
import { WindowBridge } from "../../shared/window.slint";
import { Theme } from "../../shared/theme.slint";
import { Icons } from "../../shared/icons.slint";

export global SenderWindow {
    in-out property <bool> send-type-modal;
    in-out property <bool> error-modal;
}

component Buttons inherits VerticalLayout {
    spacing: 4px;
    alignment: center;
    cross-axis-alignment: center;

    PrimaryButton {
        width: 142px;
        text: @tr("Folder");
        image: Icons.directory;
        clicked => {
            OutcomingTransferModalBridge.select-folders();
        }
    }

    PrimaryButton {
        width: 142px;
        text: @tr("Files");
        image: Icons.file;
        clicked => {
            OutcomingTransferModalBridge.select-files();
        }
    }

    PrimaryButton {
        width: 142px;
        text: @tr("Clipboard");
        image: Icons.clipboard;
        clicked => {
            OutcomingTransferModalBridge.select-files();
        }
    }

    PrimaryButton {
        width: 142px;
        text: @tr("Text");
        image: Icons.text;
        clicked => {
            OutcomingTransferModalBridge.select-files();
        }
    }
}

export component SelectTypeModal inherits GeneralModal {

    on-close => { SenderWindow.send-type-modal = false; }

    init => { root.focus(); }

    TouchArea {
        clicked => { SenderWindow.send-type-modal = false; }
    }

    Rectangle {
        width: min(520px, parent.width * 0.8);
        height: min(296px, parent.height * 0.8);

        background: Theme.colors.primary-col;
        border-radius: 24px;
        border-width: 1px;
        border-corner-shape: superellipse(WindowBridge.edges-shape);
        border-color: Theme.colors.third-col;
        clip: true;

        VerticalLayout {
            padding-top: 16px;
            padding: 20px;

            Text {
                text: @tr("Selection");
                font-size: 20px;
                font-weight: 600;
            }

            Buttons { }
        }
    }
}
