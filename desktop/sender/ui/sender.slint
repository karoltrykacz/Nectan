import {
    GeneralModal,
    PrimaryButton,
    SvgIcon,
} from "../../shared/elements.slint";
import { Theme } from "../../shared/theme.slint";
import {
    OutcomingTransferModalBridge,
} from "../../shared/transfer_offer_modal.slint";
import { WindowBridge } from "../../shared/window.slint";
import { Theme } from "../../shared/theme.slint";
import { Icons } from "../../shared/icons.slint";
import {
    DeviceStatus,
    DeviceItem,
    DeviceFolder,
} from "../../shared/devices.slint";
import { HorizontalBox } from "std-widgets.slint";

export global SenderWindow {
    in-out property <bool> send-modal;
    in-out property <DeviceItem> send-to;
    in-out property <bool> error-modal;

    in property <[DeviceFolder]> folders;
}

component Buttons inherits VerticalLayout {

    spacing: 4px;
    alignment: center;
    cross-axis-alignment: center;

    function send() {
        SenderWindow.send-modal = false;
        OutcomingTransferModalBridge.sending-destination-name = SenderWindow.send-to.name;
        OutcomingTransferModalBridge.sending-destination-id = SenderWindow.send-to.id;
    }

    PrimaryButton {
        width: 142px;
        text: @tr("Folder");
        image: Icons.directory;
        clicked => {
            OutcomingTransferModalBridge.select-folders();
            send();
        }
    }

    PrimaryButton {
        width: 142px;
        text: @tr("Files");
        image: Icons.file;
        clicked => {
            OutcomingTransferModalBridge.select-files();
            send();
        }
    }

    PrimaryButton {
        width: 142px;
        text: @tr("Clipboard");
        image: Icons.clipboard;
        clicked => {
            OutcomingTransferModalBridge.select-clipboard();
            send();
        }
    }

    PrimaryButton {
        width: 142px;
        text: @tr("Text");
        image: Icons.text;
        clicked => {
            OutcomingTransferModalBridge.text-message-open = true;
            send();
        }
    }
}

export component SelectTypeModal inherits GeneralModal {

    on-close => { SenderWindow.send-modal = false; }

    init => { root.focus(); }

    TouchArea {
        clicked => { SenderWindow.send-modal = false; }
    }

    if SenderWindow.send-to.status != DeviceStatus.offline: Rectangle {
        width: min(520px, parent.width * 0.8);
        height: min(296px, parent.height * 0.8);

        background: Theme.colors.primary-col;
        border-radius: 24px;
        border-width: 1px;
        border-corner-shape: superellipse(Theme.config.edges-shape);
        border-color: Theme.colors.third-col;
        clip: true;

        TouchArea { }

        VerticalLayout {
            padding-top: 16px;
            padding: 20px;

            Text {
                text: @tr("Select ");
                font-size: 1.5rem;
                font-weight: 600;
            }

            HorizontalLayout {
                alignment: start;

                Text {
                    text: @tr("You are sending to ");
                    font-size: 1rem;
                    font-weight: 400;
                }

                Text {
                    text: SenderWindow.send-to.name;
                    font-size: 1rem;
                    font-weight: 500;
                }
            }

            Buttons { }
        }
    }

    if SenderWindow.send-to.status == DeviceStatus.offline: Rectangle {
        width: min(520px, parent.width * 0.8);
        height: min(296px, parent.height * 0.8);

        background: Theme.colors.primary-col;
        border-radius: 24px;
        border-width: 1px;
        border-corner-shape: superellipse(Theme.config.edges-shape);
        border-color: Theme.colors.third-col;
        clip: true;

        VerticalLayout {
            cross-axis-alignment: center;
            padding-top: 16px;
            padding: 20px;
            alignment: center;

            Text {
                text: @tr("{} is offline", SenderWindow.send-to.name);
                font-size: 1.5rem;
                font-weight: 600;
                color: Theme.colors.primary-font;
            }

            Rectangle {
                height: 2px;
            }

            Text {
                text: @tr("Make sure device is reachable and try again");
                color: Theme.colors.primary-font;
                font-size: 1rem;
                font-weight: 400;
            }

            Rectangle {
                height: 40px;
            }

            SvgIcon {
                size: 32px;
                source: Icons.offline;
            }

            Rectangle {
                height: 40px;
            }

            PrimaryButton {
                text: @tr("Ok");
                clicked => { SenderWindow.send-modal = false; }
            }
        }
    }
}
