import {
    IconButton,
    SvgIcon,
    ContextMenuItem,
    ContextMenuSeparator,
    ContextMenu,
    SearchBar,
} from "../../shared/elements.slint";
import { Theme } from "../../shared/theme.slint";
import { WindowBridge } from "../../shared/window.slint";
import { Icons } from "../../shared/icons.slint";
import { NotificationsBridge } from "../../shared/notifications.slint";
import { AddDeviceBridge } from "../../shared/add_remote_modal.slint";
import { SenderWindow } from "sender.slint";
import { SettingsBridge } from "settings.slint";
import {
    DeviceItem,
    DevicesBridge,
    DeviceFolder,
    DeviceStatus,
    DeviceRow,
} from "../../shared/devices.slint";
import {
    VerticalBox,
    ListView,
    ScrollView,
    HorizontalBox,
} from "std-widgets.slint";
import { HoverBridge } from "../../shared/hover.slint";
import {
    OutcomingTransferModalBridge,
} from "../../shared/transfer_offer_modal.slint";

export global SidebarBridge {
    pure callback drag-device(string) -> data-transfer;
    pure callback data-transfer-to-id(data-transfer) -> string;

    in-out property <bool> device-settings-open;
    in-out property <DeviceItem> device-settings;
}

component SidebarDevice inherits Rectangle {

    in property <DeviceItem> device;
    property <bool> hover: HoverBridge.hovering;
    property <bool> is-hovered: HoverBridge.is-hovered(root.absolute-position, root.width, root.height);

    changed hover => {
        if (is-hovered) {
            OutcomingTransferModalBridge.sending-destination-name = device.name;
            OutcomingTransferModalBridge.sending-destination-id = device.id;
            HoverBridge.dropped(device.id);
        }
    }

    clip: true;
    height: 36px;
    border-radius: 16px;
    border-corner-shape: superellipse(Theme.config.edges-shape);
    background: root.is-hovered ? Theme.colors.fourth-font : HoverBridge.hovering ? Theme.colors.fourth-col : area.has-hover ? Theme.colors.fourth-col : Theme.colors.third-col;
    transform-scale: area.pressed ? 0.98 : 1.0;

    animate transform-scale {
        duration: 25ms;
        easing: cubic-bezier(0.06,0.76,0.09,0.98);
    }

    drag := DragArea {
        data: SidebarBridge.drag-device(device.id);
        allow-copy: true;
        allow-move: true;
        allow-link: true;

        VerticalLayout {
            padding-left: 12px;
            alignment: center;

            Text {
                text: device.name;
                overflow: elide;
                color: Theme.colors.primary-font;
                font-size: 0.85rem;
                font-weight: 600;
            }
        }

        area := TouchArea {
            mouse-cursor: pointer;

            clicked => {
                SenderWindow.send-modal = true;
                SenderWindow.send-to = device;
            }

            pointer-event(event) => {
                if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                    menu.show(self.mouse-x, self.mouse-y);
                }
            }
        }
    }

    menu := ContextMenu {
        menu-width: 200px;
        ContextMenuItem {
            icon: device.favourite ? Icons.star : Icons.star-filled;
            text: device.favourite ? @tr("Remove from favourites") : @tr("Favourite");
            activated => {
                DevicesBridge.toggle-favourite(device.id);
                menu.close();
            }
        }

        ContextMenuSeparator { }

        ContextMenuItem {
            icon: Icons.trash;
            text: @tr("Forget device");
            activated => {
                menu.close();
                DevicesBridge.forget-device(device.id);
            }
        }
    }
}

component SidebarDevicesFolder inherits Rectangle {
    in property <DeviceFolder> folder;
    in-out property <bool> expanded;

    height: layout.preferred-height;

    layout := VerticalLayout {
        spacing: 4px;

        header := Rectangle {

            drop := DropArea {
                can-drop(event) => { DragAction.move }
                dropped(event) => {
                    expanded = true;
                    DevicesBridge.toggle-favourite(SidebarBridge.data-transfer-to-id(event.data));
                    return event.proposed-action;
                }
            }

            height: 28px;
            border-radius: 24px;
            border-corner-shape: superellipse(Theme.config.edges-shape);
            background: folder.id == "favourite" ? drop.has-drag ? Theme.colors.fourth-font : header-area.has-hover ? Theme.colors.fourth-col : Theme.colors.third-col : transparent;
            transform-scale: header-area.pressed ? 0.985 : 1.0;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 10px;
                spacing: 6px;
                cross-axis-alignment: center;

                if folder.icon.width != 0:SvgIcon {
                    source: folder.icon;
                    size: 13px;
                }

                Text {
                    vertical-alignment: center;
                    text: folder.title;
                    color: Theme.colors.primary-font;
                    font-size: 11px;
                    font-weight: 600;
                    overflow: elide;
                }

                Rectangle { }

                SvgIcon {
                    source: Icons.chevron-right;
                    transform-rotation: root.expanded ? -90deg : 90deg;
                    animate transform-rotation {
                        duration: Theme.animation-speed / 2;
                        easing: Theme.easing;
                    }
                    size: 10px;
                    colorize: Theme.colors.primary-font;
                }
            }

            header-area := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.expanded = !root.expanded; }
            }
        }

        body := Rectangle {
            clip: true;
            height: root.expanded ? content.preferred-height : 0px;

            animate height {
                duration: Theme.animation-speed;
                easing: Theme.easing;
            }

            content := VerticalLayout {
                y: 0px;
                width: parent.width;
                height: self.preferred-height;
                spacing: 2px;
                padding-left: 12px;

                for device in folder.devices: SidebarDevice {
                    device: device;
                }
            }
        }
    }
}

export component Sidebar inherits Rectangle {
    x: 0;
    background: Theme.colors.primary-col;
    width: WindowBridge.sidebar-width;
    border-radius: 8px;
    border-width: 1px;

    forward-focus: fs;

    fs := FocusScope {

        TouchArea {
            property <bool> maybe-dragging: false;

            moved => {
                if (self.maybe-dragging) {
                    WindowBridge.drag-window();
                }
            }
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    self.maybe-dragging = true;
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    self.maybe-dragging = false;
                }
            }
        }

        VerticalLayout {
            padding: 8px;

            HorizontalLayout {
                IconButton {
                    width: 28px;
                    height: 28px;

                    Image {
                        source: @image-url("../../shared/icons/tray.png");
                        width: 16px;
                        height: 16px;
                    }

                    clicked => {
                        WindowBridge.nectan-modal-open = true;
                    }
                }

                Rectangle { }

                // IconButton {
                //     width: 28px;
                //     height: 28px;
                //
                //     SvgIcon {
                //         source: Icons.bell;
                //         size: 16px;
                //         fg: parent.hovered ? Theme.colors.secondary-font : Theme.colors.fourth-font;
                //     }
                //
                //     clicked => {
                //         NotificationsBridge.notifications-visible = !NotificationsBridge.notifications-visible;
                //     }
                // }
            }

            Rectangle {
                height: 12px;
            }

            VerticalLayout {
                for folder in SenderWindow.folders: SidebarDevicesFolder {
                    expanded: HoverBridge.hovering && (folder.id != "offline") ? true : false;
                    folder: folder;
                }
            }

            Rectangle { }

            HorizontalLayout {
                alignment: end;
                padding-right: 8px;
                padding-bottom: 12px;
                spacing: 12px;

                Text {
                    text: @tr("Add first device");
                    font-size: 14px;
                    font-weight: 500;
                }

                SvgIcon {
                    source: @image-url("../../shared/icons/corner-left-up.svg");
                    transform-rotation: 180deg;
                    size: 20px;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                IconButton {
                    width: 28px;
                    height: 28px;
                    SvgIcon {
                        source: Icons.settings;
                        fg: parent.hovered ? Theme.colors.secondary-font : Theme.colors.fourth-font;
                        size: 16px;
                    }

                    clicked => {
                        SettingsBridge.open = true;
                    }
                }

                Rectangle { }

                // IconButton {
                //     width: 28px;
                //     height: 28px;
                //     SvgIcon {
                //         source: Icons.nearby;
                //         fg: parent.hovered ? Theme.colors.secondary-font : Theme.colors.fourth-font;
                //         size: 16px;
                //     }
                //
                //     clicked => {
                //     }
                // }



                IconButton {
                    width: 28px;
                    height: 28px;
                    SvgIcon {
                        source: Icons.plus;
                        fg: parent.hovered ? Theme.colors.secondary-font : Theme.colors.fourth-font;
                        size: 16px;
                    }

                    clicked => {
                        AddDeviceBridge.open = true;
                    }
                }
            }
        }
    }

    resize-handle := Rectangle {

        x: parent.width - self.width;
        y: 0;
        width: 6px;
        height: parent.height;

        Rectangle {
            x: parent.width - self.width;
            width: 2px;
            height: parent.height - 24px;
            y: 12px;
            border-radius: 1px;
            background: handle-area.pressed ? Theme.colors.third-font
                : handle-area.has-hover ? Theme.colors.fourth-font
                : transparent;

            animate background {
                delay: 100ms;
                duration: 100ms;
            }
        }

        handle-area := TouchArea {
            mouse-cursor: MouseCursor.ew-resize;

            moved => {
                if (self.pressed) {
                    WindowBridge.sidebar-width = max(180px, min(480px,
                        WindowBridge.sidebar-width + (self.mouse-x - self.pressed-x)));
                }
            }
        }
    }
}
