import { WindowBridge, TopBarShower } from "../../shared/window.slint";
import { Theme, ThemeAnimator } from "../../shared/theme.slint";
import { Topbar } from "../../shared/topbar.slint";
import {
    Transfer,
    Transfers,
    TransferItem,
    TransferStatus,
    TransfersBridge,
} from "../../shared/transfers.slint";
import { NectanModal } from "../../shared/nectan_modal.slint";
import { Sidebar } from "sidebar.slint";
import { SelectTypeModal, SenderWindow } from "sender.slint";
import { SettingsBridge, Settings } from "settings.slint";
import { Icons } from "../../shared/icons.slint";
import { PrimaryButton } from "../../shared/elements.slint";
import { Error, ErrorModal } from "../../shared/error_modal.slint";
import {
    DeviceStatus,
    DeviceItem,
    DevicesBridge,
} from "../../shared/devices.slint";
import { VerticalBox, HorizontalBox, Button } from "std-widgets.slint";
import {
    IncomingTransferOfferModal,
    OutcomingTransferModal,
    IncomingTransferOfferBridge,
    OutcomingTransferModalBridge,
    OfferEntry,
} from "../../shared/transfer_offer_modal.slint";
import {
    LookupState,
    AddDeviceModal,
    AddDeviceBridge,
    ConnectionOfferBridge,
} from "../../shared/add_remote_modal.slint";

export {
    Error,
    Transfer,
    DeviceItem,
    OfferEntry,
    LookupState,
    DeviceStatus,
    TransferItem,
    DevicesBridge,
    TransferStatus,
    AddDeviceBridge,
    TransfersBridge,
    ConnectionOfferBridge,
    IncomingTransferOfferBridge,
    OutcomingTransferModalBridge,
}
export enum CurrentWindow { main, transfers }

export component NectanSender inherits Window {
    title: "Nectan";
    preferred-width: 1128px;
    preferred-height: 720px;
    min-width: 400px;
    min-height: 200px;
    resize-border-width: 6px;
    no-frame: !WindowBridge.native-topbar;
    background: transparent;
    maximized: WindowBridge.maximized;
    default-font-family: Theme.font;
    default-font-size: Theme.font-size;
    z: 0;

    in-out property <CurrentWindow> current-window;
    callback new-window();

    ThemeAnimator { }

    main-fs := FocusScope {

        KeyBinding {
            keys: @keys(Control + N);
            activated => {
                root.new-window();
            }
        }

        Rectangle {
            z: 1;
            background: Theme.colors.primary-col;
            border-color: Theme.colors.fourth-col;
            border-width: root.maximized ? 0 : 1px;
            border-radius: WindowBridge.round-edges ? root.maximized ? 0 : 24px : 0;
            border-corner-shape: superellipse(WindowBridge.edges-shape);
            clip: true;

            WindowMoveArea { }

            TopBarShower { }

            Topbar { }

            Sidebar { }

            HorizontalLayout {
                padding-left: WindowBridge.sidebar-width;
                padding: 8px;

                Transfers {
                    min-width: 300px;
                    horizontal-stretch: 1;
                }
            }
        }
    }

    Rectangle {
        z: 1;

        if SettingsBridge.open: Settings { }

        if SenderWindow.send-type-modal: SelectTypeModal { }

        if WindowBridge.nectan-modal-open: NectanModal { }

        if OutcomingTransferModalBridge.open: OutcomingTransferModal { }

        if IncomingTransferOfferBridge.open: IncomingTransferOfferModal { }

        if AddDeviceBridge.open:  AddDeviceModal { }

        if SenderWindow.error-modal: ErrorModal { }
    }
}
